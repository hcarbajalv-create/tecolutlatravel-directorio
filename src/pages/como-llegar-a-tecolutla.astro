---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from '../components/NegocioCard.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';
import { filtrarListables } from '../utils/negociosPublicados';

// Página directa: conserva la URL independiente de Reportajes. Falta una foto
// real de carretera o de la entrada a Tecolutla; nunca se sustituye por stock.
const frontmatter = {
  title: 'Cómo llegar a Tecolutla en carro y autobús',
  titulo_h1: 'Cómo llegar a Tecolutla: rutas, tiempos y costos desde el centro del país',
  description: '¿Vas a Tecolutla? Cómo llegar en carro y en autobús desde el Estado de México, CDMX, Pachuca y Puebla: rutas, tiempos, costos y dónde estacionarte.',
  slug: 'como-llegar-a-tecolutla', categoria: 'tip', fecha: '2026-09-02',
} as const;

// Única palanca para apagar la barra móvil después de la revisión visual.
const BARRA_FIJA_MOVIL_ACTIVA = true;
// Sustituir null únicamente cuando tengamos una foto real y aprobada.
// Mientras tanto no se reserva ni se muestra espacio alguno en el encabezado.
const imagenDestacada: { src: string; alt: string } | null = null;
const esquemaBreadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://tecolutlatravel.mx/' },
    { '@type': 'ListItem', position: 2, name: frontmatter.title, item: 'https://tecolutlatravel.mx/como-llegar-a-tecolutla' },
  ],
};

const todos = filtrarListables(await getCollection('negocios'));
const hospedajes = todos.filter((negocio) => negocio.data.categoria === 'hospedaje');
const destacados = hospedajes.filter((negocio) => negocio.data.destacado).sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));
const resto = hospedajes.filter((negocio) => !negocio.data.destacado).sort(compararDentroDeGrupo);
const hospedajesOrdenados = [...destacados, ...resto];
const tarjetasAlberca = hospedajesOrdenados.filter((negocio) => negocio.data.alberca === true).slice(0, 3);

const ESTADOS_MEXICO = ['Aguascalientes', 'Baja California', 'Baja California Sur', 'Campeche', 'Chiapas', 'Chihuahua', 'Ciudad de México', 'Coahuila', 'Colima', 'Durango', 'Estado de México', 'Guanajuato', 'Guerrero', 'Hidalgo', 'Jalisco', 'Michoacán', 'Morelos', 'Nayarit', 'Nuevo León', 'Oaxaca', 'Puebla', 'Querétaro', 'Quintana Roo', 'San Luis Potosí', 'Sinaloa', 'Sonora', 'Tabasco', 'Tamaulipas', 'Tlaxcala', 'Veracruz', 'Yucatán', 'Zacatecas'] as const;
const RUTAS_POR_ESTADO: Record<string, string> = { 'Estado de México': 'desde-edomex', 'Ciudad de México': 'desde-cdmx', Hidalgo: 'desde-hidalgo', Puebla: 'desde-puebla', Veracruz: 'desde-veracruz' };
---

<BaseLayout titulo={frontmatter.title} descripcion={frontmatter.description}>
  <script type="application/ld+json" set:html={JSON.stringify(esquemaBreadcrumb)} />
  <article class="ruta">
    <header class="ruta__hero"><div class="contenedor ruta__hero-interior">
      <p class="migaja"><a href="/">Inicio</a> → Cómo llegar a Tecolutla</p>
      <div class:list={['ruta__encabezado', { 'ruta__encabezado--con-imagen': imagenDestacada }]}><div><p class="eyebrow">Guía para tu viaje</p><h1>{frontmatter.titulo_h1}</h1></div>
        {imagenDestacada && <img class="ruta__imagen-destacada" src={imagenDestacada.src} alt={imagenDestacada.alt} />}
      </div>
      <div class="ruta__datos-rapidos" aria-label="Datos rápidos para llegar a Tecolutla"><p data-dato="distancia"><strong>320 km</strong><span>desde CDMX</span></p><p data-dato="carro"><strong>4–5 h</strong><span>en carro</span></p><p data-dato="autobus"><strong>5–6 h</strong><span>en autobús</span></p><p data-dato="casetas"><strong>~$500</strong><span>casetas</span></p></div>
      <figure class="ruta__diagrama" aria-label="Ruta de referencia desde Ciudad de México: Tulancingo, Poza Rica, Gutiérrez Zamora y Tecolutla.">
        <svg viewBox="0 0 760 118" role="img" aria-labelledby="titulo-ruta diagrama-ruta" preserveAspectRatio="xMidYMid meet">
          <title id="titulo-ruta">Ruta de referencia hacia Tecolutla</title>
          <desc id="diagrama-ruta">Un recorrido visual desde Ciudad de México hasta Tecolutla, con paradas en Tulancingo, Poza Rica y Gutiérrez Zamora.</desc>
          <path class="ruta__linea-base" d="M72 57H688" pathLength="100" />
          <path class="ruta__linea-activa" d="M72 57H688" pathLength="100" />
          <g class="ruta__parada ruta__parada--origen"><circle cx="72" cy="57" r="13"/><path d="M67 57h10M72 52v10"/></g>
          <g class="ruta__parada"><circle cx="263" cy="57" r="9"/></g>
          <g class="ruta__parada"><circle cx="451" cy="57" r="9"/></g>
          <g class="ruta__parada"><circle cx="570" cy="57" r="9"/></g>
          <g class="ruta__parada ruta__parada--destino"><circle cx="688" cy="57" r="14"/><path d="M681 57l5 5 10-12"/></g>
          <g class="ruta__etiquetas"><text x="72" y="25" text-anchor="middle">CDMX</text><text x="263" y="92" text-anchor="middle">Tulancingo</text><text x="451" y="25" text-anchor="middle">Poza Rica</text><text x="570" y="92" text-anchor="middle">Gutiérrez Zamora</text><text x="688" y="25" text-anchor="middle">Tecolutla</text></g>
        </svg>
      </figure>
    </div></header>

    <section class="ruta__origen contenedor" aria-labelledby="titulo-origen"><div class="ruta__titulo-bloque"><p class="eyebrow">Planea tu ruta</p><h2 id="titulo-origen">¿Desde dónde vienes?</h2></div>
      <nav class="ruta__chips" aria-label="Rutas por ciudad"><a href="#desde-edomex">Estado de México</a><a href="#desde-cdmx">CDMX</a><a href="#desde-hidalgo">Pachuca y Tulancingo</a><a href="#desde-puebla">Puebla</a><a href="#desde-poza-rica">Poza Rica</a><a href="#desde-veracruz">Xalapa y Veracruz</a></nav>
      <form class="ruta__selector" data-selector-origen action="/.netlify/functions/origen-estado" method="get"><label for="estado-origen">¿Tu estado no está? Dinos de dónde vienes</label><div class="ruta__selector-controles"><select id="estado-origen" name="estado" required><option value="" selected disabled>Elige tu estado</option>{ESTADOS_MEXICO.map((estado) => <option value={estado}>{estado}</option>)}</select><button class="boton boton--secundario" type="submit">Ver ruta</button></div></form>
      <div class="ruta__sin-ruta" data-sin-ruta hidden tabindex="-1"><p>Todavía no tenemos esa ruta escrita. La referencia más cercana es llegar a Poza Rica; de ahí son 45 minutos a Tecolutla.</p><a class="boton boton--principal" href="/hospedaje">Ver dónde quedarte en Tecolutla</a></div>
    </section>

    <section class="ruta__comparativa contenedor" aria-labelledby="titulo-comparativa"><div class="ruta__titulo-bloque"><p class="eyebrow">Antes de salir</p><h2 id="titulo-comparativa">Compara tu camino</h2></div><div class="ruta__tabla-scroll" tabindex="0"><table><thead><tr><th>Desde</th><th>En carro</th><th>En autobús</th></tr></thead><tbody><tr><th>Estado de México</th><td>4–5 h</td><td>—</td></tr><tr><th>CDMX</th><td>4–5 h</td><td>5–6 h</td></tr><tr><th>Pachuca / Tulancingo</th><td>3.5–4 h</td><td>—</td></tr><tr><th>Puebla</th><td>5–6 h</td><td>~8 h</td></tr><tr><th>Poza Rica</th><td>40–50 min</td><td>—</td></tr><tr><th>Xalapa / Veracruz</th><td>3.5–4 h / 4–5 h</td><td>—</td></tr></tbody></table></div></section>

    <div class="contenedor ruta__lectura">
      <p>Tecolutla es de las playas más queridas del Golfo: mar, río y manglar en el mismo lugar, y perfecta para venir en familia. Lo mejor es que llegar es más fácil de lo que crees, sobre todo si vienes del centro del país. Aquí te decimos, sin rodeos, <strong>cómo llegar a Tecolutla en carro y en autobús</strong> desde las principales ciudades: cuánto tarda, cuánto cuesta, de qué terminal sale el camión y dónde dejar el coche cuando llegues.</p>
      <h2 id="desde-edomex">¿Cuánto tarda del Estado de México a Tecolutla?</h2>
      <p>La mayoría de quienes visitan Tecolutla vienen del <strong>Estado de México</strong>, así que empecemos por ahí. Desde municipios del norte y oriente (Ecatepec, Tecámac, Naucalpan, Cuautitlán, Tlalnepantla), en <strong>carro</strong> son alrededor de <strong>4 a 5 horas</strong>, porque te queda muy a la mano la autopista rumbo a Tuxpan. Desde Toluca calcula un poco más, unas <strong>5 a 6 horas</strong>. Es un viaje muy cómodo para hacer en un día y llegar con luz.</p>
      <h2 id="desde-cdmx">¿Cuánto tarda de CDMX a Tecolutla?</h2>
      <p>En <strong>carro</strong> son alrededor de <strong>320 km</strong> y el viaje toma más o menos <strong>4 a 5 horas</strong>, según el tráfico y de qué punto de la ciudad salgas. En <strong>autobús</strong> el trayecto ronda las <strong>5 a 6 horas</strong>.</p>
      <h2 id="ruta-centro">¿Por dónde se va en carro desde el centro del país?</h2>
      <p>La ruta más directa es tomar la <strong>autopista México–Tuxpan (132D)</strong>, luego incorporarte a la <strong>carretera 130</strong> y finalmente a la <strong>180</strong> rumbo a Tecolutla. Es carretera de cuota en buena parte, así que ten a la mano efectivo o tarjeta para las <strong>casetas</strong> (calcula alrededor de $500 por trayecto; los montos cambian seguido, verifícalos antes de salir).</p>
      <p><strong>Tip:</strong> sal temprano para llegar con luz y aprovechar el primer día. Una buena parada para estirar las piernas y cargar gasolina es la zona de Poza Rica, que ya está cerquita.</p>
      <section class="ruta__estacionamiento" aria-labelledby="donde-estaciono"><h2 id="donde-estaciono">¿Dónde me estaciono en Tecolutla?</h2>
        <p>Si vienes en carro con la familia, esto importa más de lo que parece: en temporada alta el centro y las calles cerca de la playa se llenan, y andar buscando lugar con los niños en el coche no es plan. La solución más cómoda es quedarte en un lugar que ya tenga <strong>estacionamiento propio</strong>, para dejar el coche y no volver a moverlo en todo el fin de semana.</p>
        <p>En cada ficha de nuestro directorio verás si el hospedaje tiene estacionamiento, cuántas personas caben y <strong>a cuántos metros exactos está de la playa</strong> — nosotros los medimos, no los calculamos a ojo.</p>
        <p>👉 Mira las <a href="/hospedaje">casas y hoteles en Tecolutla</a> y filtra por lo que necesites.</p>
        <a class="boton boton--secundario ruta__ver-todas" href="/hospedaje">Ver todo el hospedaje en Tecolutla</a>
      </section>
      <h2 id="autobus-cdmx">¿De qué terminal sale el autobús y cuánto cuesta?</h2>
      <p>Desde la Ciudad de México, <strong>ADO</strong> te lleva a Tecolutla en unas <strong>5 a 6 horas</strong>. Hay salidas desde la <strong>TAPO (Terminal de Autobuses de Pasajeros de Oriente)</strong> y desde la <strong>Terminal Central del Norte</strong>, así que conviene revisar cuál te queda mejor según de dónde salgas.</p>
      <p>Los precios varían bastante según la fecha, la hora y qué tan cerca de la salida compres: en temporada alta y fines de semana largos suben, y comprar con anticipación casi siempre sale mejor. Consulta la tarifa vigente en el sitio de ADO antes de viajar.</p>
      <p>Si vienes en autobús desde otras ciudades, es común hacer conexión o llegar primero a <strong>Gutiérrez Zamora</strong>, que está a pocos minutos de Tecolutla, y de ahí tomar un transporte corto al pueblo.</p>
      <h2 id="desde-hidalgo">¿Cómo llegar desde Pachuca o Tulancingo?</h2>
      <p>Si vienes de <strong>Hidalgo</strong>, tienes ventaja: estás <strong>más cerca</strong>. Desde <strong>Pachuca</strong> son aproximadamente <strong>3.5 a 4 horas</strong> en carro, y desde <strong>Tulancingo</strong> un poco menos, porque ya vas encaminado hacia la sierra rumbo a la costa. Es una escapada de fin de semana muy accesible.</p>
      <h2 id="desde-poza-rica">¿Cómo llegar desde Poza Rica?</h2>
      <p>Poza Rica es el <strong>punto más cercano</strong> a Tecolutla: estás a solo <strong>40 a 50 minutos</strong> en carro. Si vives en la región (Poza Rica, Papantla, Coatzintla, Cazones), Tecolutla es la escapada de playa perfecta de fin de semana, con salidas frecuentes de autobús y combi.</p>
      <h2 id="desde-puebla">¿Cómo llegar desde Puebla?</h2>
      <p>En <strong>autobús</strong> desde Puebla el trayecto es de alrededor de <strong>8 horas</strong>, normalmente con conexión. En <strong>carro</strong> conviene ir rumbo a Poza Rica y de ahí a Tecolutla: calcula unas <strong>5 a 6 horas</strong> según la ruta que tomes.</p>
      <h2 id="desde-veracruz">¿Y desde Xalapa o el puerto de Veracruz?</h2>
      <p>Desde <strong>Xalapa</strong> son aproximadamente <strong>3.5 a 4 horas</strong> en carro; desde el <strong>puerto de Veracruz</strong>, unas <strong>4 a 5 horas</strong> por la costa. Es un destino muy cómodo para quienes ya andan por el estado.</p>
      <section class="ruta__cierre" aria-labelledby="ya-llegue"><h2 id="ya-llegue">Ya llegué a Tecolutla, ¿ahora qué?</h2>
        <p>Aquí es donde empieza lo bueno. En <strong>TecolutlaTravel</strong> te conectamos directo con cada negocio por WhatsApp, sin intermediarios y sin comisiones:</p>
        <ul><li>🏠 <strong>¿Dónde te quedas?</strong> Mira las <a href="/hospedaje">casas y hoteles en Tecolutla</a>, o ve directo a las <a href="/hospedaje/con-alberca">casas con alberca</a> — las favoritas para venir en familia.</li><li>🍤 <strong>¿Dónde comes?</strong> Los mejores <a href="/gastronomia">mariscos a orilla del río</a>.</li><li>🚤 <strong>¿Qué haces?</strong> <a href="/actividades">Paseos en lancha</a> por los manglares y el Santuario de las Aves.</li></ul>
        <div class="ruta__tarjetas">{tarjetasAlberca.map((negocio, indice) => <NegocioCard negocio={negocio} esPrimera={indice === 0} />)}</div>
        <a class="boton ruta__cta-principal" href="/hospedaje">Ver dónde quedarte en Tecolutla</a><p class="ruta__enlaces-secundarios"><a href="/gastronomia">Explora gastronomía</a><a href="/actividades">Explora actividades</a></p>
        <p>Y si tienes dudas, <strong>pregúntale a Teco</strong> 🐢, nuestro asistente: te ayuda a encontrar justo lo que buscas y te pasa el contacto directo del anfitrión.</p>
      </section>
    </div>
  </article>
  {BARRA_FIJA_MOVIL_ACTIVA && <a class="ruta__barra-movil" data-barra-movil href="/hospedaje" aria-hidden="true">¿Te quedas en Tecolutla? <strong>→ Ver hospedaje</strong></a>}
</BaseLayout>

<script define:vars={{ rutasPorEstado: RUTAS_POR_ESTADO, barraMovilActiva: BARRA_FIJA_MOVIL_ACTIVA }}>
  const selectorOrigen = document.querySelector('[data-selector-origen]');
  const avisoSinRuta = document.querySelector('[data-sin-ruta]');
  selectorOrigen?.addEventListener('submit', (evento) => {
    const formulario = evento.currentTarget;
    if (!(formulario instanceof HTMLFormElement)) return;
    const estado = new FormData(formulario).get('estado');
    if (typeof estado !== 'string' || !estado) return;
    evento.preventDefault();
    fetch('/.netlify/functions/origen-estado', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ estado }), keepalive: true }).catch(() => {});
    const ancla = rutasPorEstado[estado];
    if (ancla) { if (avisoSinRuta instanceof HTMLElement) avisoSinRuta.hidden = true; const destino = document.getElementById(ancla); if (destino) { history.replaceState(null, '', `#${ancla}`); destino.scrollIntoView({ behavior: 'smooth', block: 'start' }); } return; }
    if (avisoSinRuta instanceof HTMLElement) { avisoSinRuta.hidden = false; avisoSinRuta.focus(); }
  });
  if (barraMovilActiva) { const barra = document.querySelector('[data-barra-movil]'); const actualizarBarra = () => { if (!(barra instanceof HTMLElement)) return; const recorrido = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1); const mostrar = window.scrollY / recorrido >= .5; barra.classList.toggle('ruta__barra-movil--visible', mostrar); barra.setAttribute('aria-hidden', String(!mostrar)); }; actualizarBarra(); window.addEventListener('scroll', actualizarBarra, { passive: true }); }
</script>

<style>
  .ruta { padding-bottom: 5rem; }.ruta__hero { background:linear-gradient(145deg,var(--color-arena),#fffaf0 58%,#dff5f2);border-bottom:1px solid var(--color-borde);}.ruta__hero-interior{padding:1.5rem 0 2rem}.migaja{margin:0 0 1.15rem;color:var(--color-texto-suave);font-size:.92rem}.ruta__encabezado{display:grid;gap:1.25rem;align-items:stretch}.eyebrow{margin:0 0 .4rem;color:var(--color-turquesa);font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}h1,h2{color:var(--color-tinta);font-family:var(--fuente-titulos)}h1{max-width:760px;margin:0;font-size:clamp(2rem,6vw,3.75rem);line-height:1.06}.ruta__imagen-pendiente{min-height:178px;display:grid;place-items:end start;padding:1rem;border:1px dashed #aebfbb;border-radius:var(--radio);background:linear-gradient(135deg,rgba(11,111,122,.16),rgba(255,255,255,.75)),repeating-linear-gradient(-45deg,transparent 0 18px,rgba(11,111,122,.05) 18px 36px);color:var(--color-texto-suave);font-size:.85rem}.ruta__imagen-pendiente span{background:rgba(255,255,255,.8);padding:.35rem .55rem;border-radius:999px}.ruta__datos-rapidos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:1.25rem;overflow:hidden;border:1px solid var(--color-borde);border-radius:var(--radio);background:var(--color-blanco)}.ruta__datos-rapidos p{display:grid;gap:.12rem;min-height:78px;margin:0;padding:.85rem;border:1px solid #f2ecdf}.ruta__datos-rapidos strong{color:var(--color-turquesa);font-family:var(--fuente-titulos);font-size:1.22rem}.ruta__datos-rapidos span{color:var(--color-texto-suave);font-size:.82rem}.ruta__origen,.ruta__comparativa{padding-top:2.7rem}.ruta__titulo-bloque h2{margin:0;font-size:clamp(1.65rem,4vw,2.35rem)}.ruta__chips{display:flex;gap:.65rem;margin-top:1.15rem;overflow-x:auto;padding:.2rem 0 .6rem}.ruta__chips a{flex:0 0 auto;padding:.6rem .85rem;border:1px solid var(--color-borde);border-radius:999px;background:var(--color-blanco);color:var(--color-turquesa);font-size:.9rem;font-weight:700;text-decoration:none}.ruta__chips a:hover{background:var(--color-arena)}.ruta__selector{max-width:680px;margin-top:1.2rem;padding:1rem;border-radius:var(--radio);background:var(--color-arena)}.ruta__selector label{display:block;margin-bottom:.55rem;color:var(--color-tinta);font-weight:800}.ruta__selector-controles{display:grid;gap:.6rem}.ruta__selector select{width:100%;min-height:48px;padding:0 .75rem;border:1px solid var(--color-borde);border-radius:10px;background:var(--color-blanco);color:var(--color-tinta);font:inherit}.ruta__selector .boton,.ruta__ver-todas{min-height:48px;justify-content:center}.ruta__sin-ruta{max-width:680px;margin-top:.8rem;padding:1rem;border:1px solid var(--color-borde);border-radius:var(--radio);background:#fffaf0}.ruta__sin-ruta p{margin:0 0 .8rem}.ruta__comparativa{padding-bottom:2.5rem}.ruta__tabla-scroll{margin-top:1rem;overflow-x:auto;border:1px solid var(--color-borde);border-radius:var(--radio)}table{width:100%;min-width:580px;border-collapse:collapse;background:var(--color-blanco)}th,td{padding:.85rem 1rem;border-bottom:1px solid #eee7d9;text-align:left}thead{background:var(--color-turquesa);color:var(--color-blanco)}tbody th{color:var(--color-tinta);font-weight:800}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.ruta__lectura{max-width:860px;color:var(--color-tinta);font-size:1.05rem;line-height:1.72}.ruta__lectura>p,.ruta__lectura>ul,.ruta__lectura section>p,.ruta__lectura section>ul{margin:0 0 1.15rem}.ruta__lectura h2{margin:2.7rem 0 .75rem;scroll-margin-top:7rem;font-size:clamp(1.45rem,3vw,2rem);line-height:1.2}.ruta__lectura ul{padding-left:1.3rem}.ruta__lectura li+li{margin-top:.65rem}.ruta__estacionamiento,.ruta__cierre{margin:2.9rem -1rem 0;padding:1.3rem 1rem 1.6rem;border-radius:var(--radio);background:#f7fcfb}.ruta__estacionamiento h2,.ruta__cierre h2{margin-top:0}.ruta__tarjetas{display:grid;gap:1rem;margin:1.35rem 0}.ruta__cta-principal{display:flex;min-height:52px;margin-top:1.25rem;justify-content:center;align-items:center;border-radius:999px;background:var(--color-coral);color:var(--color-tinta);font-family:var(--fuente-titulos);font-weight:900;text-decoration:none}.ruta__cta-principal:hover{background:var(--color-coral-claro)}.ruta__enlaces-secundarios{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1rem!important;font-weight:800}.ruta__barra-movil{position:fixed;right:.75rem;bottom:.75rem;left:.75rem;z-index:30;display:flex;justify-content:space-between;gap:.6rem;padding:.9rem 1rem;border-radius:999px;background:var(--color-turquesa);box-shadow:0 8px 24px rgba(12,43,46,.25);color:var(--color-blanco);font-size:.93rem;text-decoration:none;transform:translateY(150%);transition:transform .24s ease}.ruta__barra-movil--visible{transform:translateY(0)}@media (min-width:640px){.ruta__encabezado{grid-template-columns:1.25fr .75fr}.ruta__datos-rapidos{grid-template-columns:repeat(4,minmax(0,1fr))}.ruta__selector-controles{grid-template-columns:1fr auto}.ruta__selector .boton{padding-inline:1.2rem}}@media (min-width:780px){.ruta__tarjetas{grid-template-columns:repeat(3,minmax(0,1fr))}.ruta__estacionamiento,.ruta__cierre{margin-right:-2.5rem;margin-left:-2.5rem;padding:2rem 2.5rem 2.5rem}}@media (min-width:768px){.ruta__barra-movil{display:none}}
