---
import BaseLayout from '../layouts/BaseLayout.astro';
import TarjetaReportaje from '../components/TarjetaReportaje.astro';
import Icono from '../components/Icono.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import placeholderPaloma from '../assets/fotos/placeholder.svg';

const reportajes = (await getCollection('reportajes')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const totalVideos = reportajes.length;
const negociosCubiertos = new Set(
  reportajes.map((r) => r.data.negocioRelacionado?.id).filter((id): id is string => Boolean(id)),
).size;

const filtros = [
  { categoria: 'reportaje', texto: 'Reportajes de negocios', icono: 'ubicacion' },
  { categoria: 'noticia', texto: 'Noticias locales', icono: 'etiqueta' },
  { categoria: 'tip', texto: 'Tips de viajero', icono: 'idea' },
] as const;
---

<BaseLayout
  titulo="Reportajes y noticias"
  descripcion="Recorridos, novedades y tips de Tecolutla, contados por Paloma — cada semana, en video."
>
  <section class="reportajes-hero">
    <div class="contenedor reportajes-hero__contenido">
      <span>VOCES LOCALES DE TECOLUTLA</span>
      <h1>Historias que cuentan Tecolutla</h1>
      <p>Reportajes, noticias y recomendaciones de quienes viven y conocen nuestro destino.</p>
      <a class="reportajes-hero__cta" href="#colabora">Quiero ser colaborador <b>→</b></a>
    </div>
  </section>
  <nav class="navegacion-categorias" aria-label="Explora otras categorías">
    <div class="contenedor navegacion-categorias__scroll">
      <a href="/hospedaje" class="navegacion-categorias__enlace">⌂ Hospedaje</a>
      <a href="/gastronomia" class="navegacion-categorias__enlace">🍴 Gastronomía</a>
      <a href="/actividades" class="navegacion-categorias__enlace">🏃 Actividades</a>
      <a href="/reportajes-y-noticias" class="navegacion-categorias__enlace navegacion-categorias__enlace--activo">▤ Reportajes y noticias</a>
      <a href="/tips-para-tu-viaje" class="navegacion-categorias__enlace">💡 Tips para tu viaje</a>
    </div>
  </nav>
  <section class="seccion-reportajes seccion--arena">
    <div class="contenedor">
      <div class="reportajes-encabezado"><div><h2 class="titulo-pagina">Reportajes y noticias</h2>
      <p class="subtitulo">
        Historias reales, novedades y tips para conocer mejor Tecolutla.
      </p></div><a class="reportajes-enlace-colabora" href="#colabora">Publica tu historia →</a></div>

      <div class="perfil-anfitriona">
        <Image
          src={placeholderPaloma}
          alt="Icono de perfil mientras se sube la foto real de Paloma"
          width={64}
          height={64}
          class="perfil-anfitriona__foto"
        />
        <div class="perfil-anfitriona__info">
          <p class="perfil-anfitriona__nombre">
            Paloma <span class="insignia insignia--anfitriona">Colaboradora</span>
          </p>
          <p class="perfil-anfitriona__descripcion">
            Tu guía en cámara: visita hospedajes y restaurantes del directorio, cubre eventos del
            pueblo y comparte tips para tu viaje.
          </p>
        </div>
        <div class="perfil-anfitriona__stats">
          <div>
            <b>{totalVideos}</b>
            <span>videos</span>
          </div>
          <div>
            <b>{negociosCubiertos}</b>
            <span>negocios</span>
          </div>
        </div>
      </div>

      <div class="reportajes-recientes-encabezado"><h2>Reportajes recientes</h2><div class="filtros-categoria" role="group" aria-label="Filtrar por categoría">
        {
          filtros.map((f) => (
            <button
              type="button"
              class={`filtro-pill filtro-pill--${f.categoria}`}
              data-filtro={f.categoria}
              aria-pressed="false"
            >
              <Icono nombre={f.icono} /> {f.texto}
            </button>
          ))
        }
      </div></div>

      {
        reportajes.length === 0 ? (
          <p>Todavía no hay videos publicados.</p>
        ) : (
          <div class="rejilla-reportajes">
            {reportajes.map((r) => (
              <TarjetaReportaje reportaje={r} />
            ))}
          </div>
        )
      }

      <section class="reportajes-colabora" id="colabora">
        <div><span>PARA COMUNICADORES LOCALES</span><h2>¿Quieres publicar en TecolutlaTravel?</h2><p>Comparte tu historia, tu mirada y lo que hace único a nuestro destino.</p></div>
        <a href="/contactanos">Enviar propuesta <b>→</b></a>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  const contenedorFiltros = document.querySelector<HTMLElement>('.filtros-categoria');
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtro-pill');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-categoria]');

  function aplicarFiltros() {
    const activos = Array.from(botones)
      .filter((b) => b.getAttribute('aria-pressed') === 'true')
      .map((b) => b.dataset.filtro);

    contenedorFiltros?.setAttribute('data-algun-activo', activos.length > 0 ? 'true' : 'false');

    tarjetas.forEach((tarjeta) => {
      const visible = activos.length === 0 || activos.includes(tarjeta.dataset.categoria ?? '');
      tarjeta.style.display = visible ? '' : 'none';
    });
  }

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      const activo = boton.getAttribute('aria-pressed') === 'true';
      boton.setAttribute('aria-pressed', activo ? 'false' : 'true');
      aplicarFiltros();
    });
  });
</script>
