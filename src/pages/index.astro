---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from '../components/NegocioCard.astro';
import HeroSubmarino from '../components/HeroSubmarino.astro';
import Icono from '../components/Icono.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';
import { filtrarListables } from '../utils/negociosPublicados';

const negocios = filtrarListables(await getCollection('negocios'));
// Orden manual primero (si se define). La portada muestra cuatro
// recomendaciones para que se lean de un vistazo; el catálogo completo
// siempre conserva todas las opciones de hospedaje.
const destacados = negocios
  .filter((n) => n.data.destacado)
  .sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));
const destacadosEnPortada = destacados.slice(0, 4);

// El número y las ligas del catálogo se calculan desde los datos reales.
// Así la home nunca promete más hospedajes de los que existen, y el mensaje
// sigue creciendo solo conforme se den de alta nuevos negocios.
const hospedajes = negocios.filter((n) => n.data.categoria === 'hospedaje');
const totalHospedajes = hospedajes.length;
// "También en Tecolutla": una ficha por cada categoría que NO sea
// hospedaje, elegida por puntaje de completitud (la misma lógica que
// ordena /gastronomia, /actividades y /servicios). Si una categoría
// todavía no tiene negocios publicados, simplemente no aparece.
const OTRAS_CATEGORIAS = ['gastronomia', 'actividades', 'servicios'] as const;
const tambienEnTecolutla = OTRAS_CATEGORIAS.map(
  (cat) => negocios.filter((n) => n.data.categoria === cat).sort(compararDentroDeGrupo)[0],
).filter((n): n is NonNullable<typeof n> => Boolean(n));

const primerNegocio = (categoria: 'hospedaje' | 'gastronomia' | 'actividades') =>
  negocios.find((negocio) => negocio.data.categoria === categoria)?.data.fotos[0];

const categorias = [
  {
    href: '/hospedaje',
    clase: 'tile--hospedaje',
    icono: 'cama',
    titulo: 'Hospedaje',
    descripcion: 'Hoteles, casas y posadas',
    imagenPublica: '/images/tile-hospedaje-alberca-playa.png',
  },
  {
    href: '/gastronomia',
    clase: 'tile--gastronomia',
    icono: 'cubiertos',
    titulo: 'Gastronomía',
    descripcion: 'Restaurantes y antojitos',
    // Imagen editorial compartida con el banner de Gastronomía.
    imagenPublica: '/images/banner-gastronomia-restaurante-rio.png',
  },
  {
    href: '/actividades',
    clase: 'tile--actividades',
    icono: 'actividad',
    titulo: 'Actividades',
    descripcion: 'Tours y experiencias',
    imagenPublica: '/images/tile-actividades-lancha-manglar.png',
  },
  {
    href: '/tips-para-tu-viaje',
    clase: 'tile--tips',
    icono: 'idea',
    titulo: 'Tips para tu viaje',
    descripcion: 'Guías y recomendaciones',
    imagenPublica: '/images/tile-tips-mapa-playa.png',
  },
];

const negocioMapaHome = hospedajes[0];
const mapaHome = negocioMapaHome
  ? `https://www.google.com/maps?q=${negocioMapaHome.data.coordenadas.lat},${negocioMapaHome.data.coordenadas.lng}&z=14&output=embed`
  : 'https://www.google.com/maps?q=Tecolutla,Veracruz&z=13&output=embed';

// Sin SearchAction: el buscador del Header es 100% en el navegador
// (filtra un índice ya cargado, sección "buscador" de Header.astro) —
// no existe ninguna URL tipo /buscar?q=... que Google pueda usar de
// verdad para ejecutar una búsqueda. Declarar un SearchAction de todos
// modos describiría una función que el sitio no tiene.
const esquemaWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TecolutlaTravel',
  url: 'https://tecolutlatravel.mx/',
};

const esquemaOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TecolutlaTravel',
  url: 'https://tecolutlatravel.mx/',
  logo: 'https://tecolutlatravel.mx/images/logo-tecolutlatravel-oficial.png',
};
---

<BaseLayout
  titulo="Hoteles y casas de hospedaje en Tecolutla, Veracruz | Qué hacer y dónde comer"
  tituloCompleto
  descripcion="Guía local de Tecolutla: casas de hospedaje con alberca, hoteles, restaurantes de mariscos y paseos por los manglares. Contacto directo con cada negocio por WhatsApp."
>
  <script type="application/ld+json" set:html={JSON.stringify(esquemaWebSite)} />
  <script type="application/ld+json" set:html={JSON.stringify(esquemaOrganization)} />

  <HeroSubmarino totalHospedajes={totalHospedajes} />

  <section class="seccion seccion--arena" aria-labelledby="titulo-como-llegar-home">
    <div class="contenedor">
      <p class="eyebrow">Planea tu visita</p>
      <h2 id="titulo-como-llegar-home" class="titulo-seccion">¿Cómo llegar a Tecolutla?</h2>
      <p class="subtitulo">Rutas, tiempos y opciones para venir en carro o autobús desde el centro del país.</p>
      <p style="margin-top:1rem;"><a class="boton boton--secundario" href="/como-llegar-a-tecolutla">Cómo llegar a Tecolutla</a></p>
    </div>
  </section>

  {
    totalHospedajes > 0 && (
      <section class="filtros-propuesta filtros-propuesta--solo-ayuda" id="elige-hospedaje" aria-labelledby="titulo-busqueda-rapida">
        <h2 id="titulo-busqueda-rapida" class="sr-only">Ayuda de iconos de hospedaje</h2>
        <dialog class="filtros-ayuda" data-ayuda-iconos aria-labelledby="titulo-ayuda-iconos">
          <div class="filtros-ayuda__cabecera">
            <h2 id="titulo-ayuda-iconos">Cómo leer las fichas</h2>
            <button type="button" class="filtros-ayuda__cerrar" data-cerrar-ayuda aria-label="Cerrar ayuda">×</button>
          </div>
          <div class="filtros-ayuda__lista">
            <span><Icono nombre="alberca" /><b>Alberca</b><small>Cuenta con piscina.</small></span>
            <span><Icono nombre="olas" /><b>Frente al mar</b><small>Está frente a la playa o cerca de ella.</small></span>
            <span><Icono nombre="usuarios" /><b>Máx. X personas</b><small>Capacidad máxima del alojamiento.</small></span>
            <span><Icono nombre="wifi" /><b>Wifi</b><small>Conexión inalámbrica disponible.</small></span>
            <span><Icono nombre="aire" /><b>Aire acondicionado</b><small>Cuenta con aire acondicionado.</small></span>
            <span><Icono nombre="estacionamiento" /><b>Estacionamiento</b><small>Ofrece espacio para estacionar.</small></span>
            <span><Icono nombre="asador" /><b>Asador</b><small>Cuenta con asador o área para asar.</small></span>
            <span><Icono nombre="tv" /><b>TV</b><small>Cuenta con televisión en el alojamiento.</small></span>
            <span><Icono nombre="ventilador" /><b>Ventilador</b><small>Cuenta con ventilador.</small></span>
            <span><Icono nombre="agua-caliente" /><b>Agua caliente</b><small>Cuenta con agua caliente.</small></span>
            <span><Icono nombre="cocina" /><b>Cocina</b><small>Cuenta con cocina para preparar alimentos.</small></span>
            <span><Icono nombre="mascota" /><b>Pet friendly</b><small>Acepta mascotas según sus condiciones.</small></span>
            <span><Icono nombre="ubicacion" /><b>A X m de la playa</b><small>Distancia aproximada a la playa.</small></span>
            <span><Icono nombre="whatsapp" /><b>WhatsApp</b><small>Contacto directo con el hospedaje.</small></span>
            <span><Icono nombre="corazon" /><b>Favorito</b><small>Guarda la ficha para verla después.</small></span>
            <span><Icono nombre="comparar" /><b>Comparar</b><small>Permite comparar este hospedaje con otros.</small></span>
            <span><Icono nombre="escudo" /><b>Verificado</b><small>El negocio confirmó sus datos con TecolutlaTravel.</small></span>
          </div>
        </dialog>
      </section>
    )
  }

  {
    destacadosEnPortada.length > 0 && (
      <section class="banda-destacados destacados-propuesta">
        <div class="contenedor banda-destacados__encabezado">
          <div>
            <h2 class="titulo-seccion">Hospedajes destacados</h2>
            {
              totalHospedajes > destacadosEnPortada.length && (
                <p class="banda-destacados__subtitulo">
                  Una selección para empezar. Hay muchas más opciones en el directorio.
                </p>
              )
            }
          </div>
          <a class="banda-destacados__enlace-todos" href="/hospedaje" aria-label="Ver todos los hospedajes disponibles">
            <span class="cta-texto-completo">Ver todos los hospedajes</span>
            <span class="cta-texto-corto" aria-hidden="true">Ver todos</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="carrusel-destacados" id="carrusel-destacados-home">
          {destacadosEnPortada.map((negocio, i) => (
            <NegocioCard negocio={negocio} esPrimera={i === 0} />
          ))}
        </div>
      </section>
    )
  }

  {
    totalHospedajes > destacadosEnPortada.length && (
      <section class="seccion seccion--catalogo-completo">
        <div class="contenedor">
          <div class="puente-catalogo">
            <div class="puente-catalogo__texto">
              <p class="eyebrow eyebrow--claro">¿Quieres ver más opciones?</p>
              <h2>Explora todos los hospedajes disponibles en Tecolutla.</h2>
            </div>
            <div class="puente-catalogo__acciones">
              <a class="boton boton--claro puente-catalogo__boton-principal" href="/hospedaje">
                Ver todos los hospedajes
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="seccion seccion--arena">
    <div class="contenedor">
      <div class="seccion__encabezado">
        <div>
          <h2 class="titulo-seccion">Explora por categoría</h2>
          <p class="subtitulo">Todo lo que necesitas para disfrutar Tecolutla.</p>
        </div>
        <a class="enlace-seccion" href="/descubre-tecolutla">Ver todas las categorías <span aria-hidden="true">→</span></a>
      </div>
      <div class="rejilla-categorias">
        {
          categorias.map((cat) => (
            <a class={`tile-categoria ${cat.clase}`} href={cat.href}>
              {
                cat.imagen ? (
                  <Image class="tile-categoria__imagen" src={cat.imagen.src} alt="" widths={[420, 620]} sizes="(max-width: 720px) 92vw, 25vw" />
                ) : (
                  <img class="tile-categoria__imagen" src={cat.imagenPublica} alt="" loading="lazy" />
                )
              }
              <span class="tile-categoria__velo" aria-hidden="true"></span>
              <span class="tile-categoria__icono"><Icono nombre={cat.icono} /></span>
              <span class="tile-categoria__texto">
                <span class="tile-categoria__titulo">{cat.titulo}</span>
                <span class="tile-categoria__descripcion">{cat.descripcion}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion seccion--planifica" aria-label="Mapa y alta de negocios">
    <div class="contenedor tablero-planifica">
      <article class="zonas-tecolutla">
        <div class="zonas-tecolutla__encabezado">
          <div>
            <p class="eyebrow">Ubícate antes de reservar</p>
            <h2 class="titulo-seccion">Explora Tecolutla por zonas</h2>
          </div>
          <a href="/mapa">Abrir mapa completo <span aria-hidden="true">→</span></a>
        </div>
        <div class="zonas-tecolutla__contenido">
          <nav class="zonas-tecolutla__lista" aria-label="Zonas para explorar">
            <a href="/mapa"><Icono nombre="ubicacion" /><span><b>Centro de Tecolutla</b><small>Hospedaje y restaurantes</small></span></a>
            <a href="/hospedaje?filtro=playa"><Icono nombre="olas" /><span><b>Cerca de la playa</b><small>Opciones frente al mar</small></span></a>
            <a href="/actividades"><Icono nombre="actividad" /><span><b>Río y manglares</b><small>Naturaleza y recorridos</small></span></a>
            <a href="/descubre-tecolutla"><Icono nombre="brujula" /><span><b>Alrededores</b><small>Descubre qué más visitar</small></span></a>
          </nav>
          <div class="zonas-tecolutla__mapa-wrap">
            <iframe
              class="zonas-tecolutla__mapa"
              title="Mapa de hospedajes en Tecolutla"
              src={mapaHome}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <div class="zonas-tecolutla__pins" aria-label="Hospedajes ubicados en el mapa">
              <a class="mapa-pin mapa-pin--uno" href="/hospedaje/casa-xanath" title="Casa Xanath"><span>Casa Xanath</span></a>
              <a class="mapa-pin mapa-pin--dos" href="/hospedaje/casa-mandala" title="Casa Mandala"><span>Casa Mandala</span></a>
              <a class="mapa-pin mapa-pin--tres" href="/hospedaje/casa-coronel" title="Casa Coronel"><span>Casa Coronel</span></a>
              <a class="mapa-pin mapa-pin--cuatro" href="/hospedaje/casa-ceci" title="Casa Ceci"><span>Casa Ceci</span></a>
            </div>
          </div>
        </div>
      </article>

      <aside class="anuncio-gratis" aria-labelledby="titulo-anuncio-gratis">
        <div class="anuncio-gratis__encabezado">
          <span class="anuncio-gratis__icono" aria-hidden="true"><Icono nombre="brujula" /></span>
          <div>
            <p class="eyebrow">Para negocios locales</p>
            <h2 id="titulo-anuncio-gratis">Publica tu negocio gratis</h2>
          </div>
        </div>
        <p class="anuncio-gratis__destacado">Haz que más viajeros encuentren tu negocio en Tecolutla.</p>
        <ul class="anuncio-gratis__beneficios">
          <li><Icono nombre="escudo" /> Ficha de negocio con información clara</li>
          <li><Icono nombre="ubicacion" /> Fotos, ubicación y amenidades</li>
          <li><Icono nombre="whatsapp" /> Enlace directo a tu WhatsApp</li>
          <li><Icono nombre="etiqueta" /> Presencia en el directorio turístico</li>
        </ul>
        <a class="boton anuncio-gratis__boton" href="/anunciate">Publicar mi negocio gratis <span aria-hidden="true">→</span></a>
        <small>Estamos haciendo crecer el directorio con negocios locales de Tecolutla.</small>
      </aside>
    </div>
  </section>

  <section class="seccion contenedor guia-local guia-local--home" aria-labelledby="titulo-guia-local">
    <div class="seccion__encabezado">
      <div>
        <p class="eyebrow">Planea tu viaje completo</p>
        <h2 id="titulo-guia-local" class="titulo-seccion">Más que hospedaje: descubre Tecolutla</h2>
        <p class="subtitulo">Una guía local para decidir qué comer, qué hacer y qué llevar antes de salir.</p>
      </div>
      <a class="boton boton--secundario" href="/descubre-tecolutla">Ver guía local</a>
    </div>
    <div class="guia-local__enlaces">
      <a href="/gastronomia"><Icono nombre="cubiertos" /> Dónde comer</a>
      <a href="/actividades"><Icono nombre="actividad" /> Actividades</a>
      <a href="/tips-para-tu-viaje"><Icono nombre="idea" /> Tips para tu viaje</a>
      <a href="/descubre-tecolutla"><Icono nombre="brujula" /> Explora Tecolutla</a>
    </div>
  </section>

  {
    tambienEnTecolutla.length > 0 && (
      <section class="seccion contenedor tambien-home">
        <div class="seccion__encabezado">
          <div>
            <h2 class="titulo-seccion">También en Tecolutla</h2>
            <p class="subtitulo">Gastronomía, actividades y servicios que puedes encontrar.</p>
          </div>
        </div>
        <div class="rejilla-negocios">
          {tambienEnTecolutla.map((negocio) => (
            <NegocioCard negocio={negocio} />
          ))}
        </div>
      </section>
    )
  }

  <section class="boletin-local" aria-label="Suscripción a ofertas y tips">
    <div class="contenedor boletin-local__interior">
      <div><Icono nombre="avion" /><span><b>Recibe ofertas y tips para tu viaje a Tecolutla</b><small>Promociones exclusivas y recomendaciones locales.</small></span></div>
      <form><label class="sr-only" for="correo-boletin">Tu correo electrónico</label><input id="correo-boletin" type="email" placeholder="Tu correo electrónico" /><button type="button">Suscribirme</button></form>
    </div>
  </section>

</BaseLayout>

<script>
  import { leerIndiceBuscador, buscarNegocios, resultadosHtml } from '../utils/buscadorNegocios';

  const MAX_DESTACADOS_HOME = 8;

  function hashDiario(semilla: string): number {
    let hash = 5381;
    for (let i = 0; i < semilla.length; i++) {
      hash = (hash * 33) ^ semilla.charCodeAt(i);
    }
    return hash >>> 0;
  }

  // Igual que en /hospedaje: rota el orden por día calendario (calculado
  // aquí en el navegador, no en el build) y limita cuántos se muestran en
  // la portada — así, aunque haya cientos de negocios destacados, todos
  // tienen oportunidad de aparecer con el tiempo, y la portada no se
  // vuelve una lista interminable.
  function rotarYLimitarDestacadosHome() {
    const contenedor = document.getElementById('carrusel-destacados-home');
    if (!contenedor) return;

    // La tarjeta "Más hospedaje →" del final es una liga fija, no un
    // negocio — se excluye de la rotación/límite diario y se vuelve a
    // colocar al final después, para que siempre sea lo último que se ve
    // deslizando el carrusel.
    const tarjetaVerMas = contenedor.querySelector('[data-tarjeta-ver-mas]');
    const tarjetas = Array.from(contenedor.children).filter(
      (t) => t !== tarjetaVerMas,
    ) as HTMLElement[];
    const hoy = new Date().toISOString().slice(0, 10);
    const fijas = tarjetas.filter((t) => t.dataset.ordenManual);
    const aleatorias = tarjetas.filter((t) => !t.dataset.ordenManual);
    aleatorias.sort(
      (a, b) => hashDiario(`${hoy}-${a.dataset.slug}`) - hashDiario(`${hoy}-${b.dataset.slug}`),
    );

    const ordenFinal = [...fijas, ...aleatorias];
    ordenFinal.forEach((tarjeta) => contenedor.appendChild(tarjeta));
    ordenFinal.forEach((tarjeta, i) => {
      tarjeta.style.display = i < MAX_DESTACADOS_HOME ? '' : 'none';
    });
    if (tarjetaVerMas) contenedor.appendChild(tarjetaVerMas);

    // Igual que en PaginaCategoria.astro: la rotación diaria decide cuál
    // tarjeta queda primera de verdad, así que la prioridad de imagen
    // (carga eager / fetchpriority alta, sección de rendimiento) se
    // aplica aquí según el orden final, no según lo que haya decidido
    // el servidor al renderizar.
    ordenFinal.forEach((tarjeta, i) => {
      const img = tarjeta.querySelector<HTMLImageElement>('.tarjeta__imagen');
      if (!img) return;
      img.loading = i === 0 ? 'eager' : 'lazy';
      if (i === 0) img.setAttribute('fetchpriority', 'high');
      else img.removeAttribute('fetchpriority');
    });
  }

  // Buscador píldora del hero — misma lógica/índice que el panel del
  // Header (src/utils/buscadorNegocios.ts), presentación distinta.
  function activarBuscadorHome() {
    const input = document.getElementById('buscador-home-input') as HTMLInputElement | null;
    const resultados = document.getElementById('buscador-home-resultados');
    const sinResultados = document.getElementById('buscador-home-sin-resultados');
    if (!input || !resultados || !sinResultados) return;
    const indice = leerIndiceBuscador();

    input.addEventListener('input', () => {
      const coincidencias = buscarNegocios(indice, input.value);
      if (!input.value.trim()) {
        resultados.innerHTML = '';
        sinResultados.hidden = true;
        return;
      }
      if (coincidencias.length === 0) {
        resultados.innerHTML = '';
        sinResultados.hidden = false;
        return;
      }
      sinResultados.hidden = true;
      resultados.innerHTML = resultadosHtml(coincidencias);
    });
  }

  // El botón "Ver todos →" se mueve unas veces cuando la sección entra en
  // pantalla, solo para que el ojo lo note. Se anima el botón completo
  // (no solo la flecha: se probó así primero y la flecha sola se veía
  // demasiado chica para notarse). Cada "tanda" de movimiento son las 3
  // repeticiones del @keyframes (animation-iteration-count en CSS); al
  // terminar una tanda espera 3s y dispara la siguiente, hasta 5 tandas
  // en total — después se detiene para siempre, nunca queda en bucle
  // infinito.
  //
  // El listener de "animationend" se registra UNA sola vez (no dentro de
  // iniciar()) para no ir acumulando listeners duplicados cada vez que
  // la animación se reinicia — solo el estado (tandas, observer) se
  // reinicia en cada llamada a iniciar().
  function configurarAnimacionBotonDestacados() {
    const boton = document.querySelector('.banda-destacados__boton');
    const seccion = document.querySelector('.banda-destacados');
    if (!boton || !seccion || !('IntersectionObserver' in window)) return null;

    const MAX_TANDAS = 5;
    const PAUSA_ENTRE_TANDAS_MS = 3000;
    const estado = { tandas: 0, observador: null };

    function dispararTanda() {
      estado.tandas++;
      boton.classList.add('banda-destacados__boton--animar');
    }

    boton.addEventListener('animationend', () => {
      boton.classList.remove('banda-destacados__boton--animar');
      if (estado.tandas < MAX_TANDAS) {
        setTimeout(dispararTanda, PAUSA_ENTRE_TANDAS_MS);
      }
    });

    return function iniciar() {
      // Sin IntersectionObserver en el navegador, o con
      // prefers-reduced-motion, simplemente no se anima — no es
      // información esencial.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      estado.tandas = 0;
      boton.classList.remove('banda-destacados__boton--animar');
      estado.observador?.disconnect();
      estado.observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (!entrada.isIntersecting) return;
            dispararTanda();
            estado.observador.unobserve(entrada.target);
          });
        },
        { threshold: 0.4 },
      );
      estado.observador.observe(seccion);
    };
  }

  rotarYLimitarDestacadosHome();
  activarBuscadorHome();

  const ayudaIconos = document.querySelector<HTMLDialogElement>('[data-ayuda-iconos]');
  document.querySelector('[data-abrir-ayuda]')?.addEventListener('click', () => ayudaIconos?.showModal());
  document.querySelector('[data-cerrar-ayuda]')?.addEventListener('click', () => ayudaIconos?.close());
  ayudaIconos?.addEventListener('click', (evento) => {
    if (evento.target === ayudaIconos) ayudaIconos.close();
  });

  const iniciarAnimacionBotonDestacados = configurarAnimacionBotonDestacados();
  iniciarAnimacionBotonDestacados?.();

  // Al entrar a la ficha de un negocio y volver con "atrás", el
  // navegador suele restaurar esta página desde memoria (bfcache) en
  // vez de recargarla — el script de arriba no vuelve a correr solo, así
  // que sin este listener la animación no se repetía al regresar.
  window.addEventListener('pageshow', (evento) => {
    if (evento.persisted) iniciarAnimacionBotonDestacados?.();
  });
</script>
