---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from '../components/NegocioCard.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';
import fotoPromesa from '../assets/sitio/promesa-playa.jpg';

// Anchos reales que sirve el <Picture> de abajo — se reutilizan para
// generar el <link rel="preload"> del mismo set de AVIF en el head,
// así el navegador no espera a parsear el CSS para empezar a bajarla
// (es el elemento LCP del home).
const ANCHOS_PROMESA = [480, 768, 1120, 1600];
const preloadPromesa = await Promise.all(
  ANCHOS_PROMESA.map((w) => getImage({ src: fotoPromesa, width: w, format: 'avif' })),
);
const preloadPromesaSrcset = preloadPromesa
  .map((img, i) => `${img.src} ${ANCHOS_PROMESA[i]}w`)
  .join(', ');

const negocios = await getCollection('negocios');
// Orden manual primero (si se define); el resto se manda tal cual al
// navegador, que rota el orden por día y limita a MAX_DESTACADOS_HOME
// (ver script abajo) — así, aunque haya cientos de negocios pagando, la
// portada no se vuelve una lista interminable, y todos rotan con el tiempo.
const destacados = negocios
  .filter((n) => n.data.destacado)
  .sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));

// "También en Tecolutla": una ficha por cada categoría que NO sea
// hospedaje, elegida por puntaje de completitud (la misma lógica que
// ordena /gastronomia, /actividades y /servicios). Si una categoría
// todavía no tiene negocios publicados, simplemente no aparece.
const OTRAS_CATEGORIAS = ['gastronomia', 'actividades', 'servicios'] as const;
const tambienEnTecolutla = OTRAS_CATEGORIAS.map(
  (cat) => negocios.filter((n) => n.data.categoria === cat).sort(compararDentroDeGrupo)[0],
).filter((n): n is NonNullable<typeof n> => Boolean(n));

// Único lugar donde viven los emojis de los sellos de confianza — ver
// nota en .sello-confianza__icono (global.css). Sustituir aquí cuando
// llegue el set de íconos ilustrados.
const SELLOS_CONFIANZA = [
  { emoji: '✅', fuerte: 'Verificado', resto: 'con cada dueño' },
  { emoji: '💬', fuerte: 'WhatsApp', resto: 'directo' },
  { emoji: '🙌', fuerte: 'Cero', resto: 'comisiones' },
];

// Una categoría sin negocios no se renderiza en la franja — mandar
// gente a una página vacía es peor que no mostrarla. El conteo sale
// del build, nunca de una lista escrita a mano: en cuanto entra el
// primer negocio de esa categoría, el tile reaparece solo.
const categorias = [
  { href: '/hospedaje', clase: 'tile--hospedaje', icono: '🏡', titulo: 'Hospedaje' },
  { href: '/gastronomia', clase: 'tile--gastronomia', icono: '🍤', titulo: 'Gastronomía' },
  { href: '/actividades', clase: 'tile--actividades', icono: '🛶', titulo: 'Actividades' },
  { href: '/servicios', clase: 'tile--servicios', icono: '🚲', titulo: 'Servicios' },
]
  .map((cat) => ({
    ...cat,
    conteo: negocios.filter((n) => n.data.categoria === cat.href.slice(1)).length,
  }))
  .filter((cat) => cat.conteo > 0);

// Sin SearchAction: el buscador del Header es 100% en el navegador
// (filtra un índice ya cargado, sección "buscador" de Header.astro) —
// no existe ninguna URL tipo /buscar?q=... que Google pueda usar de
// verdad para ejecutar una búsqueda. Declarar un SearchAction de todos
// modos describiría una función que el sitio no tiene.
const esquemaWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TecolutlaTravel',
  url: 'https://tecolutlatravel.mx/',
};

const esquemaOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TecolutlaTravel',
  url: 'https://tecolutlatravel.mx/',
  logo: 'https://tecolutlatravel.mx/og-default.jpg',
};
---

<BaseLayout
  titulo="Hoteles y casas de hospedaje en Tecolutla, Veracruz | Qué hacer y dónde comer"
  tituloCompleto
  descripcion="Guía local de Tecolutla: casas de hospedaje con alberca, hoteles, restaurantes de mariscos y paseos por los manglares. Contacto directo con cada negocio por WhatsApp."
>
  <Fragment slot="head-extra">
    <link
      rel="preload"
      as="image"
      imagesrcset={preloadPromesaSrcset}
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(esquemaWebSite)} />
  <script type="application/ld+json" set:html={JSON.stringify(esquemaOrganization)} />

  <section class="promesa">
    <Picture
      src={fotoPromesa}
      alt="Vista aérea de la playa de Tecolutla con sombrillas, lanchas y bañistas"
      width={1600}
      height={900}
      widths={ANCHOS_PROMESA}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="promesa__imagen"
    />
    <div class="promesa__overlay" aria-hidden="true"></div>
    <div class="contenedor promesa__interior">
      <h1>Casas de hospedaje y hoteles en <span class="promesa__resaltado">Tecolutla</span>, Veracruz</h1>
      <p class="promesa__subtitulo">
        Habla directo por WhatsApp con el dueño — sin comisiones, sin intermediarios.
      </p>

      <div class="buscador-pildora">
        <label for="buscador-home-input" class="sr-only">Buscar un negocio por nombre</label>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" class="buscador-pildora__icono">
          <circle cx="8.5" cy="8.5" r="6" />
          <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          id="buscador-home-input"
          class="buscador-pildora__input"
          placeholder="Busca hospedaje, restaurantes, actividades…"
          autocomplete="off"
        />
        <ul class="buscador__resultados buscador-pildora__resultados" id="buscador-home-resultados" aria-live="polite"></ul>
        <p class="buscador__sin-resultados buscador-pildora__resultados" id="buscador-home-sin-resultados" hidden>
          No encontramos negocios con ese nombre.
        </p>
      </div>

      <div class="promesa__confianza">
        {
          SELLOS_CONFIANZA.map((sello) => (
            <div class="sello-confianza">
              <span class="sello-confianza__icono" aria-hidden="true">{sello.emoji}</span>
              <span><b>{sello.fuerte}</b>&nbsp;{sello.resto}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    destacados.length > 0 && (
      <section class="banda-destacados">
        <div class="contenedor banda-destacados__encabezado">
          <div>
            <h2 class="titulo-seccion titulo-seccion--claro">Negocios destacados</h2>
            <p class="banda-destacados__subtitulo">⟳ El orden rota cada día — todos los destacados se ven</p>
          </div>
          <a class="boton boton--claro boton--pildora" href="/hospedaje">Ver todos →</a>
        </div>
        <div class="carrusel-destacados" id="carrusel-destacados-home">
          {destacados.map((negocio, i) => (
            <NegocioCard negocio={negocio} esPrimera={i === 0} />
          ))}
        </div>
      </section>
    )
  }

  <section class="franja-categorias seccion--arena">
    <div class="contenedor">
      <div class="franja-categorias__fila">
        {
          categorias.map((cat) => (
            <a class={`franja-categorias__tile ${cat.clase}`} href={cat.href}>
              <span class="franja-categorias__icono">{cat.icono}</span>
              <span class="franja-categorias__titulo">{cat.titulo}</span>
              <span class="franja-categorias__conteo">{cat.conteo}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    tambienEnTecolutla.length > 0 && (
      <section class="seccion contenedor">
        <div class="seccion__encabezado">
          <div>
            <h2 class="titulo-seccion">También en Tecolutla</h2>
            <p class="subtitulo">Gastronomía, actividades y servicios que puedes encontrar.</p>
          </div>
        </div>
        <div class="rejilla-negocios">
          {tambienEnTecolutla.map((negocio) => (
            <NegocioCard negocio={negocio} />
          ))}
        </div>
      </section>
    )
  }

  <section class="seccion contenedor">
    <div class="cta-negocio">
      <div>
        <h2>¿Tienes un negocio en Tecolutla?</h2>
        <p>
          Tu página con fotos, ubicación y WhatsApp directo. Gratis, siempre. Nosotros la armamos
          por ti.
        </p>
      </div>
      <a class="boton boton--whatsapp" href="/anunciate">Quiero mi página gratis</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { leerIndiceBuscador, buscarNegocios, resultadosHtml } from '../utils/buscadorNegocios';

  const MAX_DESTACADOS_HOME = 8;

  function hashDiario(semilla: string): number {
    let hash = 5381;
    for (let i = 0; i < semilla.length; i++) {
      hash = (hash * 33) ^ semilla.charCodeAt(i);
    }
    return hash >>> 0;
  }

  // Igual que en /hospedaje: rota el orden por día calendario (calculado
  // aquí en el navegador, no en el build) y limita cuántos se muestran en
  // la portada — así, aunque haya cientos de negocios destacados, todos
  // tienen oportunidad de aparecer con el tiempo, y la portada no se
  // vuelve una lista interminable.
  function rotarYLimitarDestacadosHome() {
    const contenedor = document.getElementById('carrusel-destacados-home');
    if (!contenedor) return;

    const tarjetas = Array.from(contenedor.children) as HTMLElement[];
    const hoy = new Date().toISOString().slice(0, 10);
    const fijas = tarjetas.filter((t) => t.dataset.ordenManual);
    const aleatorias = tarjetas.filter((t) => !t.dataset.ordenManual);
    aleatorias.sort(
      (a, b) => hashDiario(`${hoy}-${a.dataset.slug}`) - hashDiario(`${hoy}-${b.dataset.slug}`),
    );

    const ordenFinal = [...fijas, ...aleatorias];
    ordenFinal.forEach((tarjeta) => contenedor.appendChild(tarjeta));
    ordenFinal.forEach((tarjeta, i) => {
      tarjeta.style.display = i < MAX_DESTACADOS_HOME ? '' : 'none';
    });

    // Igual que en PaginaCategoria.astro: la rotación diaria decide cuál
    // tarjeta queda primera de verdad, así que la prioridad de imagen
    // (carga eager / fetchpriority alta, sección de rendimiento) se
    // aplica aquí según el orden final, no según lo que haya decidido
    // el servidor al renderizar.
    ordenFinal.forEach((tarjeta, i) => {
      const img = tarjeta.querySelector<HTMLImageElement>('.tarjeta__imagen');
      if (!img) return;
      img.loading = i === 0 ? 'eager' : 'lazy';
      if (i === 0) img.setAttribute('fetchpriority', 'high');
      else img.removeAttribute('fetchpriority');
    });
  }

  // Buscador píldora del hero — misma lógica/índice que el panel del
  // Header (src/utils/buscadorNegocios.ts), presentación distinta.
  function activarBuscadorHome() {
    const input = document.getElementById('buscador-home-input') as HTMLInputElement | null;
    const resultados = document.getElementById('buscador-home-resultados');
    const sinResultados = document.getElementById('buscador-home-sin-resultados');
    if (!input || !resultados || !sinResultados) return;
    const indice = leerIndiceBuscador();

    input.addEventListener('input', () => {
      const coincidencias = buscarNegocios(indice, input.value);
      if (!input.value.trim()) {
        resultados.innerHTML = '';
        sinResultados.hidden = true;
        return;
      }
      if (coincidencias.length === 0) {
        resultados.innerHTML = '';
        sinResultados.hidden = false;
        return;
      }
      sinResultados.hidden = true;
      resultados.innerHTML = resultadosHtml(coincidencias);
    });
  }

  rotarYLimitarDestacadosHome();
  activarBuscadorHome();
</script>
