---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titulo="Panel interno"
  descripcion="Panel interno de resultados — acceso restringido, no público."
  noindex
>
  <section class="panel">
    <div class="panel__login" id="panel-login">
      <div class="panel__login-card">
        <svg class="panel__login-icono" viewBox="0 0 100 100" aria-hidden="true">
          <rect x="4" y="4" width="92" height="92" rx="22" fill="#0B6F7A"></rect>
          <mask id="panel-ola-login" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
            <rect x="0" y="0" width="100" height="100" fill="#fff"></rect>
            <path
              d="M14,36 Q26,24 38,36 Q50,48 62,36 Q74,24 86,36 L86,46 Q74,58 62,46 Q50,34 38,46 Q26,58 14,46 Z"
              fill="#000"
            ></path>
          </mask>
          <path
            d="M50,10 C67,10 80,24 80,42 C80,55 71,68 59,82 C55,86.5 51,90 50,93 C49,90 45,86.5 41,82 C29,68 20,55 20,42 C20,24 33,10 50,10 Z"
            fill="#FF7A5C"
            mask="url(#panel-ola-login)"
          ></path>
        </svg>
        <h1 class="panel__login-titulo">Panel interno</h1>
        <p class="panel__login-subtitulo">Acceso restringido — solo para uso interno.</p>
        <form id="form-login">
          <input
            type="password"
            id="input-clave"
            placeholder="Contraseña"
            required
            autocomplete="current-password"
          />
          <button type="submit" class="boton">Entrar</button>
        </form>
        <p class="panel__login-error" id="login-error" hidden></p>
      </div>
    </div>

    <div class="panel__dashboard" id="panel-dashboard" hidden>
      <header class="panel__encabezado">
        <div class="panel__marca">
          <svg class="panel__marca-icono" viewBox="0 0 100 100" aria-hidden="true">
            <mask id="panel-ola-header" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
              <rect x="0" y="0" width="100" height="100" fill="#fff"></rect>
              <path
                d="M14,36 Q26,24 38,36 Q50,48 62,36 Q74,24 86,36 L86,46 Q74,58 62,46 Q50,34 38,46 Q26,58 14,46 Z"
                fill="#000"
              ></path>
            </mask>
            <path
              d="M50,10 C67,10 80,24 80,42 C80,55 71,68 59,82 C55,86.5 51,90 50,93 C49,90 45,86.5 41,82 C29,68 20,55 20,42 C20,24 33,10 50,10 Z"
              fill="#FF7A5C"
              mask="url(#panel-ola-header)"
            ></path>
          </svg>
          <span>Tecolutla<em>Travel</em> — Panel interno</span>
        </div>
        <small class="panel__modo-datos" id="modo-datos" hidden></small>
        <button type="button" class="boton boton--secundario boton--chico" id="boton-salir">Salir</button>
      </header>

      <nav class="panel__tabs">
        <button type="button" class="panel__tab" data-vista="individual" aria-pressed="true">
          Por negocio
        </button>
        <button type="button" class="panel__tab" data-vista="comparativa" aria-pressed="false">
          Comparativa
        </button>
        <button type="button" class="panel__tab" data-vista="bot" aria-pressed="false">
          Bot
        </button>
      </nav>

      <div class="panel__vista" id="vista-individual">
        <div class="panel__controles">
          <select id="selector-negocio"></select>
          <button type="button" class="boton boton--destacado boton--chico" id="boton-pdf-individual">
            Exportar PDF
          </button>
        </div>
        <div id="contenido-individual"></div>
      </div>

      <div class="panel__vista" id="vista-comparativa" hidden>
        <div class="panel__controles panel__controles--fin">
          <button type="button" class="boton boton--destacado boton--chico" id="boton-pdf-comparativa">
            Exportar PDF
          </button>
        </div>
        <div id="contenido-comparativa"></div>
      </div>

      <div class="panel__vista" id="vista-bot" hidden>
        <div id="contenido-bot"></div>
      </div>
    </div>
  </section>

  <div id="reporte-pdf-contenedor" class="panel__pdf-oculto"></div>
</BaseLayout>

<style is:global>
  /* Estilos del panel interno — is:global a propósito: buena parte de este
     contenido se genera en JS vía innerHTML (tarjetas, gráficas, tablas), y
     esas plantillas se reutilizan tal cual para el PDF exportado. El
     scoping de Astro no alcanza a elementos inyectados así, por eso el
     bloque va global (con el prefijo panel__ para no chocar con el resto
     del sitio). */
  .panel {
    padding: 2rem 1.25rem 4rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  .panel__login:not([hidden]) {
    display: flex;
    justify-content: center;
    padding-top: 3rem;
  }

  .panel__login-card {
    background: var(--color-blanco);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    padding: 2.5rem 2rem;
    text-align: center;
    max-width: 360px;
    width: 100%;
  }

  .panel__login-icono {
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
  }

  .panel__login-titulo {
    font-family: var(--fuente-titulos);
    font-weight: 900;
    color: var(--color-tinta);
    margin: 0 0 0.4rem;
  }

  .panel__login-subtitulo {
    color: var(--color-texto-suave);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  #form-login {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #input-clave {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-chico);
    font-size: 1rem;
  }

  .panel__login-error {
    color: var(--color-coral-texto);
    font-size: 0.85rem;
    margin: 1rem 0 0;
  }

  .panel__encabezado {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .panel__marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--fuente-titulos);
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--color-tinta);
  }

  .panel__marca-icono {
    width: 28px;
    height: 28px;
  }

  .panel__marca em {
    font-style: normal;
    color: var(--color-coral);
  }

  .panel__tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-borde);
  }

  .panel__tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 0.6rem 0.2rem;
    margin-right: 1.25rem;
    font-family: var(--fuente-cuerpo);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-texto-suave);
    cursor: pointer;
  }

  .panel__tab[aria-pressed='true'] {
    color: var(--color-turquesa);
    border-bottom-color: var(--color-turquesa);
  }

  .panel__controles {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .panel__controles--fin {
    justify-content: flex-end;
  }

  #selector-negocio {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-chico);
    font-size: 0.95rem;
    min-width: 220px;
  }

  .panel__nombre-negocio {
    font-family: var(--fuente-titulos);
    font-weight: 900;
    color: var(--color-tinta);
    margin: 0 0 1rem;
  }

  .panel__plan-estado {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: -0.5rem 0 1.25rem;
  }

  .panel__plan-mensaje {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-turquesa);
  }

  .panel__plan-mensaje--error {
    color: var(--color-coral-texto);
  }

  .panel__tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .panel__tarjeta {
    background: var(--color-blanco);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    border-top: 4px solid var(--color-turquesa);
    padding: 1.1rem 1.25rem;
  }

  .panel__tarjeta-valor {
    font-family: var(--fuente-titulos);
    font-weight: 900;
    font-size: 1.9rem;
    color: var(--color-tinta);
    margin: 0;
  }

  .panel__tarjeta-etiqueta {
    font-size: 0.82rem;
    color: var(--color-texto-suave);
    margin: 0.2rem 0 0;
  }

  .panel__seccion {
    background: var(--color-blanco);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .panel__seccion h3 {
    font-family: var(--fuente-titulos);
    font-weight: 900;
    font-size: 1rem;
    color: var(--color-tinta);
    margin: 0 0 1rem;
  }

  .panel__fila-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .panel__fila-2 .panel__seccion {
    margin-bottom: 0;
  }

  .panel__leyenda {
    display: flex;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--color-texto-suave);
    margin-bottom: 0.75rem;
  }

  .panel__modo-datos { color: var(--color-verde-oscuro); font-weight: 700; font-size: 0.78rem; }

  .panel__nota-medicion {
    margin: -0.25rem 0 0.75rem;
    color: var(--color-texto-suave);
    font-size: 0.82rem;
  }

  .panel__leyenda .punto {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.35rem;
  }

  .panel__tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .panel__tabla th {
    text-align: left;
    background: var(--color-arena);
    color: var(--color-tinta);
    padding: 0.5rem 0.6rem;
    font-weight: 600;
  }

  .panel__tabla td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--color-borde);
  }

  .panel__th-orden {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .panel__th-orden:hover {
    color: var(--color-turquesa);
  }

  .panel__semaforo {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }

  .panel__semaforo--verde {
    background: #2e9e5b;
  }

  .panel__semaforo--ambar {
    background: #e0a52c;
  }

  .panel__semaforo--rojo {
    background: #d3453f;
  }

  .panel__semaforo--gris {
    background: #b7c0c2;
  }

  .panel__nota-promedio {
    font-size: 0.82rem;
    color: var(--color-texto-suave);
    margin: -0.5rem 0 1rem;
  }

  .panel__tabla small {
    color: var(--color-texto-suave);
    font-weight: 400;
  }

  .panel__mini-badge {
    display: inline-block;
    background: var(--color-coral);
    color: var(--color-tinta);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    margin-left: 0.35rem;
  }

  .panel__recomendaciones {
    margin: 0;
    padding-left: 1.2rem;
  }

  .panel__recomendaciones li {
    margin-bottom: 0.4rem;
    font-size: 0.92rem;
  }

  .panel__vacio {
    color: var(--color-texto-suave);
    font-size: 0.9rem;
  }

  .panel__pdf-oculto {
    position: fixed;
    left: -9999px;
    top: 0;
  }

  @media (max-width: 640px) {
    .panel__tarjetas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  import { jsPDF } from 'jspdf';
  import html2canvas from 'html2canvas';

  const TOKEN_SESSION = 'panel-tt-token';
  const ORDEN_DIAS = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'];
  const NOMBRES_CANAL: Record<string, string> = {
    google: 'Google',
    instagram: 'Instagram',
    facebook: 'Facebook',
    directo: 'Directo',
    interno: 'El sitio',
    otro: 'Otros',
  };

  const el = {
    login: document.getElementById('panel-login') as HTMLElement,
    dashboard: document.getElementById('panel-dashboard') as HTMLElement,
    formLogin: document.getElementById('form-login') as HTMLFormElement,
    inputClave: document.getElementById('input-clave') as HTMLInputElement,
    loginError: document.getElementById('login-error') as HTMLElement,
    botonSalir: document.getElementById('boton-salir') as HTMLButtonElement,
    tabs: document.querySelectorAll<HTMLButtonElement>('.panel__tab'),
    vistaIndividual: document.getElementById('vista-individual') as HTMLElement,
    vistaComparativa: document.getElementById('vista-comparativa') as HTMLElement,
    vistaBot: document.getElementById('vista-bot') as HTMLElement,
    contenidoBot: document.getElementById('contenido-bot') as HTMLElement,
    selectorNegocio: document.getElementById('selector-negocio') as HTMLSelectElement,
    contenidoIndividual: document.getElementById('contenido-individual') as HTMLElement,
    contenidoComparativa: document.getElementById('contenido-comparativa') as HTMLElement,
    botonPdfIndividual: document.getElementById('boton-pdf-individual') as HTMLButtonElement,
    botonPdfComparativa: document.getElementById('boton-pdf-comparativa') as HTMLButtonElement,
    reportePdf: document.getElementById('reporte-pdf-contenedor') as HTMLElement,
    modoDatos: document.getElementById('modo-datos') as HTMLElement,
  };

  interface DatosNegocio {
    slug: string;
    nombre: string;
    categoria: string;
    destacado: boolean;
    plan: 'gratuito' | 'pago';
    puntaje: number;
    recomendaciones: string[];
    stats: {
      vistasTotal: number;
      clicsTotal: number;
      comoLlegarTotal?: number;
      compartirTotal?: number;
      accionesRegistradasDesde?: string;
      origenEscritura?: { modo?: string; deployId?: string | null };
      porMes: Record<string, any>;
    };
  }

  interface MesBusquedas {
    terminos: Record<string, number>;
    sinResultado: Record<string, number>;
  }

  interface UsoModelo {
    entrada: number;
    salida: number;
    mensajes: number;
  }

  interface BotUso {
    id: string;
    nombre: string;
    reportando: boolean;
    porMes: Record<string, Record<string, UsoModelo>>;
  }

  interface EventoAlerta {
    ts: string;
    motivo: string;
    ip: string;
    extra: string;
  }

  let negociosData: DatosNegocio[] = [];
  let busquedasPorMes: Record<string, MesBusquedas> = {};
  let botsUso: BotUso[] = [];
  let eventosBot: EventoAlerta[] = [];
  // Distingue "consultamos y no hay eventos" de "no pudimos consultar". En una
  // sección de seguridad importa: decir "sin ataques" cuando en realidad no se
  // sabe es peor que admitir que la consulta falló.
  let botConsultado = false;

  interface GastoReal {
    ok: boolean;
    configurado: boolean;
    desdeCache?: boolean;
    completo?: boolean;
    desde?: string;
    totalUsd?: number;
    porConcepto?: Record<string, number>;
    porLlave?: { nombre: string; entrada: number; salida: number }[];
    error?: string;
  }

  let gastoReal: GastoReal | null = null;
  let accionesRegistradasDesde: string | null = null;
  let modoDatos = 'produccion';
  let deployId: string | null = null;

  // ---------- Autenticación ----------
  // El login (dashboard-auth) valida la contraseña UNA vez y emite un
  // token de sesión de corta duración (3h) — el navegador ya no reenvía
  // la contraseña real en cada petición de datos, solo ese token.
  // dashboard-datos vuelve a validar el token en cada llamada (no solo
  // aquí), así que aunque alguien se salte esta pantalla no obtiene datos
  // sin una sesión vigente. El login también tiene límite de intentos
  // (5 cada 15 min por IP) contra fuerza bruta.

  async function iniciarSesionConClave(
    clave: string,
  ): Promise<{ ok: true; token: string } | { ok: false; error: string }> {
    try {
      const respuesta = await fetch('/.netlify/functions/dashboard-auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clave }),
      });
      const datos = await respuesta.json().catch(() => ({}));
      if (!respuesta.ok || !datos.token) {
        return { ok: false, error: datos.error || 'Contraseña incorrecta.' };
      }
      return { ok: true, token: datos.token };
    } catch {
      return { ok: false, error: 'No se pudo conectar. Intenta de nuevo.' };
    }
  }

  type ResultadoNegocios =
    | { ok: true; negocios: DatosNegocio[]; accionesRegistradasDesde: string | null; modoDatos: string; deployId: string | null }
    | { ok: false; sesionInvalida: boolean };

  async function obtenerNegocios(token: string): Promise<ResultadoNegocios> {
    try {
      const respuesta = await fetch('/.netlify/functions/dashboard-datos', {
        method: 'POST',
        headers: { 'x-session-token': token },
      });
      const datos = await respuesta.json().catch(() => ({}));
      if (!respuesta.ok || !datos.ok) {
        return { ok: false, sesionInvalida: respuesta.status === 401 };
      }
      return {
        ok: true,
        negocios: datos.negocios,
        accionesRegistradasDesde: typeof datos.accionesRegistradasDesde === 'string'
          ? datos.accionesRegistradasDesde
          : null,
        modoDatos: typeof datos.modoDatos === 'string' ? datos.modoDatos : 'produccion',
        deployId: typeof datos.deployId === 'string' ? datos.deployId : null,
      };
    } catch {
      return { ok: false, sesionInvalida: false };
    }
  }

  // Falla "silencioso" — si busquedas no carga (función caída, error de
  // red) el resto del panel debe seguir funcionando, no es tan crítico
  // como los datos de negocios para bloquear el login.
  async function obtenerBusquedas(token: string): Promise<Record<string, MesBusquedas> | null> {
    try {
      const respuesta = await fetch('/.netlify/functions/dashboard-busquedas', {
        method: 'POST',
        headers: { 'x-session-token': token },
      });
      if (!respuesta.ok) return null;
      const datos = await respuesta.json();
      return datos.ok ? datos.porMes : null;
    } catch {
      return null;
    }
  }

  // Mismo criterio "falla silencioso" que obtenerBusquedas: si el bot no
  // responde, el resto del panel sigue funcionando.
  async function obtenerDatosBot(
    token: string,
  ): Promise<{ bots: BotUso[]; eventos: EventoAlerta[] } | null> {
    try {
      const respuesta = await fetch('/.netlify/functions/dashboard-bot', {
        method: 'POST',
        headers: { 'x-session-token': token },
      });
      if (!respuesta.ok) return null;
      const datos = await respuesta.json();
      if (!datos.ok) return null;
      return {
        bots: Array.isArray(datos.bots) ? datos.bots : [],
        eventos: Array.isArray(datos.eventos) ? datos.eventos : [],
      };
    } catch {
      return null;
    }
  }

  // Consulta la Admin API de Anthropic (gasto facturado real). Puede tardar
  // más que las demás porque sale a un servicio externo; igual que las otras,
  // si falla no impide entrar al panel.
  async function obtenerGastoReal(token: string): Promise<GastoReal | null> {
    try {
      const respuesta = await fetch('/.netlify/functions/dashboard-gasto-real', {
        method: 'POST',
        headers: { 'x-session-token': token },
      });
      const datos = await respuesta.json().catch(() => null);
      return datos && typeof datos === 'object' ? (datos as GastoReal) : null;
    } catch {
      return null;
    }
  }

  async function entrarConToken(token: string, opciones: { silencioso?: boolean } = {}) {
    const [resultadoNegocios, busquedas, datosBot, gasto] = await Promise.all([
      obtenerNegocios(token),
      obtenerBusquedas(token),
      obtenerDatosBot(token),
      obtenerGastoReal(token),
    ]);
    gastoReal = gasto;
    if (!resultadoNegocios.ok) {
      if (resultadoNegocios.sesionInvalida) sessionStorage.removeItem(TOKEN_SESSION);
      if (!opciones.silencioso) {
        el.loginError.textContent = resultadoNegocios.sesionInvalida
          ? 'Tu sesión venció. Vuelve a entrar con la contraseña.'
          : 'No se pudieron cargar los datos del panel. Intenta de nuevo.';
        el.loginError.hidden = false;
      }
      return;
    }

    sessionStorage.setItem(TOKEN_SESSION, token);
    negociosData = resultadoNegocios.negocios;
    accionesRegistradasDesde = resultadoNegocios.accionesRegistradasDesde;
    modoDatos = resultadoNegocios.modoDatos;
    deployId = resultadoNegocios.deployId;
    busquedasPorMes = busquedas || {};
    botsUso = datosBot?.bots || [];
    eventosBot = datosBot?.eventos || [];
    botConsultado = datosBot !== null;
    el.login.hidden = true;
    el.dashboard.hidden = false;
    const escrituraVerificada = negociosData.some(({ stats }) =>
      modoDatos === 'prueba'
        ? stats.origenEscritura?.modo === 'prueba' && stats.origenEscritura?.deployId === deployId
        : stats.origenEscritura?.modo === 'produccion');
    el.modoDatos.textContent = modoDatos === 'local'
      ? 'Datos locales — no se guardan'
      : modoDatos === 'prueba'
        ? `Datos de prueba de este deploy — escritura ${escrituraVerificada ? 'verificada' : 'no verificada'}`
        : `Datos de producción — escritura ${escrituraVerificada ? 'verificada' : 'no verificada'}`;
    el.modoDatos.hidden = false;
    poblarSelectorNegocios();
    if (el.selectorNegocio.value) renderizarVistaIndividual(el.selectorNegocio.value);
    renderizarVistaComparativa();
    renderizarVistaBot();
  }

  el.formLogin.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    el.loginError.hidden = true;
    const resultado = await iniciarSesionConClave(el.inputClave.value);
    if (!resultado.ok) {
      el.loginError.textContent = resultado.error;
      el.loginError.hidden = false;
      return;
    }
    await entrarConToken(resultado.token);
  });

  el.botonSalir.addEventListener('click', () => {
    const token = sessionStorage.getItem(TOKEN_SESSION);
    sessionStorage.removeItem(TOKEN_SESSION);
    if (token) {
      fetch('/.netlify/functions/dashboard-logout', {
        method: 'POST',
        headers: { 'x-session-token': token },
      }).catch(() => {});
    }
    location.reload();
  });

  const tokenGuardado = sessionStorage.getItem(TOKEN_SESSION);
  if (tokenGuardado) entrarConToken(tokenGuardado, { silencioso: true });

  // ---------- Utilidades de datos ----------

  function mesesOrdenados(porMes: Record<string, any>): string[] {
    return Object.keys(porMes || {}).sort();
  }

  function nombreMesCorto(clave: string): string {
    const [anio, mes] = clave.split('-').map(Number);
    return new Date(anio, mes - 1, 1).toLocaleDateString('es-MX', { month: 'short', year: '2-digit' });
  }

  function fechaAccionesFormateada(): string | null {
    if (!accionesRegistradasDesde) return null;
    const fecha = new Date(accionesRegistradasDesde);
    if (Number.isNaN(fecha.getTime())) return null;
    return new Intl.DateTimeFormat('es-MX', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'America/Mexico_City',
    }).format(fecha).replace('.', '');
  }

  function notaMedicionAcciones(): string {
    const fecha = fechaAccionesFormateada();
    return fecha
      ? `Las acciones se registran desde el <strong>${fecha}</strong>. Antes de esa fecha, la ausencia de datos no significa cero.`
      : 'Aún no hay acciones registradas; la fecha aparecerá con la primera acción.';
  }

  function detalleEncabezadoAcciones(): string {
    const fecha = fechaAccionesFormateada();
    return fecha ? `desde ${fecha}` : 'sin registros aún';
  }

  function combinarCampo(porMes: Record<string, any>, campo: string): Record<string, number> {
    const combinado: Record<string, number> = {};
    Object.values(porMes || {}).forEach((mes: any) => {
      Object.entries(mes[campo] || {}).forEach(([clave, valor]) => {
        combinado[clave] = (combinado[clave] || 0) + (valor as number);
      });
    });
    return combinado;
  }

  function obtenerNegocio(slug: string): DatosNegocio | undefined {
    return negociosData.find((n) => n.slug === slug);
  }

  function claveMesActual(): string {
    return new Date().toISOString().slice(0, 7);
  }

  // ---------- Tasa de conversión ----------
  // "—" en vez de "0%" cuando no hay vistas — dividir 0/0 daría NaN, y
  // mostrar "0%" se leería como "convierte pésimo" cuando en realidad es
  // "todavía no hay datos", dos cosas muy distintas.
  function formatearConversion(clics: number, vistas: number): string {
    if (!vistas) return '—';
    return `${((clics / vistas) * 100).toFixed(1)}%`;
  }

  function valorConversion(clics: number, vistas: number): number {
    return vistas > 0 ? (clics / vistas) * 100 : -1; // -1 ordena "—" al final
  }

  // Semáforo relativo al promedio del propio conjunto de negocios, no a un
  // número fijo — "buena conversión" depende de cómo le está yendo al
  // resto del catálogo ese mes, no de un umbral arbitrario. Solo se
  // calcula sobre negocios con al menos MINIMO_VISTAS_CONFIABLE vistas:
  // con pocas vistas el % es puro ruido (2 vistas y 1 clic = 50%, no
  // significa nada) y contaminaría el promedio si se incluyera.
  const MINIMO_VISTAS_CONFIABLE = 20;

  function promedioConversionConfiable(filas: { vistas: number; clics: number }[]): number | null {
    const confiables = filas.filter((f) => f.vistas >= MINIMO_VISTAS_CONFIABLE);
    if (confiables.length === 0) return null;
    const suma = confiables.reduce((acc, f) => acc + valorConversion(f.clics, f.vistas), 0);
    return suma / confiables.length;
  }

  function semaforoConversion(
    clics: number,
    vistas: number,
    promedio: number | null,
  ): { clase: string; titulo: string } {
    if (vistas < MINIMO_VISTAS_CONFIABLE) {
      return { clase: 'panel__semaforo--gris', titulo: 'Pocas vistas — el % todavía no es confiable' };
    }
    if (promedio === null) {
      return { clase: 'panel__semaforo--gris', titulo: 'Sin promedio de referencia todavía' };
    }
    const propio = valorConversion(clics, vistas);
    const diferencia = propio - promedio;
    if (diferencia >= 1) return { clase: 'panel__semaforo--verde', titulo: `Por encima del promedio (${promedio.toFixed(1)}%)` };
    if (diferencia <= -1) return { clase: 'panel__semaforo--rojo', titulo: `Muy por debajo del promedio (${promedio.toFixed(1)}%)` };
    return { clase: 'panel__semaforo--ambar', titulo: `Cerca del promedio (${promedio.toFixed(1)}%)` };
  }

  // ---------- Gráficas SVG simples ----------

  interface ItemGrafica {
    etiqueta: string;
    valor: number;
    valorSecundario?: number;
  }

  function graficaBarras(
    items: ItemGrafica[],
    opciones: { color?: string; colorSecundario?: string } = {},
  ): string {
    if (items.length === 0 || items.every((i) => i.valor === 0 && !i.valorSecundario)) {
      return '<p class="panel__vacio">Todavía no hay datos suficientes.</p>';
    }
    const color = opciones.color || '#0B6F7A';
    const colorSecundario = opciones.colorSecundario;
    const ancho = 640;
    const alto = 160;
    const margenInferior = 30;
    const margenSuperior = 18;
    const altoUtil = alto - margenInferior - margenSuperior;
    const conSecundario = colorSecundario !== undefined;
    const maximo = Math.max(1, ...items.map((i) => Math.max(i.valor, i.valorSecundario ?? 0)));
    const anchoGrupo = ancho / items.length;
    const anchoBarra = conSecundario ? anchoGrupo * 0.3 : anchoGrupo * 0.5;

    const barras = items
      .map((item, i) => {
        const xGrupo = i * anchoGrupo;
        const alturaPrincipal = (item.valor / maximo) * altoUtil;
        const yPrincipal = margenSuperior + (altoUtil - alturaPrincipal);
        const xPrincipal = conSecundario
          ? xGrupo + anchoGrupo * 0.15
          : xGrupo + (anchoGrupo - anchoBarra) / 2;

        let barraSecundaria = '';
        if (conSecundario) {
          const alturaSecundaria = ((item.valorSecundario ?? 0) / maximo) * altoUtil;
          const ySecundaria = margenSuperior + (altoUtil - alturaSecundaria);
          const xSecundaria = xGrupo + anchoGrupo * 0.55;
          barraSecundaria = `<rect x="${xSecundaria.toFixed(1)}" y="${ySecundaria.toFixed(1)}" width="${anchoBarra.toFixed(1)}" height="${Math.max(0, alturaSecundaria).toFixed(1)}" fill="${colorSecundario}" rx="2"/>`;
        }

        return `
          <rect x="${xPrincipal.toFixed(1)}" y="${yPrincipal.toFixed(1)}" width="${anchoBarra.toFixed(1)}" height="${Math.max(0, alturaPrincipal).toFixed(1)}" fill="${color}" rx="2"/>
          ${barraSecundaria}
          <text x="${(xGrupo + anchoGrupo / 2).toFixed(1)}" y="${alto - 8}" text-anchor="middle" font-size="11" fill="#4a5a60">${item.etiqueta}</text>
        `;
      })
      .join('');

    return `<svg viewBox="0 0 ${ancho} ${alto}" width="100%" style="max-width:${ancho}px">${barras}</svg>`;
  }

  // ---------- Renderizado ----------

  function poblarSelectorNegocios() {
    el.selectorNegocio.innerHTML = negociosData
      .map((n) => `<option value="${n.slug}">${n.nombre}</option>`)
      .join('');
  }

  el.selectorNegocio.addEventListener('change', () => {
    renderizarVistaIndividual(el.selectorNegocio.value);
  });

  function tarjetaStat(etiqueta: string, valor: string | number, color: string): string {
    return `
      <div class="panel__tarjeta" style="border-top-color:${color}">
        <p class="panel__tarjeta-valor">${valor}</p>
        <p class="panel__tarjeta-etiqueta">${etiqueta}</p>
      </div>
    `;
  }

  function renderizarVistaIndividual(slug: string) {
    const negocio = obtenerNegocio(slug);
    if (!negocio) return;
    const { stats } = negocio;
    const meses = mesesOrdenados(stats.porMes);
    const mesActualClave = claveMesActual();
    const datosMesActual = stats.porMes[mesActualClave] || {
      vistas: 0,
      clics: 0,
      canales: {},
      dispositivos: {},
    };

    const conversionGeneral = formatearConversion(stats.clicsTotal, stats.vistasTotal);

    const graficaMensual = graficaBarras(
      meses.map((clave) => ({
        etiqueta: nombreMesCorto(clave),
        valor: stats.porMes[clave].vistas || 0,
        valorSecundario: stats.porMes[clave].clics || 0,
      })),
      { color: '#0B6F7A', colorSecundario: '#FF7A5C' },
    );

    const graficaAccionesMensual = graficaBarras(
      meses.map((clave) => ({
        etiqueta: nombreMesCorto(clave),
        valor: stats.porMes[clave].comoLlegar || 0,
        valorSecundario: stats.porMes[clave].compartir || 0,
      })),
      { color: '#7A5CFF', colorSecundario: '#D29A2D' },
    );

    const horaCombinada = combinarCampo(stats.porMes, 'hora');
    const graficaHora = graficaBarras(
      Array.from({ length: 24 }, (_, h) => ({
        etiqueta: String(h),
        valor: horaCombinada[String(h)] || 0,
      })),
      { color: '#4FD2C8' },
    );

    const diaCombinado = combinarCampo(stats.porMes, 'diaSemana');
    const graficaDia = graficaBarras(
      ORDEN_DIAS.map((d) => ({ etiqueta: d.slice(0, 3), valor: diaCombinado[d] || 0 })),
      { color: '#4FD2C8' },
    );

    const estadosCombinados = combinarCampo(stats.porMes, 'estados');
    const filasEstados =
      Object.entries(estadosCombinados)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 8)
        .map(([lugar, cantidad]) => `<tr><td>${lugar}</td><td>${cantidad}</td></tr>`)
        .join('') || '<tr><td colspan="2">Sin datos todavía</td></tr>';

    const canales = datosMesActual.canales || {};
    const filasCanales =
      Object.entries(canales)
        .map(([canal, valores]: [string, any]) => {
          const conv = formatearConversion(valores.clics, valores.vistas);
          return `<tr><td>${NOMBRES_CANAL[canal] || canal}</td><td>${valores.vistas}</td><td>${valores.clics}</td><td>${conv}</td></tr>`;
        })
        .join('') || '<tr><td colspan="4">Sin datos todavía</td></tr>';

    const movil = datosMesActual.dispositivos?.movil ?? 0;
    const escritorio = datosMesActual.dispositivos?.escritorio ?? 0;
    const totalDisp = movil + escritorio;
    const pctMovil = totalDisp > 0 ? Math.round((movil / totalDisp) * 100) : 0;

    const recomendacionesHtml =
      negocio.recomendaciones.length > 0
        ? `<ul class="panel__recomendaciones">${negocio.recomendaciones.map((r) => `<li>${r}</li>`).join('')}</ul>`
        : '<p>Ficha completa — no hay recomendaciones pendientes.</p>';

    el.contenidoIndividual.innerHTML = `
      <h2 class="panel__nombre-negocio">${negocio.nombre}</h2>
      <div class="panel__plan-estado">
        <span>Plan actual: <strong>${negocio.plan === 'pago' ? 'Pago (destacado)' : 'Gratuito'}</strong></span>
        <button
          type="button"
          class="boton boton--chico ${negocio.plan === 'pago' ? 'boton--secundario' : 'boton--destacado'}"
          id="boton-cambiar-plan"
        >
          ${negocio.plan === 'pago' ? 'Bajar a plan gratuito' : 'Cambiar a plan de pago'}
        </button>
        <span id="mensaje-plan" class="panel__plan-mensaje" hidden></span>
      </div>
      <div class="panel__tarjetas">
        ${tarjetaStat('Vistas totales', stats.vistasTotal, '#0B6F7A')}
        ${tarjetaStat('Clics a WhatsApp', stats.clicsTotal, '#FF7A5C')}
        ${tarjetaStat('Acciones para llegar', stats.comoLlegarTotal ?? 0, '#7A5CFF')}
        ${tarjetaStat('Acciones de compartir', stats.compartirTotal ?? 0, '#D29A2D')}
        ${tarjetaStat('Tasa de conversión', conversionGeneral, '#4FD2C8')}
        ${tarjetaStat('Puntaje de completitud', negocio.puntaje + '/100', '#0C2B2E')}
      </div>

      <div class="panel__seccion">
        <h3>Vistas y clics por mes</h3>
        <div class="panel__leyenda">
          <span><span class="punto" style="background:#0B6F7A"></span>Vistas</span>
          <span><span class="punto" style="background:#FF7A5C"></span>Clics</span>
        </div>
        ${graficaMensual}
      </div>

      <div class="panel__seccion">
        <h3>Acciones de alta intención por mes</h3>
        <p class="panel__nota-medicion">${notaMedicionAcciones()}</p>
        <div class="panel__leyenda">
          <span><span class="punto" style="background:#7A5CFF"></span>Acciones para llegar</span>
          <span><span class="punto" style="background:#D29A2D"></span>Acciones de compartir</span>
        </div>
        ${graficaAccionesMensual}
      </div>

      <div class="panel__fila-2">
        <div class="panel__seccion">
          <h3>Tráfico por hora del día</h3>
          ${graficaHora}
        </div>
        <div class="panel__seccion">
          <h3>Tráfico por día de la semana</h3>
          ${graficaDia}
        </div>
      </div>

      <div class="panel__fila-2">
        <div class="panel__seccion">
          <h3>Canal de origen (mes actual)</h3>
          <table class="panel__tabla">
            <thead><tr><th>Canal</th><th>Vistas</th><th>Clics</th><th>Conversión</th></tr></thead>
            <tbody>${filasCanales}</tbody>
          </table>
        </div>
        <div class="panel__seccion">
          <h3>Origen geográfico</h3>
          <p style="font-size:0.88rem;color:#4a5a60;margin:0 0 0.75rem;">
            ${pctMovil}% desde celular · ${100 - pctMovil}% desde computadora (mes actual)
          </p>
          <table class="panel__tabla">
            <thead><tr><th>Ciudad / Estado</th><th>Vistas</th></tr></thead>
            <tbody>${filasEstados}</tbody>
          </table>
        </div>
      </div>

      <div class="panel__seccion">
        <h3>Cómo subir el puntaje</h3>
        ${recomendacionesHtml}
      </div>
    `;

    const botonPlan = document.getElementById('boton-cambiar-plan') as HTMLButtonElement | null;
    const mensajePlan = document.getElementById('mensaje-plan') as HTMLElement | null;
    botonPlan?.addEventListener('click', async () => {
      const nuevoPlan = negocio.plan === 'pago' ? 'gratuito' : 'pago';
      const confirmacion =
        nuevoPlan === 'pago'
          ? `¿Confirmar que "${negocio.nombre}" ya pagó y pasa a plan de pago (destacado)?`
          : `¿Bajar a "${negocio.nombre}" a plan gratuito? Perderá el destacado y, si tiene video, se le quitará.`;
      if (!window.confirm(confirmacion)) return;

      botonPlan.disabled = true;
      const resultado = await cambiarPlanNegocio(slug, nuevoPlan);

      if (!resultado.ok) {
        botonPlan.disabled = false;
        if (mensajePlan) {
          mensajePlan.hidden = false;
          mensajePlan.textContent = resultado.error;
          mensajePlan.classList.add('panel__plan-mensaje--error');
        }
        return;
      }

      // Re-renderizar reconstruye todo el bloque (incluido #mensaje-plan),
      // así que el mensaje de éxito se aplica DESPUÉS, sobre el elemento
      // nuevo — si se hiciera antes, el re-render lo borraría de inmediato.
      negocio.plan = nuevoPlan;
      negocio.destacado = nuevoPlan === 'pago';
      renderizarVistaIndividual(slug);
      renderizarVistaComparativa();

      const mensajeNuevo = document.getElementById('mensaje-plan');
      if (mensajeNuevo) {
        mensajeNuevo.hidden = false;
        mensajeNuevo.textContent = `Listo — "${negocio.nombre}" ahora está en plan ${nuevoPlan}.`;
      }
    });
  }

  async function cambiarPlanNegocio(
    slug: string,
    plan: 'gratuito' | 'pago',
  ): Promise<{ ok: true } | { ok: false; error: string }> {
    const token = sessionStorage.getItem(TOKEN_SESSION);
    if (!token) return { ok: false, error: 'Sesión vencida, vuelve a entrar.' };
    try {
      const respuesta = await fetch('/.netlify/functions/dashboard-cambiar-plan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-session-token': token },
        body: JSON.stringify({ slug, plan }),
      });
      const datos = await respuesta.json().catch(() => ({}));
      if (!respuesta.ok || !datos.ok) {
        return { ok: false, error: datos.error || 'No se pudo cambiar el plan.' };
      }
      return { ok: true };
    } catch {
      return { ok: false, error: 'No se pudo conectar. Intenta de nuevo.' };
    }
  }

  type CampoOrdenComparativa =
    | 'nombre'
    | 'vistas'
    | 'clics'
    | 'comoLlegar'
    | 'compartir'
    | 'conversion'
    | 'puntaje';
  // Puntaje descendente por default — es el orden que ya existía antes de
  // agregar la columna de conversión, no lo cambiamos para no sorprender
  // a quien ya está acostumbrado al panel. Clic en cualquier encabezado
  // cambia el criterio (mismo campo otra vez = invierte la dirección).
  let ordenComparativa: { campo: CampoOrdenComparativa; direccion: 'asc' | 'desc' } = {
    campo: 'puntaje',
    direccion: 'desc',
  };

  const ETIQUETAS_ORDEN_COMPARATIVA: Record<CampoOrdenComparativa, string> = {
    nombre: 'Negocio',
    vistas: 'Vistas',
    clics: 'Clics a WhatsApp',
    comoLlegar: 'Acciones para llegar',
    compartir: 'Acciones de compartir',
    conversion: 'Conversión',
    puntaje: 'Puntaje',
  };

  function renderizarVistaComparativa() {
    const mesClave = claveMesActual();
    const filasBase = negociosData.map((n) => {
      const datosMes = n.stats.porMes[mesClave] || { vistas: 0, clics: 0 };
      const vistas = datosMes.vistas || 0;
      const clics = datosMes.clics || 0;
      const accionesLlegar = datosMes.comoLlegar || 0;
      const accionesCompartir = datosMes.compartir || 0;
      return { negocio: n, vistas, clics, accionesLlegar, accionesCompartir };
    });

    const promedio = promedioConversionConfiable(filasBase);

    const filasOrdenadas = filasBase.slice().sort((a, b) => {
      const dir = ordenComparativa.direccion === 'asc' ? 1 : -1;
      switch (ordenComparativa.campo) {
        case 'nombre':
          return a.negocio.nombre.localeCompare(b.negocio.nombre) * dir;
        case 'vistas':
          return (a.vistas - b.vistas) * dir;
        case 'clics':
          return (a.clics - b.clics) * dir;
        case 'comoLlegar':
          return (a.accionesLlegar - b.accionesLlegar) * dir;
        case 'compartir':
          return (a.accionesCompartir - b.accionesCompartir) * dir;
        case 'conversion':
          return (valorConversion(a.clics, a.vistas) - valorConversion(b.clics, b.vistas)) * dir;
        case 'puntaje':
        default:
          return (a.negocio.puntaje - b.negocio.puntaje) * dir;
      }
    });

    const filas = filasOrdenadas
      .map(({ negocio: n, vistas, clics, accionesLlegar, accionesCompartir }) => {
        const semaforo = semaforoConversion(clics, vistas, promedio);
        const conv = formatearConversion(clics, vistas);
        const notaPocasVistas = vistas < MINIMO_VISTAS_CONFIABLE && vistas > 0 ? ' <small>(pocas vistas)</small>' : '';
        return `
          <tr>
            <td>${n.nombre}${n.destacado ? '<span class="panel__mini-badge">Destacado</span>' : ''}</td>
            <td>${vistas}</td>
            <td>${clics}</td>
            <td>${accionesLlegar}</td>
            <td>${accionesCompartir}</td>
            <td>
              <span class="panel__semaforo ${semaforo.clase}" title="${semaforo.titulo}"></span>${conv}${notaPocasVistas}
            </td>
            <td>${n.puntaje}/100</td>
          </tr>
        `;
      })
      .join('');

    const encabezadoOrdenable = (campo: CampoOrdenComparativa, detalle = '') => {
      const activo = ordenComparativa.campo === campo;
      const flecha = activo ? (ordenComparativa.direccion === 'asc' ? ' ▲' : ' ▼') : '';
      return `<th><button type="button" class="panel__th-orden" data-campo="${campo}">${ETIQUETAS_ORDEN_COMPARATIVA[campo]}${flecha}${detalle}</button></th>`;
    };
    const encabezados = [
      encabezadoOrdenable('nombre'),
      encabezadoOrdenable('vistas'),
      encabezadoOrdenable('clics'),
      encabezadoOrdenable('comoLlegar', `<br><small>${detalleEncabezadoAcciones()}</small>`),
      encabezadoOrdenable('compartir', `<br><small>${detalleEncabezadoAcciones()}</small>`),
      encabezadoOrdenable('conversion'),
      encabezadoOrdenable('puntaje'),
    ].join('');

    const notaPromedio =
      promedio === null
        ? ''
        : `<p class="panel__nota-promedio">Promedio de conversión (negocios con ${MINIMO_VISTAS_CONFIABLE}+ vistas este mes): <strong>${promedio.toFixed(1)}%</strong></p>`;

    el.contenidoComparativa.innerHTML = `
      <div class="panel__seccion">
        <h3>Todos los negocios — mes actual</h3>
        ${notaPromedio}
        <p class="panel__nota-medicion">${notaMedicionAcciones()}</p>
        <table class="panel__tabla">
          <thead><tr>${encabezados}</tr></thead>
          <tbody>${filas}</tbody>
        </table>
      </div>
      ${htmlSeccionBusquedas()}
    `;

    el.contenidoComparativa.querySelectorAll<HTMLButtonElement>('.panel__th-orden').forEach((boton) => {
      boton.addEventListener('click', () => {
        const campo = boton.dataset.campo as CampoOrdenComparativa;
        ordenComparativa =
          ordenComparativa.campo === campo
            ? { campo, direccion: ordenComparativa.direccion === 'asc' ? 'desc' : 'asc' }
            : { campo, direccion: 'desc' };
        renderizarVistaComparativa();
      });
    });
  }

  // ---------- Qué busca la gente ----------
  // sinResultado es la parte que más importa: dice qué inventario le
  // falta al directorio (alguien buscó "alberca" y no encontró nada, por
  // ejemplo) — es información directa de qué negocio ir a buscar/dar de
  // alta después.
  const LIMITE_TERMINOS_MOSTRADOS = 15;

  // Los términos vienen de lo que escribe cualquier visitante en el
  // buscador público — a diferencia del nombre de un negocio (contenido
  // ya curado por nosotros), esto es entrada externa sin filtrar. Sin
  // escapar, alguien podría meter HTML/JS en el buscador y que se
  // ejecute aquí, en el navegador del admin.
  function escaparHtml(texto: string): string {
    return texto.replace(
      /[&<>"']/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );
  }

  function listaTerminosHtml(conteos: Record<string, number>): string {
    const entradas = Object.entries(conteos).sort((a, b) => b[1] - a[1]).slice(0, LIMITE_TERMINOS_MOSTRADOS);
    if (entradas.length === 0) return '<p class="panel__vacio">Todavía no hay búsquedas registradas este mes.</p>';
    const filas = entradas
      .map(([termino, veces]) => `<tr><td>${escaparHtml(termino)}</td><td>${veces}</td></tr>`)
      .join('');
    return `
      <table class="panel__tabla">
        <thead><tr><th>Término</th><th>Veces</th></tr></thead>
        <tbody>${filas}</tbody>
      </table>
    `;
  }

  function htmlSeccionBusquedas(): string {
    const mesClave = claveMesActual();
    const datosMes = busquedasPorMes[mesClave] || { terminos: {}, sinResultado: {} };
    return `
      <div class="panel__fila-2">
        <div class="panel__seccion">
          <h3>Qué busca la gente — mes actual</h3>
          ${listaTerminosHtml(datosMes.terminos)}
        </div>
        <div class="panel__seccion">
          <h3>Búsquedas sin resultado</h3>
          <p style="font-size:0.82rem;color:var(--color-texto-suave);margin:-0.25rem 0 0.75rem;">
            Lo que la gente busca y no encuentra — pistas de qué negocio dar de alta.
          </p>
          ${listaTerminosHtml(datosMes.sinResultado)}
        </div>
      </div>
    `;
  }

  // ---------- Bot: gasto/tokens y alertas ----------

  // Precio por millón de tokens, en dólares. VERIFICAR contra
  // console.anthropic.com antes de fiarse del total: Anthropic puede cambiar
  // precios y estos números se quedarían viejos sin avisar. Por eso el panel
  // muestra los TOKENS como dato duro (esos sí los reporta la API) y el costo
  // siempre etiquetado como estimado. Un modelo que no esté en esta tabla se
  // muestra con sus tokens y con el costo en "—", nunca con un cero engañoso.
  const PRECIO_POR_MILLON: Record<string, { entrada: number; salida: number }> = {
    'claude-sonnet-5': { entrada: 3, salida: 15 },
    'claude-haiku-4-5-20251001': { entrada: 1, salida: 5 },
  };

  function costoEstimado(modelo: string, uso: UsoModelo): number | null {
    const precio = PRECIO_POR_MILLON[modelo];
    if (!precio) return null;
    return (uso.entrada / 1_000_000) * precio.entrada + (uso.salida / 1_000_000) * precio.salida;
  }

  function formatearDolares(valor: number): string {
    return `$${valor.toFixed(2)} USD`;
  }

  function formatearNumero(valor: number): string {
    return valor.toLocaleString('es-MX');
  }

  function htmlUsoDeBot(bot: BotUso): string {
    if (!bot.reportando) {
      return `
        <div class="panel__seccion">
          <h3>${escaparHtml(bot.nombre)}</h3>
          <p class="panel__vacio">Todavía no reporta consumo.</p>
        </div>
      `;
    }

    const meses = Object.keys(bot.porMes).sort().reverse();
    let totalEstimado = 0;
    let hayModeloSinPrecio = false;

    const filas = meses
      .flatMap((mes) => {
        const porModelo = bot.porMes[mes] || {};
        return Object.entries(porModelo).map(([modelo, uso]) => {
          const costo = costoEstimado(modelo, uso);
          if (costo === null) hayModeloSinPrecio = true;
          else totalEstimado += costo;
          return `
            <tr>
              <td>${nombreMesCorto(mes)}</td>
              <td>${escaparHtml(modelo)}</td>
              <td>${formatearNumero(uso.mensajes || 0)}</td>
              <td>${formatearNumero(uso.entrada || 0)}</td>
              <td>${formatearNumero(uso.salida || 0)}</td>
              <td>${costo === null ? '—' : formatearDolares(costo)}</td>
            </tr>
          `;
        });
      })
      .join('');

    const avisoSinPrecio = hayModeloSinPrecio
      ? '<p class="panel__vacio">Hay un modelo sin precio en la tabla del código — su costo aparece como “—”.</p>'
      : '';

    return `
      <div class="panel__seccion">
        <h3>${escaparHtml(bot.nombre)}</h3>
        <p class="panel__nota-promedio">
          Costo estimado acumulado: <strong>${formatearDolares(totalEstimado)}</strong>
          — los tokens son dato real de la API; el costo es un cálculo con los
          precios guardados en el código, verifícalo en tu consola de Anthropic.
        </p>
        <table class="panel__tabla">
          <thead>
            <tr>
              <th>Mes</th><th>Modelo</th><th>Mensajes</th>
              <th>Tokens entrada</th><th>Tokens salida</th><th>Costo estimado</th>
            </tr>
          </thead>
          <tbody>${filas}</tbody>
        </table>
        ${avisoSinPrecio}
      </div>
    `;
  }

  // Un pico de eventos desde una misma IP es la señal de abuso que importa:
  // un visitante normal no dispara el registro de sospechosos repetidas veces.
  const EVENTOS_PARA_SOSPECHA = 3;

  function htmlAlertasBot(): string {
    if (eventosBot.length === 0) {
      const mensaje = botConsultado
        ? 'Sin eventos sospechosos registrados.'
        : 'No se pudo consultar el registro de alertas — esto NO significa que no haya habido intentos.';
      return `
        <div class="panel__seccion">
          <h3>Alertas de tráfico del bot</h3>
          <p class="panel__vacio">${mensaje}</p>
        </div>
      `;
    }

    const porIp = new Map<string, number>();
    eventosBot.forEach((e) => porIp.set(e.ip, (porIp.get(e.ip) || 0) + 1));
    const sospechosas = [...porIp.entries()]
      .filter(([, veces]) => veces >= EVENTOS_PARA_SOSPECHA)
      .sort((a, b) => b[1] - a[1]);

    const resumen = sospechosas.length
      ? `
        <p class="panel__nota-promedio">
          <strong>${sospechosas.length}</strong> IP(s) con ${EVENTOS_PARA_SOSPECHA} o más eventos:
          ${sospechosas.map(([ip, veces]) => `${escaparHtml(ip)} (${veces})`).join(' · ')}
        </p>
      `
      : '<p class="panel__nota-promedio">Ninguna IP acumula suficientes eventos para considerarse un pico.</p>';

    // El bot solo conserva los últimos 50 eventos (ver bot-teco.mjs), así que
    // esta lista es un vistazo reciente, no un historial completo.
    const filas = eventosBot
      .slice()
      .reverse()
      .map(
        (e) => `
          <tr>
            <td>${escaparHtml(e.ts || '')}</td>
            <td>${escaparHtml(e.motivo || '')}</td>
            <td>${escaparHtml(e.ip || '')}</td>
            <td>${escaparHtml(e.extra || '')}</td>
          </tr>
        `,
      )
      .join('');

    return `
      <div class="panel__seccion">
        <h3>Alertas de tráfico del bot</h3>
        ${resumen}
        <table class="panel__tabla">
          <thead><tr><th>Cuándo</th><th>Motivo</th><th>IP</th><th>Detalle</th></tr></thead>
          <tbody>${filas}</tbody>
        </table>
        <p class="panel__vacio">Se guardan los últimos 50 eventos.</p>
      </div>
    `;
  }

  // ---------- Gasto real (Admin API de Anthropic) ----------
  // Va ARRIBA del uso estimado a propósito: este es el número que Anthropic
  // factura de verdad. El de abajo es un cálculo con precios escritos a mano
  // y sirve para ver el detalle por mensaje, no para saber cuánto se paga.
  function htmlGastoReal(): string {
    if (!gastoReal) {
      return `
        <div class="panel__seccion">
          <h3>Gasto real en Anthropic</h3>
          <p class="panel__vacio">No se pudo consultar el gasto en este momento.</p>
        </div>
      `;
    }

    if (gastoReal.ok && gastoReal.configurado === false) {
      return `
        <div class="panel__seccion">
          <h3>Gasto real en Anthropic</h3>
          <p class="panel__vacio">
            Falta configurar la llave de administración. En Anthropic
            (Console → Settings → Admin keys) se genera una llave de tipo
            <code>sk-ant-admin...</code> y se guarda en Netlify como variable
            de entorno <code>ANTHROPIC_ADMIN_KEY</code>. Es distinta de la
            llave del bot y da acceso a los datos de facturación de toda la
            cuenta, así que solo se ve desde aquí.
          </p>
        </div>
      `;
    }

    if (!gastoReal.ok) {
      const mensaje =
        gastoReal.error === 'llave-admin-invalida'
          ? 'La llave de administración no es válida o fue revocada. Hay que generar una nueva en Anthropic y actualizarla en Netlify.'
          : 'No se pudo consultar el gasto en Anthropic.';
      return `
        <div class="panel__seccion">
          <h3>Gasto real en Anthropic</h3>
          <p class="panel__vacio">${mensaje}</p>
        </div>
      `;
    }

    const conceptos = Object.entries(gastoReal.porConcepto || {})
      .sort((a, b) => b[1] - a[1])
      .map(
        ([concepto, usd]) =>
          `<tr><td>${escaparHtml(concepto)}</td><td>${formatearDolares(usd)}</td></tr>`,
      )
      .join('');

    const llaves = (gastoReal.porLlave || [])
      .map(
        (k) => `
          <tr>
            <td>${escaparHtml(k.nombre)}</td>
            <td>${formatearNumero(k.entrada)}</td>
            <td>${formatearNumero(k.salida)}</td>
          </tr>
        `,
      )
      .join('');

    const avisoIncompleto =
      gastoReal.completo === false
        ? '<p class="panel__vacio">El periodo trae más datos de los que caben en una consulta: el total mostrado puede quedarse corto.</p>'
        : '';

    return `
      <div class="panel__seccion">
        <h3>Gasto real en Anthropic — mes en curso</h3>
        <p class="panel__nota-promedio">
          Total facturado: <strong>${formatearDolares(gastoReal.totalUsd || 0)}</strong>
          — este sí es el dato de Anthropic, no un estimado.
        </p>
        <table class="panel__tabla">
          <thead><tr><th>Concepto</th><th>Costo</th></tr></thead>
          <tbody>${conceptos || '<tr><td colspan="2">Sin consumo este mes.</td></tr>'}</tbody>
        </table>
        ${avisoIncompleto}
      </div>

      <div class="panel__seccion">
        <h3>Consumo por llave (cada bot usa la suya)</h3>
        <table class="panel__tabla">
          <thead><tr><th>Llave</th><th>Tokens entrada</th><th>Tokens salida</th></tr></thead>
          <tbody>${llaves || '<tr><td colspan="3">Sin consumo este mes.</td></tr>'}</tbody>
        </table>
        <p class="panel__vacio">
          Aquí aparece también el bot de Xanath, aunque viva fuera de este sitio:
          basta con que use su propia llave de la misma cuenta de Anthropic.
        </p>
      </div>
    `;
  }

  function renderizarVistaBot() {
    const usos = botsUso.length
      ? botsUso.map(htmlUsoDeBot).join('')
      : '<div class="panel__seccion"><p class="panel__vacio">No se pudieron cargar los datos del bot.</p></div>';
    el.contenidoBot.innerHTML = `${htmlGastoReal()}${usos}${htmlAlertasBot()}`;
  }

  // ---------- Tabs ----------

  el.tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      el.tabs.forEach((t) => t.setAttribute('aria-pressed', 'false'));
      tab.setAttribute('aria-pressed', 'true');
      const vista = tab.dataset.vista;
      el.vistaIndividual.hidden = vista !== 'individual';
      el.vistaComparativa.hidden = vista !== 'comparativa';
      el.vistaBot.hidden = vista !== 'bot';
    });
  });

  // ---------- Exportación a PDF ----------

  function plantillaEncabezadoPdf(subtitulo: string): string {
    return `
      <div style="display:flex;align-items:center;gap:12px;border-bottom:4px solid #0B6F7A;padding-bottom:16px;margin-bottom:24px;">
        <svg width="48" height="48" viewBox="0 0 100 100">
          <rect x="4" y="4" width="92" height="92" rx="22" fill="#0B6F7A"></rect>
          <mask id="pdf-ola-encabezado">
            <rect width="100" height="100" fill="#fff"></rect>
            <path d="M14,36 Q26,24 38,36 Q50,48 62,36 Q74,24 86,36 L86,46 Q74,58 62,46 Q50,34 38,46 Q26,58 14,46 Z" fill="#000"></path>
          </mask>
          <path d="M50,10 C67,10 80,24 80,42 C80,55 71,68 59,82 C55,86.5 51,90 50,93 C49,90 45,86.5 41,82 C29,68 20,55 20,42 C20,24 33,10 50,10 Z" fill="#FF7A5C" mask="url(#pdf-ola-encabezado)"></path>
        </svg>
        <div>
          <p style="font-family:'Nunito',sans-serif;font-weight:900;font-size:22px;margin:0;color:#0C2B2E;">
            Tecolutla<span style="color:#FF7A5C;">Travel</span>
          </p>
          <p style="font-family:'Work Sans',sans-serif;font-size:13px;color:#4a5a60;margin:2px 0 0;">
            ${subtitulo}
          </p>
        </div>
      </div>
    `;
  }

  async function exportarPdf(html: string, nombreArchivo: string) {
    el.reportePdf.innerHTML = html;
    await new Promise((r) => setTimeout(r, 80));

    const canvas = await html2canvas(el.reportePdf, {
      scale: 2,
      backgroundColor: '#ffffff',
      windowWidth: 800,
    });
    const imagenUrl = canvas.toDataURL('image/png');

    const pdf = new jsPDF({ unit: 'px', format: [canvas.width, canvas.height] });
    pdf.addImage(imagenUrl, 'PNG', 0, 0, canvas.width, canvas.height);
    pdf.save(nombreArchivo);

    el.reportePdf.innerHTML = '';
  }

  async function exportarIndividual() {
    const slug = el.selectorNegocio.value;
    const negocio = obtenerNegocio(slug);
    if (!negocio) return;
    const fecha = new Date().toLocaleDateString('es-MX', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    const html = `
      <div style="width:760px;padding:32px;background:#fff;font-family:'Work Sans',sans-serif;color:#0C2B2E;">
        ${plantillaEncabezadoPdf(`Reporte de resultados de ${negocio.nombre} — ${fecha}`)}
        ${el.contenidoIndividual.innerHTML}
      </div>
    `;
    await exportarPdf(html, `resultados-${slug}-${fecha.replace(/\s/g, '-')}.pdf`);
  }

  async function exportarComparativa() {
    const fecha = new Date().toLocaleDateString('es-MX', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    const html = `
      <div style="width:760px;padding:32px;background:#fff;font-family:'Work Sans',sans-serif;color:#0C2B2E;">
        ${plantillaEncabezadoPdf(`Comparativa de negocios — ${fecha}`)}
        ${el.contenidoComparativa.innerHTML}
      </div>
    `;
    await exportarPdf(html, `comparativa-negocios-${fecha.replace(/\s/g, '-')}.pdf`);
  }

  el.botonPdfIndividual.addEventListener('click', exportarIndividual);
  el.botonPdfComparativa.addEventListener('click', exportarComparativa);
</script>
