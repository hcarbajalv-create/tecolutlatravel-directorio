---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';

export async function getStaticPaths() {
  const negocios = await getCollection('negocios');
  return negocios.map((negocio) => ({
    params: { categoria: negocio.data.categoria, negocio: negocio.id },
    props: { negocio },
  }));
}

const { negocio } = Astro.props;
const {
  nombre,
  categoria,
  descripcionCorta,
  direccion,
  coordenadas,
  telefono,
  facebook,
  messenger,
  logo,
  fotos,
  precioTemporada,
  fechaActualizacion,
  servicios,
  numeroHabitaciones,
  capacidadMaxima,
  petFriendly,
  distanciaPlayaMetros,
  checkIn,
  checkOut,
  verificado,
  resenas,
  destacado,
  video,
} = negocio.data;

// Cada categoría reserva algo distinto (una habitación, un lugar en la
// lancha, una mesa) — el bloque "Reserva" de la ficha se adapta con esta
// configuración en vez de repetir ternarios por categoría en cada punto
// donde se usa. "servicios" no tiene un caso de uso claro de fecha/personas
// todavía, así que usa el mismo texto genérico que hospedaje mientras no
// se dé de alta el primer negocio de esa categoría y se sepa qué necesita.
const configReserva = {
  hospedaje: {
    etiquetaPersonas: 'huéspedes',
    etiquetaPersonaSingular: 'huésped',
    etiquetaFecha: 'Entrada',
    mostrarSalida: true,
    loQueSeReserva: 'su hospedaje',
  },
  actividades: {
    etiquetaPersonas: 'pasajeros',
    etiquetaPersonaSingular: 'pasajero',
    etiquetaFecha: 'Fecha del paseo',
    mostrarSalida: false,
    loQueSeReserva: 'su recorrido',
  },
  gastronomia: {
    etiquetaPersonas: 'comensales',
    etiquetaPersonaSingular: 'comensal',
    etiquetaFecha: 'Fecha de tu reservación',
    mostrarSalida: false,
    loQueSeReserva: 'una mesa',
  },
  servicios: {
    etiquetaPersonas: 'personas',
    etiquetaPersonaSingular: 'persona',
    etiquetaFecha: 'Entrada',
    mostrarSalida: true,
    loQueSeReserva: 'su hospedaje',
  },
}[categoria];

const { etiquetaPersonas, etiquetaPersonaSingular, etiquetaFecha, mostrarSalida, loQueSeReserva } =
  configReserva;

const telefonoDigitos = telefono.replace(/[^\d]/g, '');
// wa.me exige "52 1" antes del número móvil mexicano de 10 dígitos,
// aunque México ya no lo pida para llamadas normales desde el propio teléfono.
// Si el teléfono ya trae otro código de país (ej. "+1" de EUA/Canadá), se
// respeta tal cual — no se le antepone el prefijo mexicano.
const telefonoWhatsapp = telefono.trim().startsWith('+1')
  ? telefonoDigitos
  : `521${telefonoDigitos.replace(/^52/, '')}`;
// Mensaje genérico de respaldo (se usa si el visitante no elige fechas, o
// antes de que el script del cliente termine de correr). El mensaje real
// con fechas/saludo según hora del día se arma en el navegador — ver script
// al final del archivo — porque depende del momento exacto del clic.
const enlaceWhatsapp = `https://wa.me/${telefonoWhatsapp}?text=${encodeURIComponent(
  `Hola, vi ${nombre} en el directorio de Tecolutla y me gustaría más información.`,
)}`;
const enlaceComoLlegar = `https://www.google.com/maps/dir/?api=1&destination=${coordenadas.lat},${coordenadas.lng}`;
const urlFichaAbsoluta = new URL(`/${categoria}/${negocio.id}`, Astro.site).toString();
const mapaEmbed = `https://www.google.com/maps?q=${coordenadas.lat},${coordenadas.lng}&output=embed`;

// Versión más grande de cada foto para el lightbox (el thumbnail de la
// galería usa una versión chica; ampliar esa se vería pixelada).
const fotosGrandes = await Promise.all(
  fotos.map((foto) => getImage({ src: foto.src, width: 1000 })),
);

const fechaFormateada = new Intl.DateTimeFormat('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(fechaActualizacion);

const nombreCategoria: Record<string, string> = {
  hospedaje: 'Hospedaje',
  gastronomia: 'Gastronomía',
  actividades: 'Actividades ecoturísticas',
  servicios: 'Servicios',
};

const iconoCategoria: Record<string, string> = {
  hospedaje: '🏡',
  gastronomia: '🍤',
  actividades: '🛶',
  servicios: '🚲',
};

const claseColorCategoria: Record<string, string> = {
  hospedaje: 'tile--hospedaje',
  gastronomia: 'tile--gastronomia',
  actividades: 'tile--actividades',
  servicios: 'tile--servicios',
};

const calificacionPromedio =
  resenas.length > 0
    ? resenas.reduce((suma, r) => suma + r.calificacion, 0) / resenas.length
    : undefined;

const esquemaLodging =
  categoria === 'hospedaje'
    ? {
        '@context': 'https://schema.org',
        '@type': 'LodgingBusiness',
        name: nombre,
        description: descripcionCorta,
        telephone: telefono,
        address: {
          '@type': 'PostalAddress',
          streetAddress: direccion,
          addressLocality: 'Tecolutla',
          addressRegion: 'Veracruz',
          addressCountry: 'MX',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: coordenadas.lat,
          longitude: coordenadas.lng,
        },
        image: fotos.map((f) => f.src.src),
        amenityFeature: servicios.map((s) => ({
          '@type': 'LocationFeatureSpecification',
          name: s,
        })),
        ...(numeroHabitaciones
          ? { numberOfRooms: numeroHabitaciones }
          : {}),
        ...(petFriendly !== undefined ? { petsAllowed: petFriendly } : {}),
        ...(checkIn ? { checkinTime: checkIn } : {}),
        ...(checkOut ? { checkoutTime: checkOut } : {}),
        ...(calificacionPromedio
          ? {
              aggregateRating: {
                '@type': 'AggregateRating',
                ratingValue: calificacionPromedio.toFixed(1),
                reviewCount: resenas.length,
              },
            }
          : {}),
      }
    : null;
---

<BaseLayout
  titulo={`${nombre} — ${nombreCategoria[categoria]} en Tecolutla`}
  descripcion={descripcionCorta}
>
  {
    esquemaLodging && (
      <script type="application/ld+json" set:html={JSON.stringify(esquemaLodging)} />
    )
  }

  <section class={`cabecera-categoria ${claseColorCategoria[categoria]}`}>
    <div class="contenedor">
      <p><a href={`/${categoria}`} style="color: #fff;">&larr; Volver a {nombreCategoria[categoria]}</a></p>
      <div class="ficha__encabezado">
        {destacado && <span class="insignia insignia--destacado">Destacado</span>}
        {verificado && <span class="insignia insignia--verificado">Verificado</span>}
      </div>
      <div class="cabecera-categoria__titulo">
        <h1>{nombre}</h1>
        {logo ? (
          <Image src={logo} alt={`Logotipo de ${nombre}`} width={128} height={128} class="cabecera-categoria__logo" />
        ) : (
          <span class="cabecera-categoria__icono">{iconoCategoria[categoria]}</span>
        )}
      </div>
      <p>{descripcionCorta}</p>
    </div>
  </section>

  <section class="seccion contenedor">
    <div class="ficha__galeria">
      {
        fotos.map((foto, i) => (
          <button
            type="button"
            class="ficha__foto"
            style={`--giro: ${i % 2 === 0 ? '-2deg' : '2deg'}`}
            data-lightbox-abrir
            data-src={fotosGrandes[i].src}
            data-alt={foto.alt}
            aria-label={`Ampliar foto: ${foto.alt}`}
          >
            <Image src={foto.src} alt={foto.alt} loading="lazy" width={400} height={300} />
          </button>
        ))
      }
    </div>

    <div
      class="lightbox"
      id="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Foto ampliada"
      hidden
    >
      <button type="button" class="lightbox__cerrar" data-lightbox-cerrar aria-label="Cerrar foto ampliada">
        ✕
      </button>
      <img src="" alt="" class="lightbox__imagen" id="lightbox-imagen" />
    </div>

    {
      video && (
        <div class="ficha__seccion-video">
          <h2>Video</h2>
          <VideoEmbed url={video} titulo={nombre} />
        </div>
      )
    }

    <div class="ficha__datos">
      <div class="ficha__bloque ficha__bloque--contacto">
        <h2>Contacto y ubicación</h2>
        <p>{direccion}</p>
        <p>
          Teléfono: <a href={`tel:${telefonoDigitos}`}>{telefono}</a>
        </p>
        <div class="ficha__iconos-contacto">
          {facebook && (
            <a
              href={facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="ficha__icono-boton"
              aria-label={`Facebook de ${nombre}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
              </svg>
            </a>
          )}
          {messenger && (
            <a
              href={messenger}
              target="_blank"
              rel="noopener noreferrer"
              class="ficha__icono-boton"
              aria-label={`Messenger de ${nombre}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.02 2 11c0 2.85 1.44 5.4 3.7 7.06V22l3.4-1.87c.93.26 1.92.4 2.9.4 5.52 0 10-4.02 10-9S17.52 2 12 2zm1.02 12.13l-2.55-2.72-4.98 2.72 5.48-5.82 2.61 2.72 4.92-2.72-5.48 5.82z" />
              </svg>
            </a>
          )}
          <button
            type="button"
            class="ficha__icono-boton ficha__icono-boton--compartir"
            id="boton-compartir"
            aria-label={`Compartir la ficha de ${nombre}`}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7" />
              <polyline points="16 6 12 2 8 6" />
              <line x1="12" y1="2" x2="12" y2="15" />
            </svg>
            <span>Compartir</span>
          </button>
          <span id="estado-compartir" class="ficha__compartir-estado" role="status" aria-live="polite" />
        </div>
        <p class="ficha__fecha-actualizacion">Última actualización: {fechaFormateada}</p>
        {numeroHabitaciones && <p>Habitaciones: {numeroHabitaciones}</p>}
        {capacidadMaxima !== undefined && <p>Capacidad máxima: hasta {capacidadMaxima} personas</p>}
        {petFriendly !== undefined && (
          <p>Mascotas: {petFriendly ? 'Sí se aceptan' : 'No se aceptan'}</p>
        )}
        {distanciaPlayaMetros !== undefined && <p>Distancia a la playa: {distanciaPlayaMetros} metros</p>}
        <p><a class="boton boton--secundario" href={enlaceComoLlegar}>¿Cómo llegar?</a></p>
      </div>

      <div class="ficha__columna-precio-servicios">
        {
          (
            // Regla temporal a nivel de todo el sitio: no se muestra ningún
            // precio real todavía, exista o no el dato en el .yaml del
            // negocio. Quitar este comentario y volver a la condición de
            // precioTemporada cuando se levante la regla.
            <div class="ficha__bloque ficha__bloque--precio">
              <h2>Precio por temporada</h2>
              <p>Próximamente</p>
            </div>
          )
        }

        {
          servicios.length > 0 && (
            <div class="ficha__bloque ficha__bloque--servicios">
              <h2>Servicios y amenidades</h2>
              <ul class="ficha__amenidades">
                {servicios.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div class="ficha__bloque ficha__bloque--reserva">
          <h2>Reserva</h2>
          <div class="ficha__fechas">
            <div class="ficha__fechas-campo">
              <label for="fecha-entrada">{etiquetaFecha}</label>
              <input type="date" id="fecha-entrada" />
            </div>
            {mostrarSalida && (
              <div class="ficha__fechas-campo">
                <label for="fecha-salida">Salida</label>
                <input type="date" id="fecha-salida" />
              </div>
            )}
          </div>

          <div class="ficha__fechas-campo ficha__fechas-campo--huespedes">
            <label for="numero-huespedes">Número de {etiquetaPersonas}</label>
            <div class="ficha__contador">
              <button
                type="button"
                class="ficha__contador-boton"
                id="huespedes-menos"
                aria-label={`Restar un ${etiquetaPersonaSingular}`}
              >
                −
              </button>
              <input type="number" id="numero-huespedes" min="1" max="50" inputmode="numeric" placeholder="0" />
              <button
                type="button"
                class="ficha__contador-boton"
                id="huespedes-mas"
                aria-label={`Sumar un ${etiquetaPersonaSingular}`}
              >
                +
              </button>
            </div>
          </div>

          <p id="aviso-fechas" class="aviso-envio" role="alert" hidden>
            {mostrarSalida
              ? `⚠️ Elige tu fecha de entrada, salida y número de ${etiquetaPersonas} antes de escribir por WhatsApp.`
              : `⚠️ Elige tu fecha y número de ${etiquetaPersonas} antes de escribir por WhatsApp.`}
          </p>

          <p>
            <a class="boton boton--whatsapp" href={enlaceWhatsapp} id="enlace-whatsapp">
              Escribir por WhatsApp
            </a>
          </p>
          {facebook && (
            <p>
              <a class="boton boton--secundario" href={facebook} target="_blank" rel="noopener noreferrer">
                Facebook
              </a>
            </p>
          )}
          {messenger && (
            <p>
              <a class="boton boton--secundario" href={messenger} target="_blank" rel="noopener noreferrer">
                Messenger
              </a>
            </p>
          )}
        </div>
    </div>

    <div class="ficha__bloque ficha__bloque--mapa">
      <h2>Ubicación en el mapa</h2>
      <iframe
        class="mapa-embed"
        src={mapaEmbed}
        loading="lazy"
        title={`Mapa de ubicación de ${nombre}`}
      />
      <p class="ficha__mapa-boton">
        <a class="boton boton--secundario" href={enlaceComoLlegar} target="_blank" rel="noopener noreferrer">
          Abrir en Google Maps
        </a>
      </p>
    </div>

    <div class="ficha__bloque ficha__bloque--resenas" style="margin-top: 1.5rem;">
      <h2>Reseñas</h2>
      {
        resenas.length === 0 ? (
          <p>Este negocio todavía no tiene reseñas.</p>
        ) : (
          resenas.map((r) => (
            <div class="resena">
              <p class="resena__calificacion">
                {'★'.repeat(r.calificacion)}
                {'☆'.repeat(5 - r.calificacion)} — {r.autor}
              </p>
              <p>{r.comentario}</p>
            </div>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImagen = document.getElementById('lightbox-imagen') as HTMLImageElement;

  function abrirLightbox(src: string, alt: string) {
    lightboxImagen.src = src;
    lightboxImagen.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function cerrarLightbox() {
    lightbox.hidden = true;
    lightboxImagen.src = '';
    document.body.style.overflow = '';
  }

  // Precarga solo la foto grande que el usuario está a punto de abrir
  // (al pasar el mouse o tocarla), no las 8 de golpe — en celular con
  // datos limitados, precargar todas de una sería peor que no precargar nada.
  const yaPrecargadas = new Set<string>();
  function precargarUna(src: string | null) {
    if (!src || yaPrecargadas.has(src)) return;
    yaPrecargadas.add(src);
    const precarga = new Image();
    precarga.src = src;
  }

  document.querySelectorAll('[data-lightbox-abrir]').forEach((boton) => {
    const src = boton.getAttribute('data-src');
    boton.addEventListener('mouseenter', () => precargarUna(src));
    boton.addEventListener('touchstart', () => precargarUna(src), { passive: true });
    boton.addEventListener('click', () => {
      const alt = boton.getAttribute('data-alt') ?? '';
      abrirLightbox(src ?? '', alt);
    });
  });

  document.querySelector('[data-lightbox-cerrar]')?.addEventListener('click', cerrarLightbox);

  lightbox.addEventListener('click', (evento) => {
    if (evento.target === lightbox) cerrarLightbox();
  });

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && !lightbox.hidden) cerrarLightbox();
  });
</script>

<script
  define:vars={{
    nombreNegocio: nombre,
    urlFicha: urlFichaAbsoluta,
    numeroWhatsapp: telefonoWhatsapp,
    etiquetaPersonas,
    etiquetaLoQueSeReserva: loQueSeReserva,
  }}
>
  // Arma el mensaje de WhatsApp en el navegador (no en el build) porque el
  // saludo depende de la hora exacta en la que el visitante da clic, y las
  // fechas dependen de lo que elija en los campos de entrada/salida.
  const inputEntrada = document.getElementById('fecha-entrada');
  const inputSalida = document.getElementById('fecha-salida');
  const inputHuespedes = document.getElementById('numero-huespedes');
  const botonHuespedesMenos = document.getElementById('huespedes-menos');
  const botonHuespedesMas = document.getElementById('huespedes-mas');
  const enlaceWhatsappEl = document.getElementById('enlace-whatsapp');
  const avisoFechas = document.getElementById('aviso-fechas');

  function saludoSegunHora() {
    const hora = new Date().getHours();
    if (hora < 12) return 'Buenos días';
    if (hora < 19) return 'Buenas tardes';
    return 'Buenas noches';
  }

  function formatearFecha(valorInput) {
    // <input type="date"> entrega "YYYY-MM-DD"; se arma en horario local
    // para no perder un día por interpretación UTC.
    const [anio, mes, dia] = valorInput.split('-').map(Number);
    const fecha = new Date(anio, mes - 1, dia);
    return new Intl.DateTimeFormat('es-MX', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(fecha);
  }

  function actualizarEnlaceWhatsapp() {
    if (!enlaceWhatsappEl) return;
    let mensaje = `¡${saludoSegunHora()}, ${nombreNegocio}! Los encontré gracias a TecolutlaTravel ${urlFicha}.\n\n`;

    const valorEntrada = inputEntrada && inputEntrada.value;
    const valorSalida = inputSalida && inputSalida.value;
    const valorHuespedes = inputHuespedes && inputHuespedes.value;

    if (fechasValidas() && valorHuespedes) {
      mensaje += inputSalida
        ? `Me interesa consultar la disponibilidad de ${etiquetaLoQueSeReserva} y el costo para las siguientes fechas:\n\n` +
          `Fecha de entrada: ${formatearFecha(valorEntrada)}\n` +
          `Fecha de salida: ${formatearFecha(valorSalida)}\n` +
          `Número de ${etiquetaPersonas}: ${valorHuespedes}`
        : `Me interesa consultar la disponibilidad de ${etiquetaLoQueSeReserva} y el costo para la siguiente fecha:\n\n` +
          `Fecha: ${formatearFecha(valorEntrada)}\n` +
          `Número de ${etiquetaPersonas}: ${valorHuespedes}`;
    } else {
      mensaje += 'Me gustaría más información.';
    }

    enlaceWhatsappEl.setAttribute(
      'href',
      `https://wa.me/${numeroWhatsapp}?text=${encodeURIComponent(mensaje)}`,
    );
  }

  function fechasValidas() {
    const valorEntrada = inputEntrada && inputEntrada.value;
    // La ficha de actividades no tiene campo de salida — basta con la
    // fecha de entrada.
    if (!inputSalida) return Boolean(valorEntrada);
    const valorSalida = inputSalida.value;
    return Boolean(valorEntrada && valorSalida && valorSalida > valorEntrada);
  }

  function huespedesValidos() {
    const valor = inputHuespedes && Number(inputHuespedes.value);
    return Boolean(valor && valor >= 1 && valor <= 50);
  }

  function datosCompletos() {
    return fechasValidas() && huespedesValidos();
  }

  if (inputEntrada) {
    const hoyISO = new Date().toISOString().slice(0, 10);
    inputEntrada.min = hoyISO;
    if (inputSalida) inputSalida.min = hoyISO;

    inputEntrada.addEventListener('change', () => {
      if (inputSalida && inputEntrada.value) inputSalida.min = inputEntrada.value;
      if (avisoFechas && datosCompletos()) avisoFechas.hidden = true;
      actualizarEnlaceWhatsapp();
    });
    if (inputSalida) {
      inputSalida.addEventListener('change', () => {
        if (avisoFechas && datosCompletos()) avisoFechas.hidden = true;
        actualizarEnlaceWhatsapp();
      });
    }
  }

  if (inputHuespedes) {
    inputHuespedes.addEventListener('input', () => {
      if (avisoFechas && datosCompletos()) avisoFechas.hidden = true;
      actualizarEnlaceWhatsapp();
    });
    botonHuespedesMas?.addEventListener('click', () => {
      const actual = Number(inputHuespedes.value) || 0;
      inputHuespedes.value = String(Math.min(50, actual + 1));
      inputHuespedes.dispatchEvent(new Event('input', { bubbles: true }));
    });
    botonHuespedesMenos?.addEventListener('click', () => {
      const actual = Number(inputHuespedes.value) || 0;
      if (actual <= 1) return;
      inputHuespedes.value = String(actual - 1);
      inputHuespedes.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }

  // El botón de WhatsApp exige elegir fechas y número de huéspedes antes de
  // dejar pasar el clic — sin esto, se podía escribir sin completar nada.
  if (enlaceWhatsappEl && avisoFechas) {
    enlaceWhatsappEl.addEventListener('click', (evento) => {
      if (!datosCompletos()) {
        evento.preventDefault();
        avisoFechas.hidden = false;
        avisoFechas.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  actualizarEnlaceWhatsapp();

  // Botón "Compartir": usa la Web Share API nativa solo en celular. En
  // escritorio (sobre todo Windows) navigator.share SÍ existe pero abre el
  // panel nativo del sistema operativo, que casi nunca tiene a dónde
  // compartir ahí y muestra un error confuso ("Vuelve a intentarlo...") —
  // no es una falla de nuestro código, es una limitación del propio
  // Windows. En escritorio vamos directo al portapapeles, que sí funciona
  // siempre.
  const esMovilCompartir = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);
  const botonCompartir = document.getElementById('boton-compartir');
  const estadoCompartir = document.getElementById('estado-compartir');

  botonCompartir?.addEventListener('click', async () => {
    if (esMovilCompartir && navigator.share) {
      try {
        await navigator.share({ title: nombreNegocio, url: urlFicha });
      } catch {
        // El visitante cerró el diálogo de compartir sin elegir nada —
        // no es un error real, no hace falta avisar nada.
      }
      return;
    }

    try {
      await navigator.clipboard.writeText(urlFicha);
      if (estadoCompartir) {
        estadoCompartir.textContent = '¡Enlace copiado!';
        setTimeout(() => {
          estadoCompartir.textContent = '';
        }, 2500);
      }
    } catch {
      if (estadoCompartir) estadoCompartir.textContent = urlFicha;
    }
  });
</script>

<script define:vars={{ slugNegocio: negocio.id }}>
  // Captura pasiva de vistas y clics (sección 12.1): sin cookies ni datos
  // personales, solo conteo de eventos con fecha, negocio, canal de origen
  // (referrer) y tipo de dispositivo. Es "best effort" — si falla, no
  // interrumpe la navegación del visitante.
  function detectarCanal() {
    const referencia = document.referrer;
    if (!referencia) return 'directo';
    try {
      const host = new URL(referencia).hostname.replace(/^www\./, '');
      if (host.includes('google')) return 'google';
      if (host.includes('instagram')) return 'instagram';
      if (host.includes('facebook') || host === 'fb.com') return 'facebook';
      if (host.includes('tecolutlatravel.mx')) return 'interno';
      return 'otro';
    } catch {
      return 'otro';
    }
  }

  function detectarDispositivo() {
    return /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent) ? 'movil' : 'escritorio';
  }

  function registrarEvento(tipo) {
    fetch('/.netlify/functions/registrar-evento', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      keepalive: true,
      body: JSON.stringify({
        slug: slugNegocio,
        tipo,
        canal: detectarCanal(),
        dispositivo: detectarDispositivo(),
      }),
    }).catch(() => {
      // Sin bloquear al visitante si falla (red caída, función no disponible, etc.).
    });
  }

  registrarEvento('vista');
  document.querySelector('.boton--whatsapp')?.addEventListener('click', () => registrarEvento('clic'));
</script>
