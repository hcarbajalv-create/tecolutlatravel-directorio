---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from '../components/NegocioCard.astro';
import TarjetaCompacta from '../components/TarjetaCompacta.astro';
import Icono from '../components/Icono.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';
import { filtrarListables } from '../utils/negociosPublicados';
import { AMENIDADES_CLAVE } from '../utils/amenidadesClave';

// Con pocos negocios (hoy 12) la tarjeta compacta hace ver el catálogo
// escaso: caben todas en dos filas y se siente vacío. La tarjeta grande
// (NegocioCard) ocupa más espacio visual y da sensación de catálogo con
// cuerpo. Es una decisión de percepción, no técnica — se invierte al
// crecer el catálogo, porque entonces la grande obliga a demasiado
// scroll y la compacta permite comparar de un vistazo. Cambiar este
// valor a `true` cuando /hospedaje llegue a 30 negocios publicados.
const USAR_TARJETA_COMPACTA = false;

const todos = filtrarListables(await getCollection('negocios'));
const negociosHospedaje = todos.filter((n) => n.data.categoria === 'hospedaje');

// Orden interno del catálogo: los negocios marcados como destacados quedan
// arriba, pero se muestran dentro de un único catálogo público. Después van
// los gratuitos por puntaje de completitud.
const destacados = negociosHospedaje
  .filter((n) => n.data.destacado)
  .sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));
const gratuitos = negociosHospedaje.filter((n) => !n.data.destacado).sort(compararDentroDeGrupo);
const todosOrdenados = [...destacados, ...gratuitos];

// Misma regla que las demás categorías (PaginaCategoria.astro): noindex
// automático mientras la categoría no tenga negocios. Hoy hospedaje
// siempre tiene fichas, pero se deja la misma protección por si algún
// día queda vacía temporalmente.
const categoriaVacia = todosOrdenados.length === 0;

function normalizar(texto: string): string {
  return texto
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();
}

// Umbrales de los chips "A pasos de la playa" y "Para grupos grandes" —
// centralizados aquí, una sola línea si hace falta ajustarlos.
const UMBRAL_PLAYA_METROS = 300;
const UMBRAL_GRUPO_GRANDE = 15;

type Negocio = CollectionEntry<'negocios'>;

// pet-friendly y alberca vienen de utils/amenidadesClave.ts — mismo
// criterio (campo booleano dedicado) que usa la línea de amenidades de
// las tarjetas en celular, para no tener dos lugares con criterios
// distintos para lo mismo.
function amenidadClave(valor: (typeof AMENIDADES_CLAVE)[number]['valor']) {
  return AMENIDADES_CLAVE.find((a) => a.valor === valor)!;
}

const DEFINICION_CHIPS: { valor: string; etiqueta: string; prueba: (n: Negocio) => boolean }[] = [
  { valor: 'casa', etiqueta: 'Casas vacacionales', prueba: (n) => n.data.tipo === 'casa' },
  { valor: 'hotel', etiqueta: 'Hoteles', prueba: (n) => n.data.tipo === 'hotel' },
  { valor: 'alberca', etiqueta: amenidadClave('alberca').etiqueta, prueba: amenidadClave('alberca').prueba },
  {
    valor: 'playa',
    etiqueta: 'A pasos de la playa',
    prueba: (n) =>
      (n.data.distancias ?? []).some(
        (d) => d.a === 'playa' && d.metros !== undefined && d.metros <= UMBRAL_PLAYA_METROS,
      ),
  },
  {
    valor: 'grupo-grande',
    etiqueta: 'Para grupos grandes',
    // Incluye la capacidad de rentar todo el conjunto (ej. las 4 casas
    // de Raysemar juntas), no solo la de una unidad — ver
    // capacidadGrupoCompleto en content.config.ts.
    prueba: (n) =>
      Math.max(n.data.capacidadMaxima ?? 0, n.data.capacidadGrupoCompleto ?? 0) >= UMBRAL_GRUPO_GRANDE,
  },
  {
    valor: 'pet-friendly',
    etiqueta: amenidadClave('pet-friendly').etiqueta,
    prueba: amenidadClave('pet-friendly').prueba,
  },
  {
    valor: 'tarjeta',
    etiqueta: 'Acepta tarjeta',
    prueba: (n) => (n.data.formasPago ?? []).some((f) => normalizar(f).includes('tarjeta')),
  },
];

// Un chip solo se muestra si al menos un negocio lo cumple — mostrar un
// filtro que siempre da "sin resultados" se ve roto y contradice la
// regla de no mostrar etiquetas sin dato real detrás.
const chips = DEFINICION_CHIPS.filter((c) => todosOrdenados.some(c.prueba));
const ICONOS_CHIP: Record<string, string> = {
  todo: 'brujula',
  casa: 'cama',
  hotel: 'cama',
  alberca: 'alberca',
  playa: 'olas',
  'grupo-grande': 'grupos',
  'pet-friendly': 'mascota',
  tarjeta: 'etiqueta',
};

function filtrosDe(n: Negocio): Record<string, boolean> {
  return Object.fromEntries(DEFINICION_CHIPS.map((c) => [c.valor, c.prueba(n)]));
}

const esquemaItemList =
  todosOrdenados.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: todosOrdenados.map((n, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `https://tecolutlatravel.mx/hospedaje/${n.id}`,
          name: n.data.nombre,
        })),
      }
    : null;
---

<BaseLayout
  titulo="🏡 Casas de hospedaje y 🏨 Hoteles en Tecolutla, Veracruz"
  descripcion="Casas, cabañas y hospedaje disponible en Tecolutla, Veracruz, con precios, fotos y disponibilidad."
  noindex={categoriaVacia}
>
  {esquemaItemList && <script type="application/ld+json" set:html={JSON.stringify(esquemaItemList)} />}

  <section class="promesa promesa--playa promesa--catalogo">
    <img
      class="promesa__imagen"
      src="/images/banner-cangrejo-azul-submarino-v4.png"
      alt="Cangrejo azul entre arrecifes submarinos"
      width="1672"
      height="941"
      loading="eager"
    />
    <div class="promesa__overlay" aria-hidden="true"></div>
    <div class="contenedor promesa__interior">
      <p class="migaja migaja--promesa"><a href="/">Inicio</a> → Hospedaje</p>
      <h1>Descubre dónde hospedarte, qué hacer y dónde comer en Tecolutla</h1>
      <p class="promesa__subtitulo">Habla directo por WhatsApp con cada negocio, sin intermediarios ni comisiones.</p>

      <div class="promesa__confianza">
        <div class="promesa__beneficio"><Icono nombre="whatsapp" /><span>Contacto directo<br /><b>por WhatsApp</b></span></div>
        <div class="promesa__beneficio"><Icono nombre="escudo" /><span>Negocios<br /><b>verificados</b></span></div>
        <div class="promesa__beneficio"><Icono nombre="etiqueta" /><span>Cero<br /><b>comisiones</b></span></div>
      </div>
    </div>
  </section>

  <nav class="navegacion-categorias" aria-label="Explora otras categorías">
    <div class="contenedor navegacion-categorias__scroll">
      <a href="/hospedaje" class="navegacion-categorias__enlace navegacion-categorias__enlace--activo">⌂ Hospedaje</a>
      <a href="/gastronomia" class="navegacion-categorias__enlace">🍴 Gastronomía</a>
      <a href="/actividades" class="navegacion-categorias__enlace">🏃 Actividades</a>
      <a href="/reportajes-y-noticias" class="navegacion-categorias__enlace"><Icono nombre="periodico" /> Reportajes y noticias</a>
      <a href="/tips-para-tu-viaje" class="navegacion-categorias__enlace">💡 Tips para tu viaje</a>
    </div>
  </nav>

  <section class="seccion contenedor hospedaje-catalogo destacados-propuesta">
    <div class="negocios-controles">
      <div>
        <h2 class="titulo-seccion" style="margin-bottom:0.35rem;">Todo el hospedaje</h2>
        {
          todosOrdenados.length > 0 && (
            <button type="button" class="filtros-ayuda__boton filtros-ayuda__boton--hospedaje" data-abrir-ayuda>
              <span aria-hidden="true">?</span> ¿Qué significan los iconos?
            </button>
          )
        }
      </div>
      {
        todosOrdenados.length > 0 && (
          <div class="buscador-categoria">
            <label for="buscador-hospedaje-input" class="buscador-categoria__etiqueta">
              Buscar hoteles y casas por nombre
            </label>
            <div class="buscador-categoria__campo">
              <svg
                class="buscador-categoria__icono"
                viewBox="0 0 20 20"
                width="16"
                height="16"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <circle cx="8.5" cy="8.5" r="6" />
                <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round" />
              </svg>
              <input
                type="search"
                id="buscador-hospedaje-input"
                class="buscador-categoria__input"
                placeholder="Buscar hoteles y casas…"
                autocomplete="off"
              />
            </div>
          </div>
        )
      }
    </div>
    {
      chips.length > 0 && (
        <div class="fila-chips filtros-hospedaje" id="fila-chips" style="margin-top:-0.5rem;">
          <button type="button" class="filtro-rapido filtro-rapido--activo" data-chip="todo">
            <Icono nombre={ICONOS_CHIP.todo} /> Todo
          </button>
          {chips.map((c) => (
            <button type="button" class="filtro-rapido" data-chip={c.valor}>
              <Icono nombre={ICONOS_CHIP[c.valor] ?? 'etiqueta'} /> {c.etiqueta}
            </button>
          ))}
        </div>
      )
    }
    {
      todosOrdenados.length === 0 ? (
        <p>
          Todavía no hay negocios publicados en esta categoría.{' '}
          <a href="/anunciate">Anúnciate aquí</a> si tienes un negocio en Tecolutla.
        </p>
      ) : (
        <div class={USAR_TARJETA_COMPACTA ? 'rejilla-compacta' : 'rejilla-negocios'} id="rejilla-hospedaje">
          {todosOrdenados.map((n, i) =>
            USAR_TARJETA_COMPACTA ? (
              <TarjetaCompacta
                negocio={n}
                esPrimera={i === 0}
                filtros={filtrosDe(n)}
              />
            ) : (
              <NegocioCard
                negocio={n}
                esPrimera={i === 0}
                filtros={filtrosDe(n)}
              />
            ),
          )}
        </div>
      )
    }
    <p id="mensaje-chip-vacio" class="filtro-tipo__vacio" hidden>
      Todavía no hay negocios de este tipo.
    </p>

    <dialog class="filtros-ayuda" data-ayuda-iconos aria-labelledby="titulo-ayuda-iconos-hospedaje">
      <div class="filtros-ayuda__cabecera">
        <h2 id="titulo-ayuda-iconos-hospedaje">Cómo leer las fichas</h2>
        <button type="button" class="filtros-ayuda__cerrar" data-cerrar-ayuda aria-label="Cerrar ayuda">×</button>
      </div>
      <div class="filtros-ayuda__lista">
        <span><Icono nombre="alberca" /><b>Alberca</b><small>Cuenta con piscina.</small></span>
        <span><Icono nombre="olas" /><b>Frente al mar</b><small>Está frente a la playa o cerca de ella.</small></span>
        <span><Icono nombre="usuarios" /><b>Máx. X personas</b><small>Capacidad máxima del alojamiento.</small></span>
        <span><Icono nombre="wifi" /><b>Wifi</b><small>Conexión inalámbrica disponible.</small></span>
        <span><Icono nombre="aire" /><b>Aire acondicionado</b><small>Cuenta con aire acondicionado.</small></span>
        <span><Icono nombre="estacionamiento" /><b>Estacionamiento</b><small>Ofrece espacio para estacionar.</small></span>
        <span><Icono nombre="mascota" /><b>Pet friendly</b><small>Acepta mascotas según sus condiciones.</small></span>
        <span><Icono nombre="ubicacion" /><b>A X m de la playa</b><small>Distancia aproximada a la playa.</small></span>
        <span><Icono nombre="whatsapp" /><b>WhatsApp</b><small>Contacto directo con el hospedaje.</small></span>
        <span><Icono nombre="corazon" /><b>Favorito</b><small>Guarda la ficha para verla después.</small></span>
        <span><Icono nombre="comparar" /><b>Comparar</b><small>Permite comparar este hospedaje con otros.</small></span>
        <span><Icono nombre="escudo" /><b>Verificado</b><small>El negocio confirmó sus datos con TecolutlaTravel.</small></span>
      </div>
    </dialog>
  </section>
</BaseLayout>

<script>
  import { registrarBusqueda } from '../utils/buscadorNegocios';
  const ayudaIconos = document.querySelector<HTMLDialogElement>('[data-ayuda-iconos]');
  document.querySelector('[data-abrir-ayuda]')?.addEventListener('click', () => ayudaIconos?.showModal());
  document.querySelector('[data-cerrar-ayuda]')?.addEventListener('click', () => ayudaIconos?.close());
  ayudaIconos?.addEventListener('click', (evento) => {
    if (evento.target === ayudaIconos) ayudaIconos.close();
  });

  // Combina el chip de filtro activo (por amenidad/tipo) con la búsqueda
  // por nombre — una tarjeta se muestra solo si cumple los dos a la vez,
  // igual que el buscador de categoría combinaba filtro de tipo + nombre
  // antes de la Tarea 2 del rediseño (commit 81ebdbd).
  function activarControles() {
    const fila = document.getElementById('fila-chips');
    const grid = document.getElementById('rejilla-hospedaje');
    const mensajeVacio = document.getElementById('mensaje-chip-vacio');
    const buscadorInput = document.getElementById(
      'buscador-hospedaje-input',
    ) as HTMLInputElement | null;
    if (!grid) return;

    function normalizar(texto: string): string {
      return texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function chipActivo(): string {
      return (
        fila?.querySelector('[data-chip].filtro-rapido--activo')?.getAttribute('data-chip') ?? 'todo'
      );
    }

    function aplicarFiltros() {
      const valor = chipActivo();
      const consulta = normalizar(buscadorInput?.value ?? '');
      let visibles = 0;
      // [data-slug] en vez de .tarjeta-compacta: funciona igual con la
      // tarjeta grande (NegocioCard) o la compacta, según qué esté
      // activa (ver USAR_TARJETA_COMPACTA arriba).
      grid.querySelectorAll<HTMLElement>('[data-slug]').forEach((tarjeta) => {
        const coincideChip = valor === 'todo' || tarjeta.getAttribute(`data-filtro-${valor}`) === '1';
        const coincideBusqueda =
          !consulta || normalizar(tarjeta.dataset.nombre ?? '').includes(consulta);
        const mostrar = coincideChip && coincideBusqueda;
        tarjeta.style.display = mostrar ? '' : 'none';
        if (mostrar) visibles++;
      });
      if (mensajeVacio) {
        mensajeVacio.hidden = visibles > 0;
        mensajeVacio.textContent = consulta
          ? 'No encontramos negocios con ese nombre.'
          : 'Todavía no hay negocios de este tipo.';
      }
      if (buscadorInput?.value.trim()) registrarBusqueda(buscadorInput.value, visibles > 0);
    }

    fila?.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((boton) => {
      boton.addEventListener('click', () => {
        fila.querySelectorAll('[data-chip]').forEach((b) => b.classList.remove('filtro-rapido--activo'));
        boton.classList.add('filtro-rapido--activo');
        aplicarFiltros();
      });
    });

    buscadorInput?.addEventListener('input', aplicarFiltros);

    // Las ligas desde la portada conservan el filtro elegido en la URL.
    // Si el filtro existe en el catálogo real, se activa automáticamente;
    // si no existe (por ejemplo, porque aún no hay negocios de ese tipo),
    // la página se queda de forma segura en "Todo" en vez de mostrar una
    // pantalla vacía o fingir resultados.
    const parametros = new URLSearchParams(window.location.search);
    const filtroSolicitado = parametros.get('filtro');
    const consultaSolicitada = parametros.get('q');
    const botonSolicitado = filtroSolicitado
      ? Array.from(fila?.querySelectorAll<HTMLButtonElement>('[data-chip]') ?? []).find(
          (boton) => boton.dataset.chip === filtroSolicitado,
        )
      : null;

    if (consultaSolicitada && buscadorInput) {
      buscadorInput.value = consultaSolicitada;
    }
    if (botonSolicitado) {
      botonSolicitado.click();
    } else {
      aplicarFiltros();
    }
  }

  activarControles();
</script>
