---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiposAceptados = 'image/jpeg,image/png,image/webp';
---

<BaseLayout
  titulo="Anúnciate en el directorio"
  descripcion="Da de alta tu negocio de Tecolutla en el directorio de forma gratuita. Revisión manual antes de publicar."
>
  <section class="seccion contenedor">
    <h1 class="titulo-pagina">Anuncia tu negocio en Tecolutla</h1>
    <p class="subtitulo">
      La alta de tu negocio en este directorio es <strong>gratuita</strong>. Revisamos cada
      solicitud manualmente antes de publicarla, así que puede tomar unos días en aparecer.
    </p>

    <form
      name="alta-negocio"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="alta-negocio-web"
      enctype="multipart/form-data"
      action="/anunciate/gracias"
    >
      <input type="hidden" name="form-name" value="alta-negocio" />
      <p class="campo-oculto" aria-hidden="true">
        <label for="alta-negocio-web">No llenes este campo</label>
        <input type="text" id="alta-negocio-web" name="alta-negocio-web" tabindex="-1" autocomplete="off" />
      </p>

      <div class="campo">
        <label for="nombreNegocio">Nombre del negocio *</label>
        <input type="text" id="nombreNegocio" name="nombreNegocio" required />
      </div>

      <div class="campo">
        <label for="categoria">Categoría *</label>
        <select id="categoria" name="categoria" required>
          <option value="">Selecciona una categoría</option>
          <option value="hospedaje">Hospedaje</option>
          <option value="gastronomia">Gastronomía</option>
          <option value="actividades">Actividades ecoturísticas</option>
          <option value="servicios">Servicios</option>
        </select>
      </div>

      <div class="campo">
        <label for="descripcionCorta">Descripción corta de tu negocio *</label>
        <textarea id="descripcionCorta" name="descripcionCorta" rows="3" required></textarea>
      </div>

      <div class="campo">
        <label for="direccion">Dirección en Tecolutla *</label>
        <span class="ayuda">Incluye número y colonia si los tienes, ej: Calle Girasol #12, Col. Centro</span>
        <input type="text" id="direccion" name="direccion" required />
      </div>

      <div class="campo">
        <label for="ubicacionMaps">Ubicación en Google Maps *</label>
        <span class="ayuda">
          Abre Google Maps, busca o marca dónde está tu negocio, toca "Compartir" y pega aquí el
          enlace que te dé — así lo ubicamos exacto en el mapa de tu ficha.
        </span>
        <input
          type="url"
          id="ubicacionMaps"
          name="ubicacionMaps"
          placeholder="https://maps.app.goo.gl/..."
          required
        />
      </div>

      <div class="campo">
        <label for="telefono">Teléfono / WhatsApp de contacto para clientes *</label>
        <span class="ayuda">Mínimo 10 dígitos, ej: 55 76612345</span>
        <input type="tel" id="telefono" name="telefono" required />
        <p id="aviso-telefono" class="aviso-envio" role="alert" hidden>
          ⚠️ El teléfono debe tener al menos 10 dígitos.
        </p>
      </div>

      <div class="campo">
        <label for="precioAproximado">Precio aproximado (opcional)</label>
        <input type="text" id="precioAproximado" name="precioAproximado" />
      </div>

      <div class="campo">
        <label for="numeroHabitaciones">Número de habitaciones (si aplica)</label>
        <input type="number" id="numeroHabitaciones" name="numeroHabitaciones" min="0" />
      </div>

      <div class="campo">
        <label for="serviciosAmenidades">Servicios o amenidades (opcional)</label>
        <span class="ayuda">Sepáralos por comas, por ejemplo: wifi, estacionamiento, alberca</span>
        <textarea id="serviciosAmenidades" name="serviciosAmenidades" rows="2"></textarea>
      </div>

      <div class="campo">
        <span class="etiqueta-seccion">Fotos de tu negocio *</span>
        <span class="ayuda">
          Sube al menos 3 fotos en total. Usa <strong>una</strong> de estas 2 opciones — no hace
          falta llenar las dos: tus fotos una por una, o un enlace con tus fotos. No te preocupes
          por el tamaño: las comprimimos automáticamente antes de enviarlas.
        </span>
        <p id="contador-fotos" class="contador-fotos" aria-live="polite">
          Fotos subidas: 0 / 3 mínimo
        </p>
        <p id="estado-compresion" class="ayuda" aria-live="polite"></p>
      </div>

      <div class="campo">
        <label for="foto1">
          Sube tus fotos una por una: Foto 1 (opcional)
          <span class="etiqueta-portada">★ Foto de portada</span>
        </label>
        <span class="ayuda">
          Esta primera foto es la que se usa como portada de tu ficha en el directorio.
        </span>
        <div class="campo-foto-fila">
          <input type="file" id="foto1" name="foto1" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="1" aria-label="Quitar Foto 1" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto2">Foto de muestra 2 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto2" name="foto2" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="2" aria-label="Quitar Foto 2" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto3">Foto de muestra 3 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto3" name="foto3" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="3" aria-label="Quitar Foto 3" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto4">Foto de muestra 4 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto4" name="foto4" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="4" aria-label="Quitar Foto 4" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto5">Foto de muestra 5 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto5" name="foto5" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="5" aria-label="Quitar Foto 5" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto6">Foto de muestra 6 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto6" name="foto6" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="6" aria-label="Quitar Foto 6" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto7">Foto de muestra 7 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto7" name="foto7" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="7" aria-label="Quitar Foto 7" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="foto8">Foto de muestra 8 (opcional)</label>
        <div class="campo-foto-fila">
          <input type="file" id="foto8" name="foto8" accept={tiposAceptados} />
          <button type="button" class="campo-foto-quitar" data-quitar-foto="8" aria-label="Quitar Foto 8" hidden>✕</button>
        </div>
      </div>

      <div class="campo">
        <label for="enlaceFotos">Enlace con más fotos (opcional)</label>
        <span class="ayuda">
          Si tienes más de 8 fotos, comparte un enlace (Google Drive, WeTransfer, etc.) en vez de
          adjuntarlas aquí.
        </span>
        <input type="url" id="enlaceFotos" name="enlaceFotos" placeholder="https://" />
      </div>

      <div class="campo">
        <label for="nombreContacto">Tu nombre (para dar seguimiento a la solicitud) *</label>
        <input type="text" id="nombreContacto" name="nombreContacto" required />
      </div>

      <div class="campo">
        <label for="correoContacto">Tu correo electrónico *</label>
        <input type="email" id="correoContacto" name="correoContacto" required />
      </div>

      <div class="campo">
        <label for="comentarios">Comentarios adicionales (opcional)</label>
        <textarea id="comentarios" name="comentarios" rows="3"></textarea>
      </div>

      <div class="campo">
        <label>
          <input type="checkbox" name="aceptaRevision" required />
          Entiendo que mi negocio será revisado manualmente antes de publicarse y que la alta
          en el directorio es gratuita. *
        </label>
      </div>

      <p class="ayuda">
        Al enviar este formulario aceptas nuestro <a href="/aviso-de-privacidad">Aviso de Privacidad</a>.
      </p>

      <p id="aviso-fotos" class="aviso-envio" role="alert" hidden>
        ⚠️ Necesitas subir al menos 3 fotos (o un enlace con tus fotos) antes de enviar.
      </p>

      <button type="submit" class="boton">Enviar solicitud</button>
    </form>
  </section>

  <script>
    import { comprimirImagen } from '../utils/comprimirImagen';

    // Netlify Forms rechaza el envío completo (todos los campos + fotos
    // juntos) si pasa de 8MB en total — no es un límite por archivo. Con 3-8
    // fotos de celular reales (2-6MB cada una es normal hoy) casi cualquier
    // envío completo lo superaba y Netlify lo tronaba sin explicación clara
    // para quien llena el formulario. Se comprime cada foto a este tope
    // antes de enviar: 8 fotos × 900KB = 7.2MB, con margen para los campos
    // de texto y el overhead del multipart.
    const TOPE_FOTO_BYTES = 900 * 1024;

    const form = document.querySelector('form[name="alta-negocio"]') as HTMLFormElement | null;
    const enlaceFotos = document.getElementById('enlaceFotos') as HTMLInputElement | null;
    const contador = document.getElementById('contador-fotos');
    const estadoCompresion = document.getElementById('estado-compresion');
    const aviso = document.getElementById('aviso-fotos');
    const fotoInputs = Array.from({ length: 8 }, (_, i) =>
      document.getElementById(`foto${i + 1}`),
    ) as (HTMLInputElement | null)[];
    const telefono = document.getElementById('telefono') as HTMLInputElement | null;
    const avisoTelefono = document.getElementById('aviso-telefono');

    if (telefono && avisoTelefono) {
      const telefonoValido = () => telefono.value.replace(/\D/g, '').length >= 10;
      telefono.addEventListener('input', () => {
        if (telefonoValido()) avisoTelefono.hidden = true;
      });
    }

    if (form && enlaceFotos && contador && aviso) {
      let comprimiendo = false;

      const contarFotos = () => {
        let total = 0;
        for (const input of fotoInputs) {
          if (input?.files?.length) total += 1;
        }
        return total;
      };

      const actualizarContador = () => {
        const total = contarFotos();
        const tieneEnlace = enlaceFotos.value.trim().length > 0;
        const cumple = tieneEnlace || total >= 3;
        contador.textContent = tieneEnlace
          ? 'Enlace de fotos proporcionado ✓'
          : `Fotos subidas: ${total} / 3 mínimo`;
        contador.classList.toggle('contador-fotos--ok', cumple);
        if (cumple) aviso.hidden = true;
      };

      // Comprime en el sitio cualquier foto de este input que pase del tope,
      // y reemplaza el FileList del input con la(s) versión(es) comprimida(s)
      // — así lo que realmente se envía ya pesa poco, sin que el usuario
      // tenga que hacer nada distinto a solo elegir sus fotos normales.
      async function comprimirSiHaceFalta(input: HTMLInputElement) {
        const archivos = Array.from(input.files ?? []);
        if (archivos.length === 0) return;
        const pesados = archivos.filter((a) => a.size > TOPE_FOTO_BYTES);
        if (pesados.length === 0) return;

        comprimiendo = true;
        if (estadoCompresion) estadoCompresion.textContent = 'Comprimiendo fotos…';

        const resultado: File[] = [];
        for (const archivo of archivos) {
          if (archivo.size <= TOPE_FOTO_BYTES) {
            resultado.push(archivo);
            continue;
          }
          const comprimido = await comprimirImagen(archivo, TOPE_FOTO_BYTES);
          resultado.push(comprimido ?? archivo);
        }

        const dt = new DataTransfer();
        for (const archivo of resultado) dt.items.add(archivo);
        input.files = dt.files;

        comprimiendo = false;
        if (estadoCompresion) {
          estadoCompresion.textContent = `Fotos comprimidas y listas para enviar (${pesados.length}).`;
        }
      }

      // Botón "×" para quitar una foto individual ya seleccionada (Foto 1 a
      // Foto 8) sin tener que reabrir el explorador de archivos y elegir
      // otra encima.
      const botonesQuitarFoto = fotoInputs.map((input, indice) => {
        const boton = document.querySelector(
          `[data-quitar-foto="${indice + 1}"]`,
        ) as HTMLButtonElement | null;
        boton?.addEventListener('click', () => {
          if (!input) return;
          input.value = '';
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
        return boton;
      });

      const actualizarBotonQuitar = (input: HTMLInputElement) => {
        const indice = fotoInputs.indexOf(input);
        const boton = indice === -1 ? undefined : botonesQuitarFoto[indice];
        if (boton) boton.hidden = !(input.files && input.files.length > 0);
      };

      for (const input of fotoInputs) {
        input?.addEventListener('change', async () => {
          await comprimirSiHaceFalta(input);
          actualizarContador();
          actualizarBotonQuitar(input);
        });
      }
      enlaceFotos.addEventListener('input', actualizarContador);
      actualizarContador();

      form.addEventListener('submit', (evento) => {
        const total = contarFotos();
        const tieneEnlace = enlaceFotos.value.trim().length > 0;
        const faltanFotos = !tieneEnlace && total < 3;
        const faltaTelefono = telefono ? telefono.value.replace(/\D/g, '').length < 10 : false;

        if (avisoTelefono) avisoTelefono.hidden = !faltaTelefono;
        aviso.hidden = !faltanFotos;

        if (faltanFotos || faltaTelefono || comprimiendo) {
          evento.preventDefault();
          if (comprimiendo && estadoCompresion) {
            estadoCompresion.textContent = 'Espera, todavía estamos comprimiendo tus fotos…';
            estadoCompresion.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            (faltaTelefono ? avisoTelefono : aviso)?.scrollIntoView({
              behavior: 'smooth',
              block: 'center',
            });
          }
          return;
        }

        // La validación pasó: el formulario sí se va a enviar de verdad.
        // Con fotos adjuntas puede tardar varios segundos en conexiones
        // lentas, y sin este aviso la página se queda igual mientras tanto
        // — el usuario no tiene forma de saber que ya se está enviando.
        const boton = form.querySelector('button[type="submit"]');
        if (boton instanceof HTMLButtonElement) {
          boton.disabled = true;
          boton.textContent = 'Enviando tu solicitud… no cierres esta página';
        }
      });
    }
  </script>
</BaseLayout>
