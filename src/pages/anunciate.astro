---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiposAceptados = 'image/jpeg,image/png,image/webp,video/mp4,video/quicktime';
const tamanoMaximoMb = 8;
---

<BaseLayout
  titulo="Anúnciate en el directorio"
  descripcion="Da de alta tu negocio de Tecolutla en el directorio de forma gratuita. Revisión manual antes de publicar."
>
  <section class="seccion contenedor">
    <h1 class="titulo-pagina">Anuncia tu negocio en Tecolutla</h1>
    <p class="subtitulo">
      La alta de tu negocio en este directorio es <strong>gratuita</strong>. Revisamos cada
      solicitud manualmente antes de publicarla, así que puede tomar unos días en aparecer.
    </p>

    <form
      name="alta-negocio"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="alta-negocio-web"
      enctype="multipart/form-data"
      action="/anunciate/gracias"
    >
      <input type="hidden" name="form-name" value="alta-negocio" />
      <p class="campo-oculto" aria-hidden="true">
        <label for="alta-negocio-web">No llenes este campo</label>
        <input type="text" id="alta-negocio-web" name="alta-negocio-web" tabindex="-1" autocomplete="off" />
      </p>

      <div class="campo">
        <label for="nombreNegocio">Nombre del negocio *</label>
        <input type="text" id="nombreNegocio" name="nombreNegocio" required />
      </div>

      <div class="campo">
        <label for="categoria">Categoría *</label>
        <select id="categoria" name="categoria" required>
          <option value="">Selecciona una categoría</option>
          <option value="hospedaje">Hospedaje</option>
          <option value="gastronomia">Gastronomía</option>
          <option value="actividades">Actividades ecoturísticas</option>
          <option value="servicios">Servicios</option>
        </select>
      </div>

      <div class="campo">
        <label for="descripcionCorta">Descripción corta de tu negocio *</label>
        <textarea id="descripcionCorta" name="descripcionCorta" rows="3" required></textarea>
      </div>

      <div class="campo">
        <label for="direccion">Dirección en Tecolutla *</label>
        <span class="ayuda">Incluye número y colonia si los tienes, ej: Calle Girasol #12, Col. Centro</span>
        <input type="text" id="direccion" name="direccion" required />
      </div>

      <div class="campo">
        <label for="telefono">Teléfono / WhatsApp de contacto para clientes *</label>
        <input type="tel" id="telefono" name="telefono" required />
      </div>

      <div class="campo">
        <label for="precioAproximado">Precio aproximado (opcional)</label>
        <input type="text" id="precioAproximado" name="precioAproximado" />
      </div>

      <div class="campo">
        <label for="numeroHabitaciones">Número de habitaciones (si aplica)</label>
        <input type="number" id="numeroHabitaciones" name="numeroHabitaciones" min="0" />
      </div>

      <div class="campo">
        <label for="serviciosAmenidades">Servicios o amenidades (opcional)</label>
        <span class="ayuda">Sepáralos por comas, por ejemplo: wifi, estacionamiento, alberca</span>
        <textarea id="serviciosAmenidades" name="serviciosAmenidades" rows="2"></textarea>
      </div>

      <div class="campo">
        <span class="etiqueta-seccion">Fotos y video de tu negocio *</span>
        <span class="ayuda">
          Sube al menos 3 fotos o video en total — puedes combinar el campo de varias fotos, las
          casillas de una por una, o pegar un enlace con tus fotos más abajo.
        </span>
        <p id="contador-fotos" class="contador-fotos" aria-live="polite">
          Fotos o video subidos: 0 / 3 mínimo
        </p>
      </div>

      <div class="campo">
        <label for="fotosVarias">¿Prefieres subir varias fotos de una sola vez? (opcional)</label>
        <span class="ayuda">
          Selecciona todas las que quieras aquí — no hace falta que también llenes las casillas de
          abajo. Solo imágenes o video, máximo {tamanoMaximoMb} MB por archivo.
        </span>
        <input type="file" id="fotosVarias" name="fotosVarias" accept={tiposAceptados} multiple />
      </div>

      <div class="campo">
        <label for="foto1">
          O sube tus fotos una por una: Foto/video 1 (opcional)
          <span class="etiqueta-portada">★ Foto de portada</span>
        </label>
        <span class="ayuda">
          Usa esto si prefieres ir de una en una en vez del campo de arriba. Esta primera foto es
          la que se usa como portada de tu ficha en el directorio.
        </span>
        <input type="file" id="foto1" name="foto1" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto2">Foto o video de muestra 2 (opcional)</label>
        <input type="file" id="foto2" name="foto2" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto3">Foto o video de muestra 3 (opcional)</label>
        <input type="file" id="foto3" name="foto3" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto4">Foto o video de muestra 4 (opcional)</label>
        <input type="file" id="foto4" name="foto4" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto5">Foto o video de muestra 5 (opcional)</label>
        <input type="file" id="foto5" name="foto5" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto6">Foto o video de muestra 6 (opcional)</label>
        <input type="file" id="foto6" name="foto6" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto7">Foto o video de muestra 7 (opcional)</label>
        <input type="file" id="foto7" name="foto7" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="foto8">Foto o video de muestra 8 (opcional)</label>
        <input type="file" id="foto8" name="foto8" accept={tiposAceptados} />
      </div>

      <div class="campo">
        <label for="enlaceFotos">Enlace con más fotos o video (opcional)</label>
        <span class="ayuda">
          Si tienes más de 8 fotos, o algún video pesado, comparte un enlace (Google Drive,
          WeTransfer, etc.) en vez de adjuntarlo aquí.
        </span>
        <input type="url" id="enlaceFotos" name="enlaceFotos" placeholder="https://" />
      </div>

      <div class="campo">
        <label for="nombreContacto">Tu nombre (para dar seguimiento a la solicitud) *</label>
        <input type="text" id="nombreContacto" name="nombreContacto" required />
      </div>

      <div class="campo">
        <label for="correoContacto">Tu correo electrónico *</label>
        <input type="email" id="correoContacto" name="correoContacto" required />
      </div>

      <div class="campo">
        <label for="comentarios">Comentarios adicionales (opcional)</label>
        <textarea id="comentarios" name="comentarios" rows="3"></textarea>
      </div>

      <div class="campo">
        <label>
          <input type="checkbox" name="aceptaRevision" required />
          Entiendo que mi negocio será revisado manualmente antes de publicarse y que la alta
          en el directorio es gratuita. *
        </label>
      </div>

      <p class="ayuda">
        Al enviar este formulario aceptas nuestro <a href="/aviso-de-privacidad">Aviso de Privacidad</a>.
      </p>

      <p id="aviso-fotos" class="aviso-envio" role="alert" hidden>
        ⚠️ Necesitas subir al menos 3 fotos o video (o un enlace con tus fotos) antes de enviar.
      </p>

      <button type="submit" class="boton">Enviar solicitud</button>
    </form>
  </section>

  <script>
    const form = document.querySelector('form[name="alta-negocio"]') as HTMLFormElement | null;
    const fotosVarias = document.getElementById('fotosVarias') as HTMLInputElement | null;
    const enlaceFotos = document.getElementById('enlaceFotos') as HTMLInputElement | null;
    const contador = document.getElementById('contador-fotos');
    const aviso = document.getElementById('aviso-fotos');
    const fotoInputs = Array.from({ length: 8 }, (_, i) =>
      document.getElementById(`foto${i + 1}`),
    ) as (HTMLInputElement | null)[];

    if (form && fotosVarias && enlaceFotos && contador && aviso) {
      const contarFotos = () => {
        let total = fotosVarias.files?.length ?? 0;
        for (const input of fotoInputs) {
          if (input?.files?.length) total += 1;
        }
        return total;
      };

      const actualizarContador = () => {
        const total = contarFotos();
        const tieneEnlace = enlaceFotos.value.trim().length > 0;
        const cumple = tieneEnlace || total >= 3;
        contador.textContent = tieneEnlace
          ? 'Enlace de fotos proporcionado ✓'
          : `Fotos o video subidos: ${total} / 3 mínimo`;
        contador.classList.toggle('contador-fotos--ok', cumple);
        if (cumple) aviso.hidden = true;
      };

      for (const input of [fotosVarias, ...fotoInputs]) {
        input?.addEventListener('change', actualizarContador);
      }
      enlaceFotos.addEventListener('input', actualizarContador);
      actualizarContador();

      form.addEventListener('submit', (evento) => {
        const total = contarFotos();
        const tieneEnlace = enlaceFotos.value.trim().length > 0;
        if (!tieneEnlace && total < 3) {
          evento.preventDefault();
          aviso.hidden = false;
          aviso.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }
  </script>
</BaseLayout>
