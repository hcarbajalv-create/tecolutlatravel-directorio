---
import BaseLayout from '../layouts/BaseLayout.astro';

// Número oficial de WhatsApp de Tecolutla.Travel (dato dado por Hector,
// 2026-08-06) — nunca se muestra como texto, solo va embebido en el enlace.
const numeroWhatsapp = '5580572172';
const whatsappDigitos = `521${numeroWhatsapp.replace(/^52/, '')}`;
const mensaje = encodeURIComponent('hola, quiero ser colaborador, que necesito?');
const enlaceWhatsapp = `https://wa.me/${whatsappDigitos}?text=${mensaje}`;
---

<BaseLayout
  titulo="Contáctanos"
  descripcion="Comunícate con el equipo de TecolutlaTravel por WhatsApp o correo electrónico para dudas sobre el directorio, negocios o colaboraciones."
>
  <section class="seccion contenedor contacto">
    <h1 class="titulo-pagina">Contáctanos</h1>
    <p class="subtitulo contacto__intro">
      ¿Tienes dudas sobre el directorio, quieres preguntar por algún negocio, o te interesa
      proponernos una colaboración? Escríbenos, con gusto te ayudamos.
    </p>

    <div class="contacto__tarjeta">
      <a
        class="contacto__whatsapp"
        href={enlaceWhatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.71 14.02c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.91-1.26-4.8-4.18-4.95-4.38-.15-.2-1.18-1.57-1.18-3 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.83 2 .9 2.14.07.15.12.32.02.52-.1.2-.15.32-.29.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.61.17.29.75 1.24 1.62 2 1.11.99 2.05 1.3 2.34 1.45.29.15.46.13.64-.07.18-.2.75-.87.95-1.17.2-.29.39-.24.66-.15.27.1 1.73.82 2.03.97.29.15.49.22.56.35.07.13.07.75-.17 1.43z" />
        </svg>
        Comunícate por WhatsApp
      </a>
    </div>
    <p class="contacto__nota">Por el momento no recibimos llamadas, solo mensajes por WhatsApp.</p>

    <p class="contacto__correo">
      También puedes escribirnos a
      <a href="mailto:contacto@tecolutlatravel.mx">contacto@tecolutlatravel.mx</a>
    </p>
  </section>
</BaseLayout>
