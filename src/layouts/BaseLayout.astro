---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotTeco from '../components/BotTeco.astro';
import RastreoCampana from '../components/RastreoCampana.astro';
import PlanificadorHospedajes from '../components/PlanificadorHospedajes.astro';
import ConsultaHospedajeWhatsapp from '../components/ConsultaHospedajeWhatsapp.astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  // URL absoluta a una imagen real (ej. la portada de una ficha). Si no se
  // pasa, cae al logo genérico del sitio — así ninguna página comparte sin
  // imagen en la vista previa de WhatsApp/Facebook (antes no había ninguna).
  imagen?: string;
  // Dimensiones reales de "imagen" — WhatsApp/Facebook las usan para
  // reservar el espacio de la vista previa sin parpadeo. Si no se pasan,
  // se asume el tamaño del logo por default (public/og-default.jpg, 640x640).
  imagenAncho?: number;
  imagenAlto?: number;
  // Por default, "titulo" es solo la parte descriptiva y aquí se le
  // agrega " | TecolutlaTravel" (sin punto — regla explícita del sitio).
  // La home usa un formato propio que ya trae su propio cierre en vez
  // de la marca ("... | Qué hacer y dónde comer"), así que pasa
  // tituloCompleto para que no se le agregue nada más encima.
  tituloCompleto?: boolean;
  encabezadoSobreHero?: boolean;
}

const {
  titulo,
  descripcion,
  noindex = false,
  imagen,
  imagenAncho = 640,
  imagenAlto = 640,
  tituloCompleto = false,
  encabezadoSobreHero = false,
} = Astro.props;
const tituloFinal = tituloCompleto ? titulo : `${titulo} | TecolutlaTravel`;
// El build usa format:'file' (paginas.html planas) para evitar redirects de
// Netlify, pero eso deja el .html en Astro.url.pathname durante el build.
// El canonico debe reflejar la URL limpia real (sin .html), igual que el
// sitemap y los enlaces internos — si no, quedan inconsistentes entre si.
const rutaCanonica = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
// La home es la única excepción a "sin barra final": un objeto URL
// siempre serializa la raíz con "/" (es la sintaxis mínima válida), pero
// @astrojs/sitemap sí le quita esa barra a la home de forma fija cuando
// trailingSlash:'never' (ver astro.config.mjs) — se replica aquí ese
// mismo recorte para que canonical y sitemap digan exactamente lo mismo.
const urlCanonica =
  rutaCanonica === '/'
    ? Astro.site.toString().replace(/\/$/, '')
    : new URL(rutaCanonica, Astro.site).toString();
const imagenFinal = imagen ?? new URL('/og-default.jpg', Astro.site).toString();

// GA4 solo se activa cuando existe un ID de medición real (variable de
// entorno PUBLIC_GA_MEASUREMENT_ID) — evita mandar datos a una propiedad
// inventada mientras el usuario no haya creado la suya.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    <meta name="theme-color" content="#0b6f7a" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@900&family=Work+Sans:wght@500;600&display=swap"
      rel="stylesheet"
    />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenFinal} />
    <meta property="og:image:width" content={String(imagenAncho)} />
    <meta property="og:image:height" content={String(imagenAlto)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenFinal} />
    <slot name="head-extra" />
    {
      gaMeasurementId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaMeasurementId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="saltar-enlace" href="#contenido-principal">Saltar al contenido principal</a>
    <Header rutaActual={Astro.url.pathname} sobreHero={encabezadoSobreHero} />
    <main id="contenido-principal">
      <slot />
    </main>
    <ConsultaHospedajeWhatsapp />
    <PlanificadorHospedajes />
    <Footer />
    <BotTeco />
    <RastreoCampana />
  </body>
</html>

<style>
  .saltar-enlace {
    position: absolute;
    left: -9999px;
    top: 0;
    background: #fff;
    color: #000;
    padding: 0.75rem 1rem;
    z-index: 100;
  }

  .saltar-enlace:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
