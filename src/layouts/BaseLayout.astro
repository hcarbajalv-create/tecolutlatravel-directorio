---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
}

const { titulo, descripcion, noindex = false } = Astro.props;
// El build usa format:'file' (paginas.html planas) para evitar redirects de
// Netlify, pero eso deja el .html en Astro.url.pathname durante el build.
// El canonico debe reflejar la URL limpia real (sin .html), igual que el
// sitemap y los enlaces internos — si no, quedan inconsistentes entre si.
const rutaCanonica = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const urlCanonica = new URL(rutaCanonica, Astro.site);

// GA4 solo se activa cuando existe un ID de medición real (variable de
// entorno PUBLIC_GA_MEASUREMENT_ID) — evita mandar datos a una propiedad
// inventada mientras el usuario no haya creado la suya.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} | TecolutlaTravel</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    <meta name="theme-color" content="#0b6f7a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@900&family=Work+Sans:wght@500;600&display=swap"
      rel="stylesheet"
    />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${titulo} | TecolutlaTravel`} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    {
      gaMeasurementId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaMeasurementId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="saltar-enlace" href="#contenido-principal">Saltar al contenido principal</a>
    <Header rutaActual={Astro.url.pathname} />
    <main id="contenido-principal">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar-enlace {
    position: absolute;
    left: -9999px;
    top: 0;
    background: #fff;
    color: #000;
    padding: 0.75rem 1rem;
    z-index: 100;
  }

  .saltar-enlace:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
