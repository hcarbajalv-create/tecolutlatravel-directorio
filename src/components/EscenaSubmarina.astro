        <path d="M-34,-26 L-31,-21" stroke="#0c2b2e" stroke-width="1.6" stroke-linecap="round"></path>
      </g>
      <g style="transform-box:fill-box;transform-origin:20% 90%;animation:tsPinch 1.1s ease-in-out -0.4s infinite alternate-reverse">
