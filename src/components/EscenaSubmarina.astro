    </g>
    <g id="fishB">
      <path d="M-18,0 L-28,-8 L-25,0 L-28,8 Z" fill="currentColor" opacity="0.8"></path>
      <ellipse cx="0" cy="0" rx="19" ry="7.5" fill="currentColor"></ellipse>
      <circle cx="12" cy="-2" r="1.8" fill="#0c2b2e"></circle>
    </g>
  </defs>
