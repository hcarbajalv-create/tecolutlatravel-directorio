---
// Escena submarina animada — diseño recibido como export de Claude Design
// (carpeta /screen en la raíz del proyecto, 2026-08-18). El export traía el
// dibujo completo pero sin las @keyframes de las animaciones (solo los
// nombres puestos en cada elemento, ej. style="animation:tsBob...") — las
// @keyframes de abajo en global.css son una reconstrucción nuestra
// interpretando esos nombres y sus tiempos/curvas ya definidos aquí.
//
// variante="completa": home — trae las 2 estrellas de mar y el cardumen
// extra de 3 peces chicos.
// variante="calmada": el resto de las cabeceras (hoy solo /hospedaje) —
// sin esos 2 elementos, para no competir tanto con el título encima.
interface Props {
  variante?: 'completa' | 'calmada';
  class?: string;
}
const { variante = 'completa', class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  class={`teco-scene ${className ?? ''}`}
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="tsWater" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4fd2c8"></stop><stop offset="0.32" stop-color="#0b6f7a"></stop><stop offset="0.78" stop-color="#0d3f46"></stop><stop offset="1" stop-color="#0c2b2e"></stop></linearGradient>
    <radialGradient id="tsSun" cx="0.5" cy="0" r="0.75"><stop offset="0" stop-color="#4fd2c8" stop-opacity="0.85"></stop><stop offset="1" stop-color="#4fd2c8" stop-opacity="0"></stop></radialGradient>
    <linearGradient id="tsRay" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4fd2c8" stop-opacity="0.55"></stop><stop offset="1" stop-color="#4fd2c8" stop-opacity="0"></stop></linearGradient>
    <linearGradient id="tsSandFade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0c2b2e" stop-opacity="0.5"></stop><stop offset="1" stop-color="#0c2b2e" stop-opacity="0"></stop></linearGradient>
    <radialGradient id="tsCaustic"><stop offset="0" stop-color="#ffffff" stop-opacity="0.9"></stop><stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop></radialGradient>
    <filter id="tsBlur" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="10"></feGaussianBlur></filter>
    <clipPath id="tsSandClip"><path d="M0,900 V742 Q180,716 360,740 T720,736 T1080,744 T1440,738 V900 Z"></path></clipPath>
    <g id="fishA">
      <path d="M-28,0 L-42,-11 L-38,0 L-42,11 Z" fill="currentColor" opacity="0.8"></path>
      <path d="M-28,0 C-16,-13 14,-15 30,0 C14,15 -16,13 -28,0 Z" fill="currentColor"></path>
      <path d="M-4,-9 C2,-15 10,-15 14,-11 C8,-8 2,-8 -4,-9 Z" fill="currentColor" opacity="0.75"></path>
      <circle cx="20" cy="-3" r="2.4" fill="#0c2b2e"></circle>
    </g>
    <g id="turtle">
      <path d="M-40,6 L-60,20 L-54,7 L-59,-4 Z" fill="#4fd2c8" opacity="0.9"></path>
      <path d="M-14,8 C-2,4 12,4 22,8 C12,28 -8,32 -24,26 Z" fill="#4fd2c8" style="transform-box:fill-box;transform-origin:60% 8%;animation:tsPaddle 1.7s ease-in-out infinite alternate"></path>
      <circle cx="52" cy="-4" r="11" fill="#4fd2c8"></circle>
      <circle cx="57" cy="-7" r="2.1" fill="#0c2b2e"></circle>
      <path d="M-44,2 C-38,-28 38,-28 44,2 C30,13 -30,13 -44,2 Z" fill="#0c2b2e" opacity="0.92"></path>
      <path d="M-31,-8 C-10,-21 14,-21 33,-6" stroke="#4fd2c8" stroke-width="2.5" fill="none" opacity="0.55"></path>
      <path d="M-14,-18 L-12,4 M10,-18 L12,4" stroke="#4fd2c8" stroke-width="2" opacity="0.4"></path>
    </g>
    <g id="crab">
      <path d="M-12,2 Q-26,8 -32,20 M-8,6 Q-18,14 -20,23 M-2,8 Q-5,17 -4,25" stroke="#ff7a5c" stroke-width="2.5" fill="none" stroke-linecap="round"></path>
      <path d="M12,2 Q26,8 32,20 M8,6 Q18,14 20,23 M2,8 Q5,17 4,25" stroke="#ff7a5c" stroke-width="2.5" fill="none" stroke-linecap="round"></path>
      <g style="transform-box:fill-box;transform-origin:80% 90%;animation:tsPinch 0.9s ease-in-out infinite alternate">
        <path d="M-16,-4 Q-28,-10 -30,-18" stroke="#ff9478" stroke-width="3" fill="none" stroke-linecap="round"></path>
