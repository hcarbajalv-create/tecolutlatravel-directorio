  <path d="M652,772 C660,736 646,712 656,676" stroke="#0c2b2e" stroke-width="4" fill="none" opacity="0.8" stroke-linecap="round" style="transform-box:fill-box;transform-origin:50% 100%;animation:tsSway 5.8s ease-in-out -1.5s infinite alternate"></path>
