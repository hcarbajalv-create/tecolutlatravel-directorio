---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { CATALOGO_DISTANCIAS, formatearDistancia } from '../utils/catalogoDistancias';
import { amenidadesClaveMovil } from '../utils/amenidadesClave';
import Icono from './Icono.astro';

interface Props {
  negocio: CollectionEntry<'negocios'>;
  // La primera tarjeta de cada listado suele ser el elemento LCP de la
  // página — se carga con prioridad en vez de perezosa. El resto sigue
  // en "lazy" como antes. Ver PaginaCategoria.astro e index.astro, que
  // son quienes saben cuál tarjeta es la primera del listado real.
  esPrimera?: boolean;
  // Resultado de los chips de filtro de la página que use esta tarjeta
  // (ej. /hospedaje) — se vuelca como atributos data-filtro-<clave>,
  // igual que en TarjetaCompacta.astro, para que el mismo JS de filtro
  // funcione sin importar cuál de las dos tarjetas esté en uso.
  filtros?: Record<string, boolean>;
}

const { negocio, esPrimera = false, filtros = {} } = Astro.props;
const atributosFiltro = Object.fromEntries(
  Object.entries(filtros).map(([clave, valor]) => [`data-filtro-${clave}`, valor ? '1' : '0']),
);
const {
  categoria,
  nombre,
  descripcionCorta,
  fotos,
  destacado,
  verificado,
  servicios,
  telefono,
  direccion,
  numeroHabitaciones,
  capacidadMaxima,
  capacidadGrupoCompleto,
  insigniasExtra,
  petFriendly,
  alberca,
  wifi,
  frenteAlMar,
  distancias,
  tipo,
  subtipo,
  ordenManual,
  confirmadoFecha,
  plan,
} = negocio.data;
const portada = fotos[0];

// Mismo mapeo que TarjetaCompacta.astro y la ficha del negocio.
const NOMBRE_CATEGORIA: Record<string, string> = {
  hospedaje: 'Hospedaje',
  gastronomia: 'Gastronomía',
  actividades: 'Actividades',
  servicios: 'Servicios',
};
// En hospedaje ya no se muestra la categoría genérica ("Hospedaje") —
// se muestra el subtipo específico del negocio (Hotel, Posada, etc.)
// solo si está definido en su .yaml; si no, no se muestra nada ahí.
// Las demás categorías (sin subtipo todavía) siguen mostrando su nombre.
const etiquetaCategoria = categoria === 'hospedaje' ? subtipo : NOMBRE_CATEGORIA[categoria];
// La tarjeta solo tiene espacio para una insignia sobre la foto — se usa
// la primera distancia de la lista, la que el negocio (o quien dio de
// alta) eligió como su gancho principal (ver la regla de orden en
// content.config.ts). Regla: una distancia AL MAR de 1 km o más no vende
// (espanta más de lo que informa en un pueblo costero) — se descarta esa
// entrada aunque exista en el .yaml, sin tener que quitarla a mano.
// Otros destinos (río, centro, embarcadero) no tienen este límite.
const DISTANCIA_PLAYA_MAX_METROS = 999;
const distanciasVendibles = distancias?.filter(
  (d) => !(d.a === 'playa' && d.metros !== undefined && d.metros > DISTANCIA_PLAYA_MAX_METROS),
);
const distanciaTarjeta = distanciasVendibles?.[0];
// Antes, un negocio sin distancia usaba la capacidad como gancho alterno en la
// insignia de la foto. Ya no: por decision de Hector, el numero de personas no
// aparece en NINGUNA presentacion de tarjeta, solo dentro de la ficha. Si no
// hay distancia, la insignia se queda con lo que traiga insigniasExtra, y si
// tampoco hay, no se muestra.
const insigniaAlterna = undefined;
// Todas las distancias vendibles del negocio (no solo la primera) rotan
// solas en el mismo espacio — un negocio con playa Y río no necesita
// escribir la segunda a mano en insigniasExtra, ya sale de "distancias".
// insigniasExtra es para datos que NO son distancia (capacidad total,
// política de mascotas, etc. — ver content.config.ts). El script al
// final del componente hace la rotación cuando hay más de un dato; con
// uno solo (el caso normal) se muestra fijo, sin JS de por medio.
const distanciaTexto = distanciaTarjeta ? formatearDistancia(distanciaTarjeta) : undefined;
// La linea de distancia SIEMPRE usa el marcador de posicion, sea la playa, el
// rio, el centro o el embarcadero. Antes playa y rio usaban "olas", y eso
// contradecia la leyenda de "Como leer las fichas", donde "olas" significa
// "Frente al mar" y el marcador es el que dice "A X m de la playa". Ademas
// "olas" para el rio hacia que un negocio a 300 m del rio se viera igual que
// uno frente al mar. Asi "olas" queda solo para lo que de verdad significa.
const ICONO_DISTANCIA = 'ubicacion';
const textoSinEmojiInicial = (texto: string) => texto.replace(/^[\p{Extended_Pictographic}\uFE0F\s]+/u, '');
const insigniasRotativas = [
  ...(!distanciaTarjeta ? [insigniaAlterna] : []),
  ...(insigniasExtra ?? []).map(textoSinEmojiInicial),
].filter((texto): texto is string => Boolean(texto));
// La rotación en sí (el movimiento) es un plus del plan de pago — un
// negocio gratuito con varios datos solo muestra el primero, fijo, para
// no darle una ventaja de atención (el movimiento llama la vista más
// que lo estático) sobre negocios gratuitos vecinos que no tengan tantos
// datos que mostrar. Ver feedback en memoria: se probó con Raysemar
// (gratuito) y se decidió reservarlo para pago.
const rotarInsignia = plan === 'pago' && insigniasRotativas.length > 1;
const enlace = `/${categoria}/${negocio.id}`;
const enlaceAbsoluto = new URL(enlace, Astro.site).toString();
const amenidadesCalculadas: Array<{ icono: string; texto: string }> = [];
// La linea de distancia ya pinta su propio icono (el marcador de posicion).
// Si un servicio pide ese mismo icono, se omite para no verlo dos veces en la
// misma tarjeta.
const iconoDeLaDistancia = distanciaTarjeta ? ICONO_DISTANCIA : undefined;
const agregarAmenidad = (icono: string, texto: string) => {
  if (icono === iconoDeLaDistancia) return;
  if (!amenidadesCalculadas.some((amenidad) => amenidad.icono === icono)) {
    amenidadesCalculadas.push({ icono, texto });
  }
};
// La CAPACIDAD no lleva icono en la tarjeta, por decision de Hector. Un hotel
// de 16 habitaciones decia "Hasta 62 personas" y una familia entendia que le
// rentaban el hotel entero; explicarlo en un icono no se puede. Ademas, dejar
// ese dato solo dentro de la ficha da un motivo para entrar a verla.
// La fila es solo de amenidades: alberca, aire, mascotas, wifi, etc.
if (frenteAlMar) agregarAmenidad('olas', 'Frente al mar');
if (alberca) agregarAmenidad('alberca', 'Alberca');
if (wifi) agregarAmenidad('wifi', 'Wifi');
for (const servicio of servicios) agregarAmenidad(iconoAmenidad(servicio), servicio);
if (petFriendly) agregarAmenidad('mascota', 'Pet friendly');

// Orden de importancia acordado con Hector, pensado en que decide una reserva:
// alberca, aire, mascotas, wifi, frente al mar y asador. Lo que no este en esta
// lista queda despues, en el orden en que lo escribio el negocio en su .yaml.
// Antes el orden era accidental: dependia de como estuviera redactada cada
// ficha, asi que dos negocios con los mismos servicios podian mostrarlos en
// distinto orden.
const PRIORIDAD_ICONOS = ['alberca', 'aire', 'mascota', 'wifi', 'olas', 'asador'];
const peso = (icono: string) => {
  const i = PRIORIDAD_ICONOS.indexOf(icono);
  return i === -1 ? PRIORIDAD_ICONOS.length : i;
};
amenidadesCalculadas.sort((a, b) => peso(a.icono) - peso(b.icono));
// Primero se descartan los que no se dibujan y DESPUES se corta a cinco. Al
// reves, un negocio con muchos servicios gastaba espacios en iconos invisibles:
// a Casa Xanath se le iban dos en el generico y el wifi, y por eso su asador y
// su "pet friendly" no alcanzaban lugar aunque los tuviera.
// Tope de 9 (antes 5). Medido en la tarjeta mas angosta, la de escritorio
// grande, donde caben 4 tarjetas por fila: la fila util mide 243 px, cada
// icono 17 px y la separacion 8.8, asi que entran 9 en un renglon. Pasando de
// ahi se brincan al segundo y las tarjetas quedan de distinta altura.
// Es una regla flexible, acordada con Hector: si alguna ficha no las acomoda,
// se revisa. En celular NO aplica este numero — ahi la fila es otra
// (.tarjeta__info-movil, ver amenidadesClave.ts) y muestra capacidad mas 2
// amenidades CON TEXTO, porque la tarjeta mide 180 px y no caben mas.
const AMENIDADES_VISIBLES_MAX = 9;
// Solo se descarta el icono generico (un servicio que no tiene dibujo propio).
// El wifi ANTES tambien se descartaba, pero Hector lo puso en el lugar 5 de la
// lista de prioridad, asi que ahora si se muestra.
const amenidadesVisibles = amenidadesCalculadas
  .filter((amenidad) => amenidad.icono !== 'etiqueta')
  .slice(0, AMENIDADES_VISIBLES_MAX);

// La capacidad y Pet friendly ya tienen una fila informativa propia.
// No se repiten como chips de amenidades.
const datosExtra: Array<{ icono: string; texto: string }> = [];

function iconoAmenidad(servicio: string) {
  const texto = servicio.toLocaleLowerCase('es-MX');
  if (texto.includes('alberca')) return 'alberca';
  if (texto.includes('wifi') || texto.includes('internet')) return 'wifi';
  if (texto.includes('aire')) return 'aire';
  if (texto.includes('estacionamiento')) return 'estacionamiento';
  // Solo "asador", NO "parrilla": la parrilla de dos quemadores de una cocineta
  // no es un asador, y ninguno de los 23 negocios usa "parrilla" para el asador.
  if (texto.includes('asador')) return 'asador';
  // Las reglas de abajo se escribieron mirando los 90 servicios distintos que
  // hay hoy en las 23 fichas, no de memoria. El orden importa: gana la primera
  // que coincide, por eso "3 habitaciones con aire acondicionado y ventilador
  // de techo" se queda con el icono de aire, que es el dato mas fuerte.
  if (texto.includes('cocina')) return 'cocina';
  if (/\btv\b/.test(texto) || texto.includes('televis') || texto.includes('roku')) return 'tv';
  if (texto.includes('ventilador')) return 'ventilador';
  if (texto.includes('agua caliente')) return 'agua-caliente';
  // "mar" y "pet" van como palabra completa, no como pedazo de otra palabra.
  // Buscandolas sueltas, "TV Smart" y "2 camas matrimoniales" se llevaban el
  // icono de olas, y salia la playa en Casa Llanos, Casa Via Mar y Piedras
  // Altas, que ni siquiera la anuncian.
  if (texto.includes('mascota') || /\bpet\b/.test(texto)) return 'mascota';
  // Ojo: aqui NO se busca "playa" ni "mar". El icono de olas significa estar
  // frente al mar, y eso lo decide el campo frenteAlMar del .yaml, no lo que
  // diga un servicio. Un negocio que escribe "A 2 minutos de la playa" entre
  // sus servicios esta repitiendo la distancia, no diciendo que esta enfrente.
  return 'etiqueta';
}

// El numero de personas NO va en la tarjeta, ni aqui en movil ni en la fila
// de iconos de escritorio ni en la insignia de la foto. Solo dentro de la
// ficha. Decision de Hector: en un hotel el numero confunde ("Hasta 62
// personas" no significa que renten el hotel entero) y dejarlo dentro da un
// motivo para abrir la ficha, que es donde esta el boton de WhatsApp.
const chipsAmenidadesMovil = amenidadesClaveMovil(negocio);

// En Actividades se priorizan los datos que realmente ayudan a elegir entre
// operadores: punto de salida y detalles propios del servicio. No se
// muestran precios ni reseñas hasta que estén confirmados en el catálogo.
const capitanActividad = categoria === 'actividades'
  ? (descripcionCorta.match(/capitán\s+([^,.]+)/i)?.[1]?.trim() ?? undefined)
  : undefined;
// Estos datos son comunes a los recorridos y ayudan a comparar operadores
// sin hacer que cada ficha compita por la ruta que visita.
const distintivosActividad = categoria === 'actividades'
  ? ['Paseos privados para tu grupo', 'Horarios flexibles']
  : [];

const telefonoDigitos = telefono.replace(/[^\d]/g, '');
// wa.me exige "52 1" antes del número móvil mexicano de 10 dígitos,
// aunque México ya no lo pida para llamadas normales desde el propio teléfono.
// Si el teléfono ya trae otro código de país (ej. "+1" de EUA/Canadá), se
// respeta tal cual — no se le antepone el prefijo mexicano.
const telefonoWhatsapp = telefono.trim().startsWith('+1')
  ? telefonoDigitos
  : `521${telefonoDigitos.replace(/^52/, '')}`;
// Se manda la URL completa de la ficha (no solo "www.tecolutlatravel.mx"
// como texto suelto) para que WhatsApp arme la vista previa con la foto
// real del negocio (og:image de la ficha) — antes no aparecía ninguna.
const enlaceWhatsapp = `https://wa.me/${telefonoWhatsapp}?text=${encodeURIComponent(
  `Hola, vi ${nombre} en el directorio de ${enlaceAbsoluto} y me gustaría más información.`,
)}`;
---

<article
  class={`tarjeta tarjeta--${categoria}`}
  data-slug={negocio.id}
  data-destacado={destacado ? 'true' : 'false'}
  data-tipo={tipo ?? ''}
  data-orden-manual={ordenManual ?? ''}
  data-nombre={nombre}
  {...atributosFiltro}
>
  <div class="tarjeta__foto">
    <a href={enlace} tabindex="-1" aria-hidden="true">
      <Image
        class="tarjeta__imagen"
        src={portada.src}
        alt={portada.alt}
        loading={esPrimera ? 'eager' : 'lazy'}
        fetchpriority={esPrimera ? 'high' : 'auto'}
        width={500}
        height={375}
        widths={[300, 500, 750]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 320px"
      />
    </a>
    {
      (destacado || verificado) && (
        <div class="tarjeta__insignias">
          {destacado && <span class="insignia insignia--destacado">Destacado</span>}
          {verificado && <span class="insignia insignia--verificado">Verificado</span>}
        </div>
      )
    }
    {
      insigniasRotativas.length > 0 && (
        <div class="tarjeta__datos">
          <span
            class="insignia insignia--dato"
            data-insignias={rotarInsignia ? JSON.stringify(insigniasRotativas) : undefined}
          >
            {insigniasRotativas[0]}
          </span>
        </div>
      )
    }
  </div>
  <div class="tarjeta__cuerpo">
    {etiquetaCategoria && <span class="tarjeta__categoria">{etiquetaCategoria}</span>}
    <h3 class="tarjeta__titulo"><a href={enlace}>{nombre}</a></h3>
    {
      categoria === 'actividades' && (
        <div class="tarjeta__actividad-datos">
          {capitanActividad && <p><Icono nombre="timon" /><span><b>Capitán</b>{capitanActividad}</span></p>}
          <p><Icono nombre="ubicacion" /><span><b>Sale de</b>{direccion}</span></p>
          {distintivosActividad.map((distintivo) => (
            <p>
              <Icono nombre={distintivo.startsWith('Paseos privados') ? 'grupos' : 'reloj'} />
              <span>{distintivo}</span>
            </p>
          ))}
        </div>
      )
    }
    {
      chipsAmenidadesMovil.length > 0 && (
        <div class="tarjeta__info-movil">
          {chipsAmenidadesMovil.map((amenidad) => (
            <span class="chip-amenidad"><Icono nombre={amenidad.icono} /> {amenidad.texto}</span>
          ))}
        </div>
      )
    }
    <p class="tarjeta__descripcion">{descripcionCorta}</p>

    {/* El title de la distancia sale del catalogo, que ya trae el nombre bien
        escrito y con su articulo ("la playa", "el rio"). */}
    {distanciaTexto && (
      <p
        class="tarjeta__distancia"
        title={`Distancia a ${CATALOGO_DISTANCIAS[distanciaTarjeta?.a ?? 'playa'].etiqueta}`}
      >
        <Icono nombre={ICONO_DISTANCIA} />
        {distanciaTexto}
      </p>
    )}

    {/* El "title" de cada chip hace que al pasar el mouse salga una etiqueta
        con lo que significa el icono. Hace falta porque en escritorio el texto
        del chip se esconde con font-size:0 y solo queda el dibujo. En celular
        no se necesita: ahi se muestra .tarjeta__info-movil, que si trae el
        texto a la vista, y ademas no hay mouse. */}
    {
      (datosExtra.length > 0 || amenidadesVisibles.length > 0) && (
        <div class="tarjeta__amenidades">
          {datosExtra.filter((dato) => dato.icono !== 'etiqueta').map((dato) => (
            <span class="chip-amenidad" title={dato.texto}><Icono nombre={dato.icono} /> {dato.texto}</span>
          ))}
          {amenidadesVisibles.map((amenidad) => (
            <span class="chip-amenidad" title={amenidad.texto}><Icono nombre={amenidad.icono} /> {amenidad.texto}</span>
          ))}
        </div>
      )
    }

    {
      confirmadoFecha && (
        <p class="tarjeta__confirmado"><Icono nombre="whatsapp" /> Confirmado con el dueño · {confirmadoFecha}</p>
      )
    }

    <div class="tarjeta__acciones">
      <a class="boton boton--whatsapp boton--chico" href={enlaceWhatsapp} target="_blank" rel="noopener noreferrer" {...(categoria === 'hospedaje' ? { 'data-consulta-hospedaje': '', 'data-consulta-nombre': nombre, 'data-consulta-whatsapp': telefonoWhatsapp } : {})}>WhatsApp</a>
      <a class="boton boton--secundario boton--chico" href={enlace}>Ver ficha</a>
    </div>
    {
      categoria === 'hospedaje' && (
        <div class="tarjeta__seleccion" aria-label={`Opciones para ${nombre}`}>
          <button type="button" class="tarjeta__seleccion-boton" data-favorito-hospedaje data-slug={negocio.id} aria-pressed="false">
            <Icono nombre="corazon" /> Guardar en favoritos
          </button>
          <button type="button" class="tarjeta__seleccion-boton" data-comparar-hospedaje data-slug={negocio.id} aria-pressed="false">
            <Icono nombre="comparar" /> Comparar
          </button>
        </div>
      )
    }
    {categoria === 'hospedaje' && <span class="tarjeta__corazon-foto"><Icono nombre="corazon" /></span>}
    {categoria === 'actividades' && (
      <button type="button" class="tarjeta__corazon-foto tarjeta__corazon-foto--actividad" data-favorito-actividad data-slug={negocio.id} aria-label={`Guardar ${nombre} en favoritos`} aria-pressed="false">
        <Icono nombre="corazon" />
      </button>
    )}
  </div>
</article>

<script>
  // Rota el texto de la insignia de dato cuando el negocio trae más de
  // un dato que destacar (ver insigniasExtra en content.config.ts) — en
  // vez de llenar la tarjeta de insignias sueltas, se van alternando en
  // el mismo espacio. Astro deduplica este bloque aunque la tarjeta se
  // repita muchas veces en una misma página, así que corre una sola vez
  // por carga y encuentra todas las insignias con querySelectorAll.
  const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefiereMenosMovimiento) {
    document.querySelectorAll<HTMLElement>('.insignia--dato[data-insignias]').forEach((insignia) => {
      const textos = JSON.parse(insignia.dataset.insignias ?? '[]') as string[];
      if (textos.length < 2) return;
      let indice = 0;
      setInterval(() => {
        indice = (indice + 1) % textos.length;
        insignia.style.opacity = '0';
        setTimeout(() => {
          insignia.textContent = textos[indice];
          insignia.style.opacity = '1';
        }, 250);
      }, 2600);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-favorito-actividad]').forEach((boton) => {
    const clave = 'tecolutlatravel-favoritos-actividades';
    const leer = (): string[] => JSON.parse(localStorage.getItem(clave) ?? '[]');
    const actualizar = () => {
      const activo = leer().includes(boton.dataset.slug ?? '');
      boton.classList.toggle('esta-guardado', activo);
      boton.setAttribute('aria-pressed', String(activo));
    };
    actualizar();
    boton.addEventListener('click', () => {
      const slug = boton.dataset.slug ?? '';
      const favoritos = leer();
      const indice = favoritos.indexOf(slug);
      if (indice >= 0) favoritos.splice(indice, 1);
      else favoritos.push(slug);
      localStorage.setItem(clave, JSON.stringify(favoritos));
      actualizar();
    });
  });
</script>
