---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { CATALOGO_DISTANCIAS, formatearDistanciaCompacta } from '../utils/catalogoDistancias';
import { amenidadesClaveMovil } from '../utils/amenidadesClave';

interface Props {
  negocio: CollectionEntry<'negocios'>;
  // La primera tarjeta de cada listado suele ser el elemento LCP de la
  // página — se carga con prioridad en vez de perezosa. El resto sigue
  // en "lazy" como antes. Ver PaginaCategoria.astro e index.astro, que
  // son quienes saben cuál tarjeta es la primera del listado real.
  esPrimera?: boolean;
  // Resultado de los chips de filtro de la página que use esta tarjeta
  // (ej. /hospedaje) — se vuelca como atributos data-filtro-<clave>,
  // igual que en TarjetaCompacta.astro, para que el mismo JS de filtro
  // funcione sin importar cuál de las dos tarjetas esté en uso.
  filtros?: Record<string, boolean>;
}

const { negocio, esPrimera = false, filtros = {} } = Astro.props;
const atributosFiltro = Object.fromEntries(
  Object.entries(filtros).map(([clave, valor]) => [`data-filtro-${clave}`, valor ? '1' : '0']),
);
const {
  categoria,
  nombre,
  descripcionCorta,
  fotos,
  destacado,
  verificado,
  servicios,
  telefono,
  numeroHabitaciones,
  capacidadMaxima,
  petFriendly,
  distancias,
  tipo,
  subtipo,
  ordenManual,
  confirmadoFecha,
} = negocio.data;
const portada = fotos[0];

// Mismo mapeo que TarjetaCompacta.astro y la ficha del negocio.
const NOMBRE_CATEGORIA: Record<string, string> = {
  hospedaje: 'Hospedaje',
  gastronomia: 'Gastronomía',
  actividades: 'Actividades',
  servicios: 'Servicios',
};
// En hospedaje ya no se muestra la categoría genérica ("Hospedaje") —
// se muestra el subtipo específico del negocio (Hotel, Posada, etc.)
// solo si está definido en su .yaml; si no, no se muestra nada ahí.
// Las demás categorías (sin subtipo todavía) siguen mostrando su nombre.
const etiquetaCategoria = categoria === 'hospedaje' ? subtipo : NOMBRE_CATEGORIA[categoria];
// La tarjeta solo tiene espacio para una insignia de distancia — se usa
// la primera de la lista, que es la que el negocio (o quien dio de alta)
// eligió como su gancho principal. Ver la regla de orden en content.config.ts.
const distanciaTarjeta = distancias?.[0];
const enlace = `/${categoria}/${negocio.id}`;
const enlaceAbsoluto = new URL(enlace, Astro.site).toString();
const amenidadesVisibles = servicios.slice(0, 3);

const datosExtra: string[] = [];
if (capacidadMaxima !== undefined) {
  datosExtra.push(`👥 Hasta ${capacidadMaxima} personas`);
} else if (numeroHabitaciones !== undefined) {
  datosExtra.push(
    `🛏️ ${numeroHabitaciones} ${numeroHabitaciones === 1 ? 'habitación' : 'habitaciones'}`,
  );
}
if (petFriendly) datosExtra.push('🐾 Pet friendly');

// En móvil la tarjeta oculta .tarjeta__descripcion y .tarjeta__amenidades
// por espacio (ver global.css, media max-width:640px) — sin esto la
// tarjeta quedaba solo con categoría, nombre y botones, sin ningún dato
// que ayude a decidir. Quien busca hospedaje en el celular decide por
// capacidad y amenidades, no por el nombre. Se muestra únicamente la
// capacidad (dato más buscado) y como máximo 2 amenidades "clave" (ver
// utils/amenidadesClave.ts, mismo criterio que usan los chips de filtro
// de /hospedaje) — no la lista completa, para eso está la ficha del
// negocio.
const capacidadMovil =
  capacidadMaxima !== undefined ? `👥 Hasta ${capacidadMaxima} personas` : undefined;
const chipsAmenidadesMovil = amenidadesClaveMovil(negocio);

const telefonoDigitos = telefono.replace(/[^\d]/g, '');
// wa.me exige "52 1" antes del número móvil mexicano de 10 dígitos,
// aunque México ya no lo pida para llamadas normales desde el propio teléfono.
// Si el teléfono ya trae otro código de país (ej. "+1" de EUA/Canadá), se
// respeta tal cual — no se le antepone el prefijo mexicano.
const telefonoWhatsapp = telefono.trim().startsWith('+1')
  ? telefonoDigitos
  : `521${telefonoDigitos.replace(/^52/, '')}`;
// Se manda la URL completa de la ficha (no solo "www.tecolutlatravel.mx"
// como texto suelto) para que WhatsApp arme la vista previa con la foto
// real del negocio (og:image de la ficha) — antes no aparecía ninguna.
const enlaceWhatsapp = `https://wa.me/${telefonoWhatsapp}?text=${encodeURIComponent(
  `Hola, vi ${nombre} en el directorio de ${enlaceAbsoluto} y me gustaría más información.`,
)}`;
---

<article
  class="tarjeta"
  data-slug={negocio.id}
  data-destacado={destacado ? 'true' : 'false'}
  data-tipo={tipo ?? ''}
  data-orden-manual={ordenManual ?? ''}
  data-nombre={nombre}
  {...atributosFiltro}
>
  <div class="tarjeta__foto">
    <a href={enlace} tabindex="-1" aria-hidden="true">
      <Image
        class="tarjeta__imagen"
        src={portada.src}
        alt={portada.alt}
        loading={esPrimera ? 'eager' : 'lazy'}
        fetchpriority={esPrimera ? 'high' : 'auto'}
        width={500}
        height={375}
        widths={[300, 500, 750]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 45vw, 320px"
      />
    </a>
    {
      (destacado || verificado) && (
        <div class="tarjeta__insignias">
          {destacado && <span class="insignia insignia--destacado">Destacado</span>}
          {verificado && <span class="insignia insignia--verificado">Verificado</span>}
        </div>
      )
    }
    {
      distanciaTarjeta && (
        <div class="tarjeta__datos">
          <span class="insignia insignia--dato">
            {CATALOGO_DISTANCIAS[distanciaTarjeta.a].icono} {formatearDistanciaCompacta(distanciaTarjeta)}
          </span>
        </div>
      )
    }
  </div>
  <div class="tarjeta__cuerpo">
    {etiquetaCategoria && <span class="tarjeta__categoria">{etiquetaCategoria}</span>}
    <h3 class="tarjeta__titulo"><a href={enlace}>{nombre}</a></h3>
    {
      (capacidadMovil || chipsAmenidadesMovil.length > 0) && (
        <div class="tarjeta__info-movil">
          {capacidadMovil && <span class="chip-amenidad">{capacidadMovil}</span>}
          {chipsAmenidadesMovil.map((amenidad) => (
            <span class="chip-amenidad">{amenidad}</span>
          ))}
        </div>
      )
    }
    <p class="tarjeta__descripcion">{descripcionCorta}</p>

    {
      (datosExtra.length > 0 || amenidadesVisibles.length > 0) && (
        <div class="tarjeta__amenidades">
          {datosExtra.map((dato) => (
            <span class="chip-amenidad">{dato}</span>
          ))}
          {amenidadesVisibles.map((servicio) => (
            <span class="chip-amenidad">{servicio}</span>
          ))}
        </div>
      )
    }

    {
      confirmadoFecha && (
        <p class="tarjeta__confirmado">📞 Confirmado con el dueño · {confirmadoFecha}</p>
      )
    }

    <div class="tarjeta__acciones">
      <a class="boton boton--whatsapp boton--chico" href={enlaceWhatsapp}>WhatsApp</a>
      <a class="boton boton--secundario boton--chico" href={enlace}>Ver ficha</a>
    </div>
  </div>
</article>
