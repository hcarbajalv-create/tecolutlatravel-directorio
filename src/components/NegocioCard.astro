---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { CATALOGO_DISTANCIAS, formatearDistanciaCompacta } from '../utils/catalogoDistancias';

interface Props {
  negocio: CollectionEntry<'negocios'>;
}

const { negocio } = Astro.props;
const {
  categoria,
  nombre,
  descripcionCorta,
  fotos,
  destacado,
  verificado,
  servicios,
  telefono,
  numeroHabitaciones,
  capacidadMaxima,
  petFriendly,
  distancias,
  tipo,
  ordenManual,
} = negocio.data;
const portada = fotos[0];
// La tarjeta solo tiene espacio para una insignia de distancia — se usa
// la primera de la lista, que es la que el negocio (o quien dio de alta)
// eligió como su gancho principal. Ver la regla de orden en content.config.ts.
const distanciaTarjeta = distancias?.[0];
const enlace = `/${categoria}/${negocio.id}`;
const enlaceAbsoluto = new URL(enlace, Astro.site).toString();
const amenidadesVisibles = servicios.slice(0, 3);

const datosExtra: string[] = [];
if (capacidadMaxima !== undefined) {
  datosExtra.push(`👥 Hasta ${capacidadMaxima} personas`);
} else if (numeroHabitaciones !== undefined) {
  datosExtra.push(
    `🛏️ ${numeroHabitaciones} ${numeroHabitaciones === 1 ? 'habitación' : 'habitaciones'}`,
  );
}
if (petFriendly) datosExtra.push('🐾 Pet friendly');

const telefonoDigitos = telefono.replace(/[^\d]/g, '');
// wa.me exige "52 1" antes del número móvil mexicano de 10 dígitos,
// aunque México ya no lo pida para llamadas normales desde el propio teléfono.
// Si el teléfono ya trae otro código de país (ej. "+1" de EUA/Canadá), se
// respeta tal cual — no se le antepone el prefijo mexicano.
const telefonoWhatsapp = telefono.trim().startsWith('+1')
  ? telefonoDigitos
  : `521${telefonoDigitos.replace(/^52/, '')}`;
// Se manda la URL completa de la ficha (no solo "www.tecolutlatravel.mx"
// como texto suelto) para que WhatsApp arme la vista previa con la foto
// real del negocio (og:image de la ficha) — antes no aparecía ninguna.
const enlaceWhatsapp = `https://wa.me/${telefonoWhatsapp}?text=${encodeURIComponent(
  `Hola, vi ${nombre} en el directorio de ${enlaceAbsoluto} y me gustaría más información.`,
)}`;
---

<article
  class="tarjeta"
  data-slug={negocio.id}
  data-destacado={destacado ? 'true' : 'false'}
  data-tipo={tipo ?? ''}
  data-orden-manual={ordenManual ?? ''}
  data-nombre={nombre}
>
  <div class="tarjeta__foto">
    <a href={enlace} tabindex="-1" aria-hidden="true">
      <Image
        class="tarjeta__imagen"
        src={portada.src}
        alt={portada.alt}
        loading="lazy"
        width={500}
        height={375}
      />
    </a>
    {
      (destacado || verificado) && (
        <div class="tarjeta__insignias">
          {destacado && <span class="insignia insignia--destacado">Destacado</span>}
          {verificado && <span class="insignia insignia--verificado">Verificado</span>}
        </div>
      )
    }
    {
      distanciaTarjeta && (
        <div class="tarjeta__datos">
          <span class="insignia insignia--dato">
            {CATALOGO_DISTANCIAS[distanciaTarjeta.a].icono} {formatearDistanciaCompacta(distanciaTarjeta)}
          </span>
        </div>
      )
    }
  </div>
  <div class="tarjeta__cuerpo">
    <h3 class="tarjeta__titulo"><a href={enlace}>{nombre}</a></h3>
    <p class="tarjeta__descripcion">{descripcionCorta}</p>

    {
      (datosExtra.length > 0 || amenidadesVisibles.length > 0) && (
        <div class="tarjeta__amenidades">
          {datosExtra.map((dato) => (
            <span class="chip-amenidad">{dato}</span>
          ))}
          {amenidadesVisibles.map((servicio) => (
            <span class="chip-amenidad">{servicio}</span>
          ))}
        </div>
      )
    }

    <div class="tarjeta__acciones">
      <a class="boton boton--whatsapp boton--chico" href={enlaceWhatsapp}>WhatsApp</a>
      <a class="boton boton--secundario boton--chico" href={enlace}>Ver ficha</a>
    </div>
  </div>
</article>
