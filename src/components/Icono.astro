---
interface Props {
  nombre: string;
  class?: string;
  titulo?: string;
}

const { nombre, class: clase, titulo } = Astro.props;
---

<svg
  class:list={['icono-linea', clase]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={titulo ? undefined : 'true'}
  role={titulo ? 'img' : undefined}
>
  {titulo && <title>{titulo}</title>}
  {nombre === 'whatsapp' && <><path d="M20.5 11.5a8.3 8.3 0 0 1-12.3 7.3L3.5 20l1.2-4.5A8.3 8.3 0 1 1 20.5 11.5Z" /><path d="M8.6 8.2c.2-.5.4-.5.7-.5h.4c.2 0 .4.1.5.4l.7 1.6c.1.3.1.5 0 .6l-.5.7c.4.8 1 1.5 1.8 1.9l.7-.5c.2-.1.4-.1.7 0l1.5.7c.3.1.4.3.4.5v.4c0 .3 0 .5-.5.7-.5.2-1.6.4-3.4-.4-1.4-.6-2.8-2-3.5-3.4-.7-1.5-.5-2.4-.3-2.8Z" /></>}
  {nombre === 'audifonos' && <><path d="M4 13v-1a8 8 0 0 1 16 0v1" /><path d="M4 13h2.5v5H5a1 1 0 0 1-1-1v-4ZM20 13h-2.5v5H19a1 1 0 0 0 1-1v-4Z" /><path d="M17.5 18c-.8 1.5-2.3 2.5-4 2.5h-1" /></>}
  {nombre === 'pulgar' && <><path d="M7 10v10H4a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h3Z" /><path d="M7 19h8.5a2 2 0 0 0 1.9-1.4l2.1-6.2A1.8 1.8 0 0 0 17.8 9H14l.7-3.2A2.3 2.3 0 0 0 12.5 3L7 10v9Z" /></>}
  {nombre === 'escudo' && <><path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z" /><path d="m8.7 12 2.1 2.1 4.6-4.6" /></>}
  {nombre === 'etiqueta' && <><path d="M20 12 12 20 3 11V4h7l10 8Z" /><circle cx="7.5" cy="7.5" r=".8" /></>}
  {nombre === 'ubicacion' && <><path d="M20 10c0 5.3-8 11-8 11S4 15.3 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {nombre === 'calendario' && <><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M7.5 3v4M16.5 3v4M3.5 9h17" /></>}
  {nombre === 'reloj' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5l3.2 2" /></>}
  {nombre === 'timon' && <><circle cx="12" cy="12" r="3.2" /><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v5.3M12 15.2v5.3M3.5 12h5.3M15.2 12h5.3M6 6l3.8 3.8M14.2 14.2 18 18M18 6l-3.8 3.8M9.8 14.2 6 18" /></>}
  {nombre === 'usuarios' && <><circle cx="9" cy="8" r="3" /><path d="M3.8 20v-1.6a5.2 5.2 0 0 1 10.4 0V20" /><path d="M16 5.4a3 3 0 0 1 0 5.2M18.4 20v-1.6a5.2 5.2 0 0 0-2.5-4.5" /></>}
  {nombre === 'buscar' && <><circle cx="10.7" cy="10.7" r="6.2" /><path d="m16 16 4.2 4.2" /></>}
  {nombre === 'alberca' && <><path d="M3 8v5M7 4v9M3 12h4" /><path d="M2 17c1.4 0 1.4 1 2.8 1s1.4-1 2.8-1 1.4 1 2.8 1 1.4-1 2.8-1 1.4 1 2.8 1 1.4-1 2.8-1" /><path d="M2 21c1.4 0 1.4-1 2.8-1s1.4 1 2.8 1 1.4-1 2.8-1 1.4 1 2.8 1 1.4-1 2.8-1 1.4 1 2.8 1" /></>}
  {nombre === 'mascota' && <><circle cx="7" cy="9" r="1.5" /><circle cx="12" cy="6.5" r="1.5" /><circle cx="17" cy="9" r="1.5" /><path d="M8 18c0-3 2-5 4-5s4 2 4 5c0 1.5-1 2-2.1 1.3-.8-.5-1.1-.8-1.9-.8s-1.1.3-1.9.8C9 20 8 19.5 8 18Z" /></>}
  {nombre === 'olas' && <><path d="M2 8c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2" /><path d="M2 13c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2" /><path d="M2 18c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2" /></>}
  {nombre === 'grupos' && <><circle cx="8" cy="8" r="2.6" /><circle cx="16.5" cy="8.6" r="2.1" /><path d="M3.5 19v-1.2a4.5 4.5 0 0 1 9 0V19M14.2 15.3a3.6 3.6 0 0 1 5.8 2.9V19" /></>}
  {nombre === 'estacionamiento' && <><circle cx="12" cy="12" r="9" /><path d="M9 16V8h3.6a2.4 2.4 0 0 1 0 4.8H9" /></>}
  {nombre === 'wifi' && <><path d="M3.5 9.5a13 13 0 0 1 17 0M6.5 13a8.5 8.5 0 0 1 11 0M9.5 16.5a4.2 4.2 0 0 1 5 0" /><path d="M12 20h.01" /></>}
  {nombre === 'aire' && <><path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7M6.8 3.8 17.2 20.2M17.2 3.8 6.8 20.2" /></>}
  {nombre === 'cama' && <><path d="M3 19V8M21 19v-6a3 3 0 0 0-3-3H3" /><path d="M3 14h18M6 10h4a2 2 0 0 1 2 2v2H6Z" /></>}
  {nombre === 'cubiertos' && <><path d="M6 3v7M3.5 3v4a2.5 2.5 0 0 0 5 0V3M6 10v11M16 3v18M16 3c2.2 1.2 3.5 3 3.5 5H16" /></>}
  {nombre === 'actividad' && <><circle cx="14.2" cy="4.5" r="1.8" /><path d="m11.6 10 2.4-2.6 2.6 2.1 3 .8M13.5 9.1l-2.8 3.4 2.5 2.2-1.8 5M10.7 12.5l-4.4 1.6M13.2 14.7l4.3 2.7" /></>}
  {nombre === 'idea' && <><path d="M9 18h6M10 22h4M8.5 14.5C7.5 13.5 7 12.1 7 10.5a5 5 0 0 1 10 0c0 1.6-.5 3-1.5 4-.8.9-1.4 1.4-1.5 2.5h-4c-.1-1.1-.7-1.6-1.5-2.5Z" /><path d="M12 2V1M4.9 4.9l-.7-.7M19.1 4.9l.7-.7" /></>}
  {nombre === 'brujula' && <><circle cx="12" cy="12" r="9" /><path d="m15.8 8.2-2 5.6-5.6 2 2-5.6 5.6-2Z" /></>}
  {nombre === 'corazon' && <path d="M20.8 8.7c0 5-8.8 10.5-8.8 10.5S3.2 13.7 3.2 8.7A4.7 4.7 0 0 1 12 6.3a4.7 4.7 0 0 1 8.8 2.4Z" />}
  {nombre === 'comparar' && <><rect x="4" y="4" width="7" height="7" rx="1" /><rect x="13" y="13" width="7" height="7" rx="1" /><path d="m11 8 3 3M13 13l-2-2" /></>}
  {nombre === 'avion' && <path d="m21 3-7.5 18-3.6-7-6.9-3.5L21 3Zm-11.1 11L14 10" />}
  {nombre === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
</svg>
