---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { CATALOGO_DISTANCIAS, formatearDistanciaCompacta } from '../utils/catalogoDistancias';

interface Props {
  negocio: CollectionEntry<'negocios'>;
  esPrimera?: boolean;
  // Resultado de los chips de filtro de la página que use esta tarjeta
  // (ej. /hospedaje) — se vuelca como atributos data-filtro-<clave> para
  // que el JS de la página filtre sin tener que volver a calcular nada.
  // Opcional: páginas que no tienen chips (ej. home) no lo pasan.
  filtros?: Record<string, boolean>;
}

const { negocio, esPrimera = false, filtros = {} } = Astro.props;
const atributosFiltro = Object.fromEntries(
  Object.entries(filtros).map(([clave, valor]) => [`data-filtro-${clave}`, valor ? '1' : '0']),
);
const {
  categoria,
  nombre,
  fotos,
  destacado,
  verificado,
  servicios,
  telefono,
  numeroHabitaciones,
  capacidadMaxima,
  distancias,
  tipo,
  subtipo,
  ordenManual,
  confirmadoFecha,
} = negocio.data;
const portada = fotos[0];
const distanciaTarjeta = distancias?.[0];
const enlace = `/${categoria}/${negocio.id}`;
const enlaceAbsoluto = new URL(enlace, Astro.site).toString();

// Nombre corto de categoría para la etiqueta de la tarjeta — mismo
// mapeo que usa la ficha del negocio ([categoria]/[negocio].astro).
const NOMBRE_CATEGORIA: Record<string, string> = {
  hospedaje: 'Hospedaje',
  gastronomia: 'Gastronomía',
  actividades: 'Actividades',
  servicios: 'Servicios',
};
// En hospedaje se muestra el subtipo específico (Hotel, Posada, etc.)
// en vez de la categoría genérica — solo si el .yaml lo trae; si no,
// no se muestra nada ahí (sin dejar hueco).
const etiquetaCategoria = categoria === 'hospedaje' ? subtipo : NOMBRE_CATEGORIA[categoria];

// Línea de datos: habitaciones primero (si existe el dato), si no se usa la
// distancia como gancho; luego se agrega el primer servicio real del negocio.
// Cualquier parte ausente se omite sin dejar un hueco ("·" suelto).
//
// El NÚMERO DE PERSONAS iba primero y se quitó por decisión de Hector: no
// aparece en ninguna presentación de tarjeta, solo dentro de la ficha. En un
// hotel el número confunde ("62 personas" no significa que renten el hotel
// entero) y dejarlo dentro da un motivo para abrir la ficha.
const datosLinea: string[] = [];
if (numeroHabitaciones !== undefined) {
  datosLinea.push(`🛏️ ${numeroHabitaciones}`);
} else if (distanciaTarjeta) {
  datosLinea.push(
    `${CATALOGO_DISTANCIAS[distanciaTarjeta.a].icono} ${formatearDistanciaCompacta(distanciaTarjeta)}`,
  );
}
if (servicios[0]) datosLinea.push(servicios[0]);
const lineaDatos = datosLinea.join(' · ');

const telefonoDigitos = telefono.replace(/[^\d]/g, '');
const telefonoWhatsapp = telefono.trim().startsWith('+1')
  ? telefonoDigitos
  : `521${telefonoDigitos.replace(/^52/, '')}`;
const enlaceWhatsapp = `https://wa.me/${telefonoWhatsapp}?text=${encodeURIComponent(
  `Hola, vi ${nombre} en el directorio de ${enlaceAbsoluto} y me gustaría más información.`,
)}`;
---

<article
  class="tarjeta-compacta"
  data-slug={negocio.id}
  data-destacado={destacado ? 'true' : 'false'}
  data-tipo={tipo ?? ''}
  data-orden-manual={ordenManual ?? ''}
  data-nombre={nombre}
  {...atributosFiltro}
>
  <a class="tarjeta-compacta__enlace" href={enlace} tabindex="-1" aria-hidden="true">
    <Image
      class="tarjeta-compacta__imagen"
      src={portada.src}
      alt={portada.alt}
      loading={esPrimera ? 'eager' : 'lazy'}
      fetchpriority={esPrimera ? 'high' : 'auto'}
      width={400}
      height={500}
      widths={[300, 400, 600]}
      sizes="(max-width: 560px) 50vw, (max-width: 1024px) 33vw, 200px"
    />
  </a>
  <div class="tarjeta-compacta__degradado" aria-hidden="true"></div>

  {
    (destacado || verificado) && (
      <div class="tarjeta-compacta__insignias">
        {destacado && <span class="tarjeta-compacta__insignia tarjeta-compacta__insignia--destacado">★ Destacado</span>}
        {verificado && <span class="tarjeta-compacta__insignia tarjeta-compacta__insignia--verificado">✓ Verificado</span>}
      </div>
    )
  }

  <button type="button" class="tarjeta-compacta__favorito" aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path d="M12 21s-6.7-4.35-9.3-8.1C1 10.4 1.4 7 4.2 5.6c2.2-1.1 4.6-.3 5.8 1.5.4.6.7 1.2 1 1.8.3-.6.6-1.2 1-1.8 1.2-1.8 3.6-2.6 5.8-1.5C20.6 7 21 10.4 19.3 12.9 16.7 16.65 12 21 12 21z" />
    </svg>
  </button>

  <div class="tarjeta-compacta__info">
    {etiquetaCategoria && <span class="tarjeta-compacta__categoria">{etiquetaCategoria}</span>}
    <h3 class="tarjeta-compacta__nombre"><a href={enlace}>{nombre}</a></h3>
    {lineaDatos && <p class="tarjeta-compacta__datos">{lineaDatos}</p>}
    {confirmadoFecha && <p class="tarjeta-compacta__confirmado">✓ Confirmado {confirmadoFecha}</p>}
  </div>

  <a
    class="tarjeta-compacta__whatsapp"
    href={enlaceWhatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Escribir a ${nombre} por WhatsApp`}
    {...(categoria === 'hospedaje' ? { 'data-consulta-hospedaje': '', 'data-consulta-nombre': nombre, 'data-consulta-whatsapp': telefonoWhatsapp } : {})}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .8.8-2.93-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.13c-.25-.12-1.45-.72-1.68-.8-.22-.08-.39-.12-.55.13-.16.25-.63.8-.78.96-.14.16-.29.18-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.12.25-.29.37-.44.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42-.14 0-.3-.02-.47-.02s-.44.06-.67.31c-.22.25-.87.85-.87 2.08 0 1.22.9 2.41 1.02 2.57.12.16 1.77 2.7 4.29 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.45-.6 1.66-1.17.2-.58.2-1.08.14-1.18-.06-.1-.22-.16-.47-.28z" />
    </svg>
  </a>
</article>

<style>
  .tarjeta-compacta {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio, 16px);
    overflow: hidden;
    background: var(--color-arena-oscura, #ecdfc4);
    isolation: isolate;
  }

  .tarjeta-compacta__enlace {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }

  .tarjeta-compacta__imagen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tarjeta-compacta__degradado {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 30, 33, 0) 0%,
      rgba(7, 30, 33, 0) 42%,
      rgba(7, 30, 33, 0.55) 68%,
      rgba(7, 30, 33, 0.9) 100%
    );
  }

  .tarjeta-compacta__insignias {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-start;
    pointer-events: none;
  }

  .tarjeta-compacta__insignia {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .tarjeta-compacta__insignia--destacado {
    background: var(--color-foco, #ffb020);
    color: var(--color-tinta, #0c2b2e);
  }

  .tarjeta-compacta__insignia--verificado {
    background: var(--color-blanco, #fff);
    color: var(--color-turquesa, #0b6f7a);
  }

  .tarjeta-compacta__favorito {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 4;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: var(--color-blanco, #fff);
    color: var(--color-coral, #ff7a5c);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
  }

  .tarjeta-compacta__info {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 52px;
    z-index: 3;
    padding: 0.6rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    pointer-events: none;
  }

  .tarjeta-compacta__info a {
    pointer-events: auto;
  }

  .tarjeta-compacta__categoria {
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #ffc9b8;
    /* El degradado nuevo deja casi transparente la zona donde cae esta
       etiqueta (ver .tarjeta-compacta__degradado) — en fotos claras
       (Casa Vacacional Orquídeas, Hotel Valeria) el texto medía por
       debajo de AA sin esto. */
    text-shadow: 0 1px 3px rgba(7, 30, 33, 0.9), 0 1px 6px rgba(7, 30, 33, 0.6);
  }

  .tarjeta-compacta__nombre {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-weight: 900;
    font-size: 0.95rem;
    line-height: 1.15;
    color: var(--color-blanco, #fff);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  .tarjeta-compacta__nombre a {
    color: inherit;
    text-decoration: none;
  }

  .tarjeta-compacta__nombre a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tarjeta-compacta__datos,
  .tarjeta-compacta__confirmado {
    margin: 0;
    font-size: 0.72rem;
    color: var(--color-blanco, #fff);
  }

  .tarjeta-compacta__confirmado {
    color: #8fe0d6;
    font-weight: 700;
  }

  .tarjeta-compacta__whatsapp {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 5;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-whatsapp, #157a3d);
    color: var(--color-blanco, #fff);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
