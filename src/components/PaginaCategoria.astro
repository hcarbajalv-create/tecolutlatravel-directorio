---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from './NegocioCard.astro';
import Icono from './Icono.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';
import { filtrarListables } from '../utils/negociosPublicados';

interface Props {
  // "hospedaje" ya no pasa por este componente — tiene su propia
  // plantilla en src/pages/hospedaje.astro (rediseño Fase 1, Tarea 2).
  categoria: 'gastronomia' | 'actividades' | 'servicios';
  icono: string;
  claseColor: string;
  // Con emoji — es lo que va en <title> (BaseLayout), donde ayuda a que
  // el resultado resalte en Google. NO es lo que se ve en el H1 de la
  // página: eso es tituloVisible, sin emoji (ver abajo).
  titulo: string;
  // Mismo texto que "titulo" pero sin el emoji inicial — para el H1
  // visible. El emoji era una indicación para el <title> de Google, no
  // para el encabezado que ve el visitante.
  tituloVisible: string;
  descripcionSeo: string;
  introduccion: string;
}

const { categoria, icono, claseColor, titulo, tituloVisible, descripcionSeo, introduccion } =
  Astro.props;

const todos = filtrarListables(await getCollection('negocios'));
const negociosFiltrados = todos.filter((n) => n.data.categoria === categoria);

// Destacados: van primero como grupo, pero SIN ordenar por puntaje entre
// ellos — todos pagan lo mismo, así que el orden entre ellos se decide en
// el navegador (ver script abajo), rotando cada día, para que todos tengan
// la misma oportunidad de aparecer arriba. El orden manual sigue ganando
// sobre eso si el dueño del sitio lo define.
const destacados = negociosFiltrados
  .filter((n) => n.data.destacado)
  .sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));

// Gratuitos: sin cambios — se ordenan por puntaje de completitud (o manual).
const gratuitos = negociosFiltrados
  .filter((n) => !n.data.destacado)
  .sort(compararDentroDeGrupo);

const negociosCategoria = [...destacados, ...gratuitos];

// Una categoría con cero negocios es contenido pobre para Google —
// se le pone noindex automáticamente mientras esté vacía. Se calcula
// del conteo real en cada build, nada escrito a mano: en cuanto entra
// el primer negocio de la categoría, el noindex desaparece solo. La
// categoría sigue viéndose normal en el menú y en la home — esto solo
// cambia la etiqueta <meta name="robots">, no el contenido visible.
const categoriaVacia = negociosCategoria.length === 0;
const esGastronomia = categoria === 'gastronomia';
const esActividades = categoria === 'actividades';
// Banner editorial de Gastronomía: se mantiene independiente de las fotos
// de los negocios para que el encabezado no cambie al rotar el catálogo.
const portadaGastronomia = {
  src: '/images/banner-gastronomia-restaurante-rio.png',
  alt: 'Restaurante junto al río de Tecolutla con platillos de mariscos al atardecer',
};
function filtrosGastronomia(negocio: (typeof negociosCategoria)[number]) {
  const servicios = (negocio.data.servicios ?? []).map((s) => s.toLocaleLowerCase('es-MX'));
  const distancias = negocio.data.distancias ?? [];
  return {
    rio: distancias.some((d) => d.a === 'rio'),
    embarcadero: servicios.some((s) => s.includes('embarcadero')) || distancias.some((d) => d.a === 'embarcadero'),
    terraza: servicios.some((s) => s.includes('terraza')),
  };
}

const ETIQUETAS_BUSQUEDA: Record<typeof categoria, string> = {
  gastronomia: 'restaurantes',
  actividades: 'actividades',
  servicios: 'servicios',
};
const etiquetaBusqueda = ETIQUETAS_BUSQUEDA[categoria];

// Mismo orden que se ve en pantalla al cargar la página (destacados
// primero) — el orden EXACTO entre destacados rota a diario en el
// navegador (ver script abajo), pero el JSON-LD que lee Google es
// estático y no puede seguir esa rotación; se ancla al orden del
// primer render, que es coherente y siempre pone destacados primero.
const esquemaItemList =
  negociosCategoria.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: negociosCategoria.map((negocio, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `https://tecolutlatravel.mx/${categoria}/${negocio.id}`,
          name: negocio.data.nombre,
        })),
      }
    : null;
---

<BaseLayout titulo={titulo} descripcion={descripcionSeo} noindex={categoriaVacia}>
  {esquemaItemList && <script type="application/ld+json" set:html={JSON.stringify(esquemaItemList)} />}
  {
    esGastronomia && portadaGastronomia && (
      <section class="categoria-hero categoria-hero--gastronomia">
        <img src={portadaGastronomia.src} alt={portadaGastronomia.alt} loading="eager" />
        <div class="categoria-hero__velo" aria-hidden="true"></div>
        <div class="contenedor categoria-hero__contenido">
          <p class="migaja"><a href="/">Inicio</a> → Gastronomía</p>
          <h1>Descubre dónde comer en Tecolutla</h1>
          <p>Mariscos frescos, cocina local y lugares con vista al río.</p>
          <div class="categoria-hero__beneficios">
            <span><Icono nombre="whatsapp" /> WhatsApp directo</span>
            <span><Icono nombre="cubiertos" /> Cocina local</span>
            <span><Icono nombre="escudo" /> Negocios verificados</span>
          </div>
        </div>
      </section>
    )
  }
  {
    esActividades && (
      <section class="categoria-hero categoria-hero--actividades">
        <img src="/images/tile-actividades-lancha-manglar.png" alt="Lancha recorriendo los manglares de Tecolutla" loading="eager" />
        <div class="categoria-hero__velo" aria-hidden="true"></div>
        <div class="contenedor categoria-hero__contenido">
          <p class="migaja"><a href="/">Inicio</a> → Actividades</p>
          <h1>Vive Tecolutla a tu manera</h1>
          <p>Tours auténticos entre ríos, manglares y playa. Elige tu experiencia y conéctate con lo natural.</p>
          <div class="categoria-hero__beneficios">
            <span><Icono nombre="actividad" /> Experiencias locales</span>
            <span><Icono nombre="ubicacion" /> Puntos de encuentro claros</span>
            <span><Icono nombre="whatsapp" /> Reserva directa</span>
          </div>
        </div>
      </section>
    )
  }
  <section class={`cabecera-categoria ${claseColor}`}>
    <div class="contenedor">
      <div class="cabecera-categoria__titulo">
        <span class="cabecera-categoria__icono">{icono}</span>
        <h1>{tituloVisible}</h1>
      </div>
      <p>{introduccion}</p>
    </div>
  </section>

  <section class={`seccion contenedor categoria-catalogo ${esGastronomia ? 'categoria-catalogo--gastronomia destacados-propuesta' : ''} ${esActividades ? 'categoria-catalogo--actividades' : ''}`}>
    <div class="categoria-catalogo__encabezado">
      <div>
        <h2 class="titulo-seccion" style="margin-bottom:0.35rem;">{esGastronomia ? 'Dónde comer' : esActividades ? 'Encuentra tu próxima aventura' : 'Negocios en esta categoría'}</h2>
        {esActividades && <p class="categoria-catalogo__subtitulo">Experiencias locales para disfrutar Tecolutla a tu ritmo.</p>}
      </div>
      {esActividades && <span class="categoria-catalogo__contador">{negociosCategoria.length} experiencias</span>}
    </div>
    {
      esGastronomia && (
        <button type="button" class="filtros-ayuda__boton categoria-ayuda" data-abrir-ayuda>
          <span aria-hidden="true">?</span> ¿Qué significan los iconos?
        </button>
      )
    }
    {
      negociosCategoria.length > 0 && (
        <div class="negocios-controles">
          <div class="buscador-categoria">
            <label for="buscador-categoria-input" class="buscador-categoria__etiqueta">
              Buscar {etiquetaBusqueda} por nombre
            </label>
            <div class="buscador-categoria__campo">
              <svg
                class="buscador-categoria__icono"
                viewBox="0 0 20 20"
                width="16"
                height="16"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <circle cx="8.5" cy="8.5" r="6" />
                <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round" />
              </svg>
              <input
                type="search"
                id="buscador-categoria-input"
                class="buscador-categoria__input"
                placeholder={`Buscar ${etiquetaBusqueda}…`}
                autocomplete="off"
              />
            </div>
          </div>
        </div>
      )
    }
    {
      esGastronomia && negociosCategoria.length > 0 && (
            <div class="fila-chips categoria-chips" id="fila-chips-categoria" aria-label="Filtros de gastronomía">
          <button type="button" class="filtro-rapido filtro-rapido--activo" data-chip="todo"><Icono nombre="cubiertos" /> Todo</button>
          <button type="button" class="filtro-rapido" data-chip="rio"><Icono nombre="olas" /> A pie de río</button>
          <button type="button" class="filtro-rapido" data-chip="embarcadero"><Icono nombre="ubicacion" /> Cerca del embarcadero</button>
          <button type="button" class="filtro-rapido" data-chip="terraza"><Icono nombre="cama" /> Terraza</button>
            </div>
      )
    }
    {
      negociosCategoria.length === 0 ? (
        <p>
          Todavía no hay negocios publicados en esta categoría.{' '}
          <a href="/anunciate">Anúnciate aquí</a> si tienes un negocio en Tecolutla.
        </p>
      ) : (
        <div class="rejilla-negocios" id="rejilla-negocios">
          {negociosCategoria.map((negocio, i) => (
            <NegocioCard negocio={negocio} esPrimera={i === 0} filtros={esGastronomia ? filtrosGastronomia(negocio) : {}} />
          ))}
        </div>
      )
    }
    <p id="mensaje-filtro-vacio" class="filtro-tipo__vacio" hidden>
      Todavía no hay negocios de este tipo.
    </p>
    {
      esGastronomia && (
        <dialog class="filtros-ayuda" data-ayuda-iconos aria-labelledby="titulo-ayuda-gastronomia">
          <div class="filtros-ayuda__cabecera">
            <h2 id="titulo-ayuda-gastronomia">Cómo leer las fichas</h2>
            <button type="button" class="filtros-ayuda__cerrar" data-cerrar-ayuda aria-label="Cerrar ayuda">×</button>
          </div>
          <div class="filtros-ayuda__lista">
            <span><Icono nombre="cubiertos" /><b>Tipo de cocina</b><small>Especialidad confirmada del negocio.</small></span>
            <span><Icono nombre="olas" /><b>A pie de río</b><small>El negocio está junto al río.</small></span>
            <span><Icono nombre="ubicacion" /><b>Ubicación</b><small>Referencia de distancia registrada.</small></span>
            <span><Icono nombre="whatsapp" /><b>WhatsApp</b><small>Contacto directo con el restaurante.</small></span>
            <span><Icono nombre="corazon" /><b>Favorito</b><small>Guarda la ficha para verla después.</small></span>
            <span><Icono nombre="comparar" /><b>Comparar</b><small>Permite comparar este negocio con otros.</small></span>
          </div>
        </dialog>
      )
    }
  </section>
</BaseLayout>

<script>
  const ayudaCategoria = document.querySelector<HTMLDialogElement>('[data-ayuda-iconos]');
  document.querySelector('[data-abrir-ayuda]')?.addEventListener('click', () => ayudaCategoria?.showModal());
  document.querySelector('[data-cerrar-ayuda]')?.addEventListener('click', () => ayudaCategoria?.close());
  function hashDiario(semilla: string): number {
    let hash = 5381;
    for (let i = 0; i < semilla.length; i++) {
      hash = (hash * 33) ^ semilla.charCodeAt(i);
    }
    return hash >>> 0;
  }

  // Los destacados se muestran siempre primero como grupo, pero el orden
  // entre ellos se decide aquí (no en el build) para que rote de verdad
  // cada día calendario, sin depender de que el sitio se vuelva a publicar.
  function rotarDestacados() {
    const contenedor = document.getElementById('rejilla-negocios');
    if (!contenedor) return;

    const tarjetas = Array.from(contenedor.children) as HTMLElement[];
    const destacadas = tarjetas.filter((t) => t.dataset.destacado === 'true');
    const limite = tarjetas.find((t) => t.dataset.destacado === 'false') ?? null;

    const hoy = new Date().toISOString().slice(0, 10);
    const fijas = destacadas.filter((t) => t.dataset.ordenManual);
    const aleatorias = destacadas.filter((t) => !t.dataset.ordenManual);
    aleatorias.sort(
      (a, b) =>
        hashDiario(`${hoy}-${a.dataset.slug}`) - hashDiario(`${hoy}-${b.dataset.slug}`),
    );

    for (const tarjeta of [...fijas, ...aleatorias]) {
      if (limite) contenedor.insertBefore(tarjeta, limite);
      else contenedor.appendChild(tarjeta);
    }

    // La rotación diaria cambia cuál tarjeta queda primera de verdad en
    // pantalla — el "esPrimera" que decide el servidor (para cargar esa
    // imagen con prioridad, sección de rendimiento) casi nunca coincide
    // con el resultado real después de esto. Se corrige aquí: la que
    // termine primera pasa a "eager"/alta prioridad, y si el servidor le
    // había dado esa prioridad a otra tarjeta que ya no quedó primera, se
    // le quita (aunque su descarga ya haya empezado, no tiene caso seguir
    // tratándola como si fuera la más importante de la página).
    const actualizarPrioridadImagen = (tarjeta: HTMLElement, esLaPrimera: boolean) => {
      const img = tarjeta.querySelector<HTMLImageElement>('.tarjeta__imagen');
      if (!img) return;
      img.loading = esLaPrimera ? 'eager' : 'lazy';
      if (esLaPrimera) img.setAttribute('fetchpriority', 'high');
      else img.removeAttribute('fetchpriority');
    };
    // Se vuelve a leer el DOM (no se reusa "tarjetas") porque ese array
    // se capturó ANTES del reordenamiento de arriba — ya no refleja el
    // orden final real.
    Array.from(contenedor.children).forEach((tarjeta, i) =>
      actualizarPrioridadImagen(tarjeta as HTMLElement, i === 0),
    );
  }

  // Búsqueda por nombre dentro de la categoría.
  function activarControles() {
    const contenedor = document.getElementById('rejilla-negocios');
    if (!contenedor) return;
    const mensajeVacio = document.getElementById('mensaje-filtro-vacio');
    const filaChips = document.getElementById('fila-chips-categoria');
    const buscadorInput = document.getElementById(
      'buscador-categoria-input',
    ) as HTMLInputElement | null;

    function normalizar(texto: string): string {
      return texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function aplicarFiltros() {
      const consulta = normalizar(buscadorInput?.value ?? '');
      const chipActivo = filaChips?.querySelector<HTMLButtonElement>('.filtro-rapido--activo')?.dataset.chip ?? 'todo';
      let visibles = 0;

      contenedor?.querySelectorAll<HTMLElement>('.tarjeta').forEach((tarjeta) => {
        const coincideNombre = !consulta || normalizar(tarjeta.dataset.nombre ?? '').includes(consulta);
        const coincideChip = chipActivo === 'todo' || tarjeta.getAttribute(`data-filtro-${chipActivo}`) === '1';
        const mostrar = coincideNombre && coincideChip;
        tarjeta.style.display = mostrar ? '' : 'none';
        if (mostrar) visibles++;
      });

      if (mensajeVacio) {
        mensajeVacio.hidden = visibles > 0;
        mensajeVacio.textContent = 'No encontramos negocios con ese nombre.';
      }
    }

    buscadorInput?.addEventListener('input', aplicarFiltros);
    filaChips?.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((boton) => {
      boton.addEventListener('click', () => {
        filaChips.querySelectorAll('.filtro-rapido').forEach((b) => b.classList.remove('filtro-rapido--activo'));
        boton.classList.add('filtro-rapido--activo');
        aplicarFiltros();
      });
    });
  }

  rotarDestacados();
  activarControles();
</script>
