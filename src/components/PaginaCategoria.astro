---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from './NegocioCard.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';

interface Props {
  categoria: 'hospedaje' | 'gastronomia' | 'actividades' | 'servicios';
  icono: string;
  claseColor: string;
  titulo: string;
  descripcionSeo: string;
  introduccion: string;
}

const { categoria, icono, claseColor, titulo, descripcionSeo, introduccion } = Astro.props;

const todos = await getCollection('negocios');
const negociosFiltrados = todos.filter((n) => n.data.categoria === categoria);

// Destacados: van primero como grupo, pero SIN ordenar por puntaje entre
// ellos — todos pagan lo mismo, así que el orden entre ellos se decide en
// el navegador (ver script abajo), rotando cada día, para que todos tengan
// la misma oportunidad de aparecer arriba. El orden manual sigue ganando
// sobre eso si el dueño del sitio lo define.
const destacados = negociosFiltrados
  .filter((n) => n.data.destacado)
  .sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));

// Gratuitos: sin cambios — se ordenan por puntaje de completitud (o manual).
const gratuitos = negociosFiltrados
  .filter((n) => !n.data.destacado)
  .sort(compararDentroDeGrupo);

const negociosCategoria = [...destacados, ...gratuitos];

const mostrarFiltroTipo = categoria === 'hospedaje';
const tiposFiltro: { valor: string; etiqueta: string }[] = [
  { valor: 'casa', etiqueta: 'Casas completas' },
  { valor: 'hotel', etiqueta: 'Hoteles' },
  { valor: 'cuarto', etiqueta: 'Cuartos / habitaciones' },
];

const ETIQUETAS_BUSQUEDA: Record<typeof categoria, string> = {
  hospedaje: 'hoteles y casas',
  gastronomia: 'restaurantes',
  actividades: 'actividades',
  servicios: 'servicios',
};
const etiquetaBusqueda = ETIQUETAS_BUSQUEDA[categoria];
---

<BaseLayout titulo={titulo} descripcion={descripcionSeo}>
  <section class={`cabecera-categoria ${claseColor}`}>
    <div class="contenedor">
      <div class="cabecera-categoria__titulo">
        <span class="cabecera-categoria__icono">{icono}</span>
        <h1>{titulo}</h1>
      </div>
      <p>{introduccion}</p>
    </div>
  </section>

  <section class="seccion contenedor">
    <h2 class="titulo-seccion" style="margin-bottom:1.25rem;">Negocios en esta categoría</h2>
    {
      negociosCategoria.length > 0 && (
        <div class="negocios-controles">
          {mostrarFiltroTipo && (
            <div class="filtro-tipo" id="filtro-tipo">
              <button type="button" class="pastilla pastilla--activa" data-tipo-filtro="todos">
                Todos
              </button>
              {tiposFiltro.map((t) => (
                <button type="button" class="pastilla" data-tipo-filtro={t.valor}>
                  {t.etiqueta}
                </button>
              ))}
            </div>
          )}
          <div class="buscador-categoria">
            <label for="buscador-categoria-input" class="sr-only">
              Buscar {etiquetaBusqueda} por nombre
            </label>
            <input
              type="search"
              id="buscador-categoria-input"
              class="buscador-categoria__input"
              placeholder={`Buscar ${etiquetaBusqueda}…`}
              autocomplete="off"
            />
          </div>
        </div>
      )
    }
    {
      negociosCategoria.length === 0 ? (
        <p>
          Todavía no hay negocios publicados en esta categoría.{' '}
          <a href="/anunciate">Anúnciate aquí</a> si tienes un negocio en Tecolutla.
        </p>
      ) : (
        <div class="rejilla-negocios" id="rejilla-negocios">
          {negociosCategoria.map((negocio) => (
            <NegocioCard negocio={negocio} />
          ))}
        </div>
      )
    }
    <p id="mensaje-filtro-vacio" class="filtro-tipo__vacio" hidden>
      Todavía no hay negocios de este tipo.
    </p>
  </section>
</BaseLayout>

<script>
  function hashDiario(semilla: string): number {
    let hash = 5381;
    for (let i = 0; i < semilla.length; i++) {
      hash = (hash * 33) ^ semilla.charCodeAt(i);
    }
    return hash >>> 0;
  }

  // Los destacados se muestran siempre primero como grupo, pero el orden
  // entre ellos se decide aquí (no en el build) para que rote de verdad
  // cada día calendario, sin depender de que el sitio se vuelva a publicar.
  function rotarDestacados() {
    const contenedor = document.getElementById('rejilla-negocios');
    if (!contenedor) return;

    const tarjetas = Array.from(contenedor.children) as HTMLElement[];
    const destacadas = tarjetas.filter((t) => t.dataset.destacado === 'true');
    const limite = tarjetas.find((t) => t.dataset.destacado === 'false') ?? null;

    const hoy = new Date().toISOString().slice(0, 10);
    const fijas = destacadas.filter((t) => t.dataset.ordenManual);
    const aleatorias = destacadas.filter((t) => !t.dataset.ordenManual);
    aleatorias.sort(
      (a, b) =>
        hashDiario(`${hoy}-${a.dataset.slug}`) - hashDiario(`${hoy}-${b.dataset.slug}`),
    );

    for (const tarjeta of [...fijas, ...aleatorias]) {
      if (limite) contenedor.insertBefore(tarjeta, limite);
      else contenedor.appendChild(tarjeta);
    }
  }

  // Combina el filtro de tipo (pastillas, solo hospedaje) con la búsqueda
  // por nombre (todas las categorías) — una tarjeta se muestra solo si
  // cumple los dos a la vez.
  function activarControles() {
    const contenedor = document.getElementById('rejilla-negocios');
    if (!contenedor) return;
    const filtro = document.getElementById('filtro-tipo');
    const mensajeVacio = document.getElementById('mensaje-filtro-vacio');
    const buscadorInput = document.getElementById(
      'buscador-categoria-input',
    ) as HTMLInputElement | null;

    function normalizar(texto: string): string {
      return texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function tipoActivo(): string {
      return filtro?.querySelector('[data-tipo-filtro].pastilla--activa')
        ?.getAttribute('data-tipo-filtro') ?? 'todos';
    }

    function aplicarFiltros() {
      const tipo = tipoActivo();
      const consulta = normalizar(buscadorInput?.value ?? '');
      let visibles = 0;

      contenedor?.querySelectorAll<HTMLElement>('.tarjeta').forEach((tarjeta) => {
        const coincideTipo = tipo === 'todos' || tarjeta.dataset.tipo === tipo;
        const coincideBusqueda =
          !consulta || normalizar(tarjeta.dataset.nombre ?? '').includes(consulta);
        const mostrar = coincideTipo && coincideBusqueda;
        tarjeta.style.display = mostrar ? '' : 'none';
        if (mostrar) visibles++;
      });

      if (mensajeVacio) {
        mensajeVacio.hidden = visibles > 0;
        mensajeVacio.textContent = consulta
          ? 'No encontramos negocios con ese nombre.'
          : 'Todavía no hay negocios de este tipo.';
      }
    }

    filtro?.querySelectorAll<HTMLButtonElement>('[data-tipo-filtro]').forEach((boton) => {
      boton.addEventListener('click', () => {
        filtro
          .querySelectorAll('[data-tipo-filtro]')
          .forEach((b) => b.classList.remove('pastilla--activa'));
        boton.classList.add('pastilla--activa');
        aplicarFiltros();
      });
    });

    buscadorInput?.addEventListener('input', aplicarFiltros);
  }

  rotarDestacados();
  activarControles();
</script>
