---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NegocioCard from './NegocioCard.astro';
import { compararDentroDeGrupo } from '../utils/puntajeCompletitud';

interface Props {
  // "hospedaje" ya no pasa por este componente — tiene su propia
  // plantilla en src/pages/hospedaje.astro (rediseño Fase 1, Tarea 2).
  categoria: 'gastronomia' | 'actividades' | 'servicios';
  icono: string;
  claseColor: string;
  titulo: string;
  descripcionSeo: string;
  introduccion: string;
}

const { categoria, icono, claseColor, titulo, descripcionSeo, introduccion } = Astro.props;

const todos = await getCollection('negocios');
const negociosFiltrados = todos.filter((n) => n.data.categoria === categoria);

// Destacados: van primero como grupo, pero SIN ordenar por puntaje entre
// ellos — todos pagan lo mismo, así que el orden entre ellos se decide en
// el navegador (ver script abajo), rotando cada día, para que todos tengan
// la misma oportunidad de aparecer arriba. El orden manual sigue ganando
// sobre eso si el dueño del sitio lo define.
const destacados = negociosFiltrados
  .filter((n) => n.data.destacado)
  .sort((a, b) => (a.data.ordenManual ?? Infinity) - (b.data.ordenManual ?? Infinity));

// Gratuitos: sin cambios — se ordenan por puntaje de completitud (o manual).
const gratuitos = negociosFiltrados
  .filter((n) => !n.data.destacado)
  .sort(compararDentroDeGrupo);

const negociosCategoria = [...destacados, ...gratuitos];

// Una categoría con cero negocios es contenido pobre para Google —
// se le pone noindex automáticamente mientras esté vacía. Se calcula
// del conteo real en cada build, nada escrito a mano: en cuanto entra
// el primer negocio de la categoría, el noindex desaparece solo. La
// categoría sigue viéndose normal en el menú y en la home — esto solo
// cambia la etiqueta <meta name="robots">, no el contenido visible.
const categoriaVacia = negociosCategoria.length === 0;

const ETIQUETAS_BUSQUEDA: Record<typeof categoria, string> = {
  gastronomia: 'restaurantes',
  actividades: 'actividades',
  servicios: 'servicios',
};
const etiquetaBusqueda = ETIQUETAS_BUSQUEDA[categoria];

// Mismo orden que se ve en pantalla al cargar la página (destacados
// primero) — el orden EXACTO entre destacados rota a diario en el
// navegador (ver script abajo), pero el JSON-LD que lee Google es
// estático y no puede seguir esa rotación; se ancla al orden del
// primer render, que es coherente y siempre pone destacados primero.
const esquemaItemList =
  negociosCategoria.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: negociosCategoria.map((negocio, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `https://tecolutlatravel.mx/${categoria}/${negocio.id}`,
          name: negocio.data.nombre,
        })),
      }
    : null;
---

<BaseLayout titulo={titulo} descripcion={descripcionSeo} noindex={categoriaVacia}>
  {esquemaItemList && <script type="application/ld+json" set:html={JSON.stringify(esquemaItemList)} />}
  <section class={`cabecera-categoria ${claseColor}`}>
    <div class="contenedor">
      <div class="cabecera-categoria__titulo">
        <span class="cabecera-categoria__icono">{icono}</span>
        <h1>{titulo}</h1>
      </div>
      <p>{introduccion}</p>
    </div>
  </section>

  <section class="seccion contenedor">
    <h2 class="titulo-seccion" style="margin-bottom:1.25rem;">Negocios en esta categoría</h2>
    {
      negociosCategoria.length > 0 && (
        <div class="negocios-controles">
          <div class="buscador-categoria">
            <label for="buscador-categoria-input" class="buscador-categoria__etiqueta">
              Buscar {etiquetaBusqueda} por nombre
            </label>
            <div class="buscador-categoria__campo">
              <svg
                class="buscador-categoria__icono"
                viewBox="0 0 20 20"
                width="16"
                height="16"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <circle cx="8.5" cy="8.5" r="6" />
                <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round" />
              </svg>
              <input
                type="search"
                id="buscador-categoria-input"
                class="buscador-categoria__input"
                placeholder={`Buscar ${etiquetaBusqueda}…`}
                autocomplete="off"
              />
            </div>
          </div>
        </div>
      )
    }
    {
      negociosCategoria.length === 0 ? (
        <p>
          Todavía no hay negocios publicados en esta categoría.{' '}
          <a href="/anunciate">Anúnciate aquí</a> si tienes un negocio en Tecolutla.
        </p>
      ) : (
        <div class="rejilla-negocios" id="rejilla-negocios">
          {negociosCategoria.map((negocio, i) => (
            <NegocioCard negocio={negocio} esPrimera={i === 0} />
          ))}
        </div>
      )
    }
    <p id="mensaje-filtro-vacio" class="filtro-tipo__vacio" hidden>
      Todavía no hay negocios de este tipo.
    </p>
  </section>
</BaseLayout>

<script>
  function hashDiario(semilla: string): number {
    let hash = 5381;
    for (let i = 0; i < semilla.length; i++) {
      hash = (hash * 33) ^ semilla.charCodeAt(i);
    }
    return hash >>> 0;
  }

  // Los destacados se muestran siempre primero como grupo, pero el orden
  // entre ellos se decide aquí (no en el build) para que rote de verdad
  // cada día calendario, sin depender de que el sitio se vuelva a publicar.
  function rotarDestacados() {
    const contenedor = document.getElementById('rejilla-negocios');
    if (!contenedor) return;

    const tarjetas = Array.from(contenedor.children) as HTMLElement[];
    const destacadas = tarjetas.filter((t) => t.dataset.destacado === 'true');
    const limite = tarjetas.find((t) => t.dataset.destacado === 'false') ?? null;

    const hoy = new Date().toISOString().slice(0, 10);
    const fijas = destacadas.filter((t) => t.dataset.ordenManual);
    const aleatorias = destacadas.filter((t) => !t.dataset.ordenManual);
    aleatorias.sort(
      (a, b) =>
        hashDiario(`${hoy}-${a.dataset.slug}`) - hashDiario(`${hoy}-${b.dataset.slug}`),
    );

    for (const tarjeta of [...fijas, ...aleatorias]) {
      if (limite) contenedor.insertBefore(tarjeta, limite);
      else contenedor.appendChild(tarjeta);
    }

    // La rotación diaria cambia cuál tarjeta queda primera de verdad en
    // pantalla — el "esPrimera" que decide el servidor (para cargar esa
    // imagen con prioridad, sección de rendimiento) casi nunca coincide
    // con el resultado real después de esto. Se corrige aquí: la que
    // termine primera pasa a "eager"/alta prioridad, y si el servidor le
    // había dado esa prioridad a otra tarjeta que ya no quedó primera, se
    // le quita (aunque su descarga ya haya empezado, no tiene caso seguir
    // tratándola como si fuera la más importante de la página).
    const actualizarPrioridadImagen = (tarjeta: HTMLElement, esLaPrimera: boolean) => {
      const img = tarjeta.querySelector<HTMLImageElement>('.tarjeta__imagen');
      if (!img) return;
      img.loading = esLaPrimera ? 'eager' : 'lazy';
      if (esLaPrimera) img.setAttribute('fetchpriority', 'high');
      else img.removeAttribute('fetchpriority');
    };
    // Se vuelve a leer el DOM (no se reusa "tarjetas") porque ese array
    // se capturó ANTES del reordenamiento de arriba — ya no refleja el
    // orden final real.
    Array.from(contenedor.children).forEach((tarjeta, i) =>
      actualizarPrioridadImagen(tarjeta as HTMLElement, i === 0),
    );
  }

  // Búsqueda por nombre dentro de la categoría.
  function activarControles() {
    const contenedor = document.getElementById('rejilla-negocios');
    if (!contenedor) return;
    const mensajeVacio = document.getElementById('mensaje-filtro-vacio');
    const buscadorInput = document.getElementById(
      'buscador-categoria-input',
    ) as HTMLInputElement | null;

    function normalizar(texto: string): string {
      return texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function aplicarFiltros() {
      const consulta = normalizar(buscadorInput?.value ?? '');
      let visibles = 0;

      contenedor?.querySelectorAll<HTMLElement>('.tarjeta').forEach((tarjeta) => {
        const mostrar = !consulta || normalizar(tarjeta.dataset.nombre ?? '').includes(consulta);
        tarjeta.style.display = mostrar ? '' : 'none';
        if (mostrar) visibles++;
      });

      if (mensajeVacio) {
        mensajeVacio.hidden = visibles > 0;
        mensajeVacio.textContent = 'No encontramos negocios con ese nombre.';
      }
    }

    buscadorInput?.addEventListener('input', aplicarFiltros);
  }

  rotarDestacados();
  activarControles();
</script>
