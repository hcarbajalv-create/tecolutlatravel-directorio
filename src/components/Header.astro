---
import { getCollection } from 'astro:content';

interface Props {
  rutaActual: string;
}

const { rutaActual } = Astro.props;

const enlaces = [
  { href: '/hospedaje', texto: 'Hospedaje' },
  { href: '/gastronomia', texto: 'Gastronomía' },
  { href: '/actividades', texto: 'Actividades ecoturísticas' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/reportajes-y-noticias', texto: 'Reportajes y noticias' },
  { href: '/tips-para-tu-viaje', texto: 'Tips para tu viaje' },
  { href: '/descubre-tecolutla', texto: 'Descubre Tecolutla' },
  { href: '/contactanos', texto: 'Contáctanos' },
];

function esActiva(href: string) {
  return rutaActual === href || rutaActual.startsWith(`${href}/`);
}

// Índice ligero (nombre + categoría + slug) para el buscador de negocios —
// se resuelve en build time y se manda como JSON al cliente, que filtra ahí
// mismo. El catálogo es estático, no hace falta backend para esto.
const negocios = await getCollection('negocios');
const indiceBuscador = negocios.map((negocio) => ({
  nombre: negocio.data.nombre,
  categoria: negocio.data.categoria,
  slug: negocio.id,
}));
---

<header class="encabezado">
  <div class="encabezado__barra">
    <a href="/" class="encabezado__marca">
      <svg class="encabezado__marca-icono" viewBox="0 0 100 100" aria-hidden="true">
        <mask id="tt-ola-header" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
          <rect x="0" y="0" width="100" height="100" fill="#fff" />
          <path d="M14,36 Q26,24 38,36 Q50,48 62,36 Q74,24 86,36 L86,46 Q74,58 62,46 Q50,34 38,46 Q26,58 14,46 Z" fill="#000" />
        </mask>
        <path
          d="M50,10 C67,10 80,24 80,42 C80,55 71,68 59,82 C55,86.5 51,90 50,93 C49,90 45,86.5 41,82 C29,68 20,55 20,42 C20,24 33,10 50,10 Z"
          fill="#FF7A5C"
          mask="url(#tt-ola-header)"
        />
      </svg>
      Tecolutla<span>Travel</span>
    </a>
    <div class="encabezado__derecha">
      <div class="buscador">
        <button
          class="buscador__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="buscador-panel"
          aria-label="Buscar un negocio"
        >
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="8.5" cy="8.5" r="6" />
            <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round" />
          </svg>
        </button>
        <div class="buscador__panel" id="buscador-panel" role="dialog" aria-label="Buscar un negocio" hidden>
          <label for="buscador-input" class="sr-only">Buscar un negocio por nombre</label>
          <input
            type="search"
            id="buscador-input"
            class="buscador__input"
            placeholder="Buscar un negocio…"
            autocomplete="off"
          />
          <ul class="buscador__resultados" id="buscador-resultados" aria-live="polite"></ul>
          <p class="buscador__sin-resultados" id="buscador-sin-resultados" hidden>
            No encontramos negocios con ese nombre.
          </p>
        </div>
      </div>
      <button
        class="encabezado__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-principal"
        aria-label="Abrir menú de navegación"
      >
        ☰
      </button>
    </div>
    <nav class="encabezado__nav" id="menu-principal" aria-label="Navegación principal">
      {
        enlaces.map((enlace) => (
          <a href={enlace.href} aria-current={esActiva(enlace.href) ? 'page' : undefined}>
            {enlace.texto}
          </a>
        ))
      }
      <a href="/anunciate" class="encabezado__anunciate">Anúnciate</a>
    </nav>
  </div>
</header>

<script type="application/json" id="datos-buscador" set:html={JSON.stringify(indiceBuscador)} />

<script>
  import { leerIndiceBuscador, buscarNegocios, resultadosHtml } from '../utils/buscadorNegocios';

  const boton = document.querySelector<HTMLButtonElement>('.encabezado__toggle');
  const nav = document.getElementById('menu-principal');

  boton?.addEventListener('click', () => {
    const abierto = nav?.classList.toggle('encabezado__nav--abierto');
    boton.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    // Si se abre el menú, cierra el buscador para que no se encimen.
    document.getElementById('buscador-panel')?.setAttribute('hidden', '');
    document.querySelector('.buscador__toggle')?.setAttribute('aria-expanded', 'false');
  });

  // Si la pantalla crece a tamaño de escritorio, aseguramos que el menú
  // quede visible y el botón refleje el estado correcto.
  const media = window.matchMedia('(min-width: 641px)');
  media.addEventListener('change', (e) => {
    if (e.matches) {
      nav?.classList.remove('encabezado__nav--abierto');
      boton?.setAttribute('aria-expanded', 'false');
    }
  });

  // ---------- Buscador de negocios ----------
  // Lógica compartida con el buscador píldora del home — ver
  // src/utils/buscadorNegocios.ts.
  const indiceNegocios = leerIndiceBuscador();

  const buscadorToggle = document.querySelector<HTMLButtonElement>('.buscador__toggle');
  const buscadorPanel = document.getElementById('buscador-panel');
  const buscadorInput = document.getElementById('buscador-input') as HTMLInputElement | null;
  const buscadorResultados = document.getElementById('buscador-resultados');
  const buscadorSinResultados = document.getElementById('buscador-sin-resultados');

  function abrirBuscador() {
    if (!buscadorPanel || !buscadorToggle) return;
    buscadorPanel.hidden = false;
    buscadorToggle.setAttribute('aria-expanded', 'true');
    // Cierra el menú de navegación móvil si estaba abierto.
    nav?.classList.remove('encabezado__nav--abierto');
    boton?.setAttribute('aria-expanded', 'false');
    buscadorInput?.focus();
  }

  function cerrarBuscador() {
    if (!buscadorPanel || !buscadorToggle) return;
    buscadorPanel.hidden = true;
    buscadorToggle.setAttribute('aria-expanded', 'false');
  }

  buscadorToggle?.addEventListener('click', () => {
    if (buscadorPanel?.hidden === false) cerrarBuscador();
    else abrirBuscador();
  });

  document.addEventListener('click', (evento) => {
    if (!buscadorPanel || buscadorPanel.hidden) return;
    const dentro =
      evento.target instanceof Node &&
      (buscadorPanel.contains(evento.target) || buscadorToggle?.contains(evento.target));
    if (!dentro) cerrarBuscador();
  });

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && buscadorPanel && !buscadorPanel.hidden) {
      cerrarBuscador();
      buscadorToggle?.focus();
    }
  });

  function renderizarResultados(consulta: string) {
    if (!buscadorResultados || !buscadorSinResultados) return;
    const coincidencias = buscarNegocios(indiceNegocios, consulta);

    if (!consulta.trim()) {
      buscadorResultados.innerHTML = '';
      buscadorSinResultados.hidden = true;
      return;
    }

    if (coincidencias.length === 0) {
      buscadorResultados.innerHTML = '';
      buscadorSinResultados.hidden = false;
      return;
    }

    buscadorSinResultados.hidden = true;
    buscadorResultados.innerHTML = resultadosHtml(coincidencias);
  }

  buscadorInput?.addEventListener('input', () => renderizarResultados(buscadorInput.value));
</script>
