---
const anio = new Date().getFullYear();
const esGastronomia = Astro.url.pathname.startsWith('/gastronomia');
---

<footer class:list={['pie', esGastronomia && 'pie--gastronomia']}>
  <div class="contenedor">
    <div class="pie__columnas">
      <div class="pie__marca">
        <a href="/" class="pie__nombre">
          <img
            class="pie__logo"
            src="/images/logo-tecolutlatravel-oficial.png"
            alt="TecolutlaTravel — Directorio turístico de Tecolutla"
            width="1158"
            height="204"
          />
        </a>
        <p>Tu guía local para descubrir lo mejor de Tecolutla, Veracruz.</p>
        <div class="pie__redes" aria-label="Redes y contacto">
          <a href="/contactanos" aria-label="Contacto de TecolutlaTravel">f</a>
          <a href="/contactanos" aria-label="Contacto de TecolutlaTravel">◎</a>
          <a href="/contactanos" aria-label="Contacto de TecolutlaTravel">◉</a>
          <a href="/contactanos" aria-label="Contacto de TecolutlaTravel">◔</a>
        </div>
      </div>
      <div>
        <h2>Explora</h2>
        <ul>
          <li><a href="/hospedaje">Hospedaje</a></li>
          <li><a href="/gastronomia">Gastronomía</a></li>
          <li><a href="/actividades">Actividades</a></li>
          <li><a href="/tips-para-tu-viaje">Tips para tu viaje</a></li>
        </ul>
      </div>
      <div>
        <h2>Información</h2>
        <ul>
          <li><a href="/acerca-de">¿Cómo funciona?</a></li>
          <li><a href="/acerca-de">Preguntas frecuentes</a></li>
          <li><a href="/aviso-de-privacidad">Términos y condiciones</a></li>
          <li><a href="/aviso-de-privacidad">Aviso de Privacidad</a></li>
          <li><a href="/contactanos">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h2>Para negocios</h2>
        <ul>
          <li><a href="/anunciate">Anúnciate</a></li>
          <li><a href="/anunciate">Directorio gratuito</a></li>
          <li><a href="/anunciate">Consejos para anfitriones</a></li>
          <li><a href="/reportajes-y-noticias">Blog para negocios</a></li>
        </ul>
      </div>
      <div>
        <h2>Contacto</h2>
        <ul>
          <li>Tecolutla, Veracruz, México</li>
          <li><a href="/contactanos">Escríbenos por WhatsApp</a></li>
          <li><a href="mailto:contacto@tecolutlatravel.mx">contacto@tecolutlatravel.mx</a></li>
        </ul>
      </div>
    </div>
    <p class="pie__legal">© {anio} TecolutlaTravel. Todos los derechos reservados.<span>Hecho con <b aria-hidden="true">♥</b> en Tecolutla</span></p>
  </div>
</footer>
