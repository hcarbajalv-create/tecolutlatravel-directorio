---
import { getCollection } from 'astro:content';
import { filtrarListables } from '../utils/negociosPublicados';

const anio = new Date().getFullYear();

// Mismo criterio que Header.astro e index.astro: "Servicios" se oculta
// mientras la categoría no tenga ningún negocio, para no enlazar desde
// ningún lugar del sitio a una página con noindex.
const negocios = filtrarListables(await getCollection('negocios'));
const hayServicios = negocios.some((n) => n.data.categoria === 'servicios');
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__columnas">
      <div>
        <h2>Categorías</h2>
        <ul>
          <li><a href="/hospedaje">Hospedaje en Tecolutla</a></li>
          <li><a href="/gastronomia">Gastronomía en Tecolutla</a></li>
          <li><a href="/actividades">Actividades ecoturísticas</a></li>
          {hayServicios && <li><a href="/servicios">Servicios turísticos</a></li>}
        </ul>
      </div>
      <div>
        <h2>Información</h2>
        <ul>
          <li><a href="/tips-para-tu-viaje">Tips para tu viaje</a></li>
          <li><a href="/descubre-tecolutla">Descubre Tecolutla</a></li>
          <li><a href="/acerca-de">Acerca de este directorio</a></li>
          <li><a href="/aviso-de-privacidad">Aviso de Privacidad</a></li>
        </ul>
      </div>
      <div>
        <h2>Para negocios</h2>
        <ul>
          <li><a href="/anunciate">Anuncia tu negocio gratis</a></li>
        </ul>
      </div>
    </div>
    <p class="pie__legal">© {anio} TecolutlaTravel. Directorio turístico independiente de Tecolutla, Veracruz.</p>
  </div>
</footer>
