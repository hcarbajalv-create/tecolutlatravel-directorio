---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { extraerInfoVideo } from '../utils/embedVideo';

interface Props {
  reportaje: CollectionEntry<'reportajes'>;
}

const { reportaje } = Astro.props;
const { titulo, categoria, video, descripcionCorta, negocioRelacionado } = reportaje.data;

const etiquetas: Record<typeof categoria, string> = {
  reportaje: 'Reportaje',
  noticia: 'Noticia',
  tip: 'Tip',
};

const negocio = negocioRelacionado ? await getEntry(negocioRelacionado) : undefined;
const enlaceNegocio = negocio ? `/${negocio.data.categoria}/${negocio.id}` : undefined;

// Miniatura real del video como fondo de la tarjeta — solo YouTube tiene
// una URL de miniatura predecible sin llamar a su API; Vimeo/otros se
// quedan con el color de fondo de su categoría. Se prueba primero la
// miniatura de mayor calidad (maxresdefault, normalmente la que el propio
// canal eligió como portada); si no existe para ese video, se usa la
// miniatura estándar (hqdefault), que prácticamente siempre existe.
async function obtenerMiniaturaYoutube(id: string): Promise<string> {
  const maxima = `https://img.youtube.com/vi/${id}/maxresdefault.jpg`;
  try {
    const respuesta = await fetch(maxima, { method: 'HEAD' });
    if (respuesta.ok) return maxima;
  } catch {
    // Sin conexión al construir el sitio — se usa el respaldo de abajo.
  }
  return `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
}

const infoVideo = video ? extraerInfoVideo(video) : null;
const miniatura =
  infoVideo?.proveedor === 'youtube' ? await obtenerMiniaturaYoutube(infoVideo.id) : undefined;
---

<article class={`tarjeta-reportaje tarjeta-reportaje--${categoria}`} data-categoria={categoria}>
  <div class="tarjeta-reportaje__video">
    {miniatura && <img class="tarjeta-reportaje__miniatura" src={miniatura} alt="" loading="lazy" />}
    {
      video ? (
        <a
          href={video}
          target="_blank"
          rel="noopener noreferrer"
          class="tarjeta-reportaje__video-enlace"
        >
          <span class="tarjeta-reportaje__play" aria-hidden="true">
            ▶
          </span>
          <span class="tarjeta-reportaje__video-texto">{titulo}</span>
        </a>
      ) : (
        <span class="tarjeta-reportaje__video-texto tarjeta-reportaje__video-texto--pendiente">
          Video próximamente
        </span>
      )
    }
  </div>
  <div class="tarjeta-reportaje__cuerpo">
    <span class="etiqueta-categoria">{etiquetas[categoria]}</span>
    <h3 class="tarjeta-reportaje__titulo">{titulo}</h3>
    <p class="tarjeta-reportaje__descripcion">{descripcionCorta}</p>
    {enlaceNegocio && (
      <a class="tarjeta-reportaje__ver-ficha" href={enlaceNegocio}>
        Ver ficha →
      </a>
    )}
  </div>
</article>
